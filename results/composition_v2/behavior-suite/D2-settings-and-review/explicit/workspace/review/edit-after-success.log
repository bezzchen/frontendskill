{
  "url": "http://127.0.0.1:8861/",
  "viewport": {
    "width": 375,
    "height": 812
  },
  "text": "CLAY HOUSE / MEMBER STUDIO\n\nWorkspace settings\n\nMake this space feel like yours. Choose how we keep you in the loop.\n\nYour workspace preferences\nDisplay name\n\nYour name in the studio. Use 1–60 characters.\n\nEmail me when my kiln firing is ready\n\nOne message when your work is ready to collect.\n\nSave settings\n\nYou have unsaved changes.",
  "controls": [
    {
      "id": "display-name",
      "tag": "INPUT",
      "type": "text",
      "text": "",
      "value": "Next studio",
      "checked": false
    },
    {
      "id": "kiln-alerts",
      "tag": "INPUT",
      "type": "checkbox",
      "text": "",
      "value": "on",
      "checked": true
    },
    {
      "id": "save-settings",
      "tag": "BUTTON",
      "type": "submit",
      "text": "Save settings",
      "value": ""
    }
  ],
  "focus": {
    "tag": "INPUT",
    "id": "display-name"
  },
  "events": [
    {
      "type": "action",
      "action": {
        "type": "click",
        "selector": "#save-settings"
      }
    },
    {
      "type": "action",
      "action": {
        "type": "wait",
        "ms": 800
      }
    },
    {
      "type": "action",
      "action": {
        "type": "fill",
        "selector": "#display-name",
        "value": "Next studio"
      }
    }
  ]
}
