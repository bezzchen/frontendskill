@@ -0,0 +1,441 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { constellationItems } from "./ConstellationData";
+
+const CATEGORIES = ["engineering", "research", "design", "math"];
+
+const CATEGORY_VARS = {
+  engineering: "--cat-engineering",
+  research: "--cat-research",
+  design: "--cat-design",
+  math: "--cat-math",
+};
+
+/* Cluster anchors as fractions of the canvas. */
+const ANCHORS = {
+  engineering: [0.3, 0.34],
+  research: [0.74, 0.3],
+  design: [0.62, 0.72],
+  math: [0.4, 0.78],
+};
+
+const COUNTS = constellationItems.reduce((acc, item) => {
+  acc[item.category] = (acc[item.category] || 0) + 1;
+  return acc;
+}, {});
+
+function mulberry32(seed) {
+  let a = seed | 0;
+  return function next() {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function buildField(width, height) {
+  const spread = Math.min(width, height) * 0.17;
+  const nodes = constellationItems.map((item) => {
+    const rng = mulberry32(item.id * 7919 + 17);
+    const [ax, ay] = ANCHORS[item.category];
+    /* Box-Muller gaussian jitter around the cluster anchor */
+    const u1 = Math.max(rng(), 1e-6);
+    const u2 = rng();
+    const mag = Math.sqrt(-2 * Math.log(u1));
+    let x = ax * width + Math.cos(2 * Math.PI * u2) * mag * spread;
+    let y = ay * height + Math.sin(2 * Math.PI * u2) * mag * spread * 0.82;
+
+    /* A few nodes lean out toward a neighboring discipline */
+    const bridgeTo =
+      item.id % 17 === 0
+        ? CATEGORIES[(CATEGORIES.indexOf(item.category) + 1 + (item.id % 3)) % 4]
+        : null;
+    if (bridgeTo) {
+      const [bx, by] = ANCHORS[bridgeTo];
+      const t = 0.35 + rng() * 0.3;
+      x = x + (bx * width - x) * t;
+      y = y + (by * height - y) * t;
+    }
+
+    const radius = 0.7 + rng() ** 2 * 1.8;
+    return {
+      id: item.id,
+      label: item.label,
+      category: item.category,
+      bridgeTo,
+      x,
+      y,
+      radius,
+      bright: radius > 2.15,
+      twinklePhase: rng() * Math.PI * 2,
+      twinkleSpeed: 0.4 + rng() * 0.9,
+      delay: 0,
+      px: x,
+      py: y,
+    };
+  });
+
+  /* Draw-in delay grows with distance from the field's center of mass */
+  const cx = nodes.reduce((s, n) => s + n.x, 0) / nodes.length;
+  const cy = nodes.reduce((s, n) => s + n.y, 0) / nodes.length;
+  let maxDist = 1;
+  for (const n of nodes) {
+    n.dist = Math.hypot(n.x - cx, n.y - cy);
+    if (n.dist > maxDist) maxDist = n.dist;
+  }
+  for (const n of nodes) {
+    const rng = mulberry32(n.id * 31 + 7);
+    n.delay = (n.dist / maxDist) * 1100 + rng() * 300;
+  }
+
+  /* Links: nearest same-discipline neighbor, plus bridge chords */
+  const links = [];
+  const seen = new Set();
+  const maxLink = Math.min(width, height) * 0.085 + 36;
+  for (const cat of CATEGORIES) {
+    const group = nodes.filter((n) => n.category === cat);
+    for (const n of group) {
+      let best = null;
+      let bestDist = Infinity;
+      for (const m of group) {
+        if (m.id === n.id) continue;
+        const d = Math.hypot(m.x - n.x, m.y - n.y);
+        if (d < bestDist) {
+          bestDist = d;
+          best = m;
+        }
+      }
+      if (best && bestDist < maxLink) {
+        const key = n.id < best.id ? `${n.id}-${best.id}` : `${best.id}-${n.id}`;
+        if (!seen.has(key)) {
+          seen.add(key);
+          links.push({ a: n, b: best, bridge: false, category: cat });
+        }
+      }
+    }
+  }
+  for (const n of nodes) {
+    if (!n.bridgeTo) continue;
+    let best = null;
+    let bestDist = Infinity;
+    for (const m of nodes) {
+      if (m.category !== n.bridgeTo) continue;
+      const d = Math.hypot(m.x - n.x, m.y - n.y);
+      if (d < bestDist) {
+        bestDist = d;
+        best = m;
+      }
+    }
+    if (best && bestDist < maxLink * 2.2) {
+      links.push({ a: n, b: best, bridge: true, category: n.category });
+    }
+  }
+
+  return { nodes, links };
+}
+
+function readColors() {
+  const styles = getComputedStyle(document.documentElement);
+  const get = (name) => styles.getPropertyValue(name).trim();
+  return {
+    ink: get("--foreground"),
+    brass: get("--brass"),
+    engineering: get("--cat-engineering"),
+    research: get("--cat-research"),
+    design: get("--cat-design"),
+    math: get("--cat-math"),
+  };
+}
+
+export function Constellation() {
+  const rootRef = useRef(null);
+  const canvasRef = useRef(null);
+  const fieldRef = useRef(null);
+  const colorsRef = useRef(null);
+  const mouseRef = useRef({ x: -9999, y: -9999, active: false });
+  const activeRef = useRef(null);
+  const hoveredRef = useRef(null);
+  const startRef = useRef(null);
+  const rafRef = useRef(0);
+  const runningRef = useRef(false);
+  const reducedRef = useRef(false);
+
+  const [active, setActive] = useState(null);
+  const [hovered, setHovered] = useState(null);
+
+  activeRef.current = active;
+
+  useEffect(() => {
+    const root = rootRef.current;
+    const canvas = canvasRef.current;
+    if (!root || !canvas) return undefined;
+    const ctx = canvas.getContext("2d");
+    const reducedQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
+    const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
+    reducedRef.current = reducedQuery.matches;
+    colorsRef.current = readColors();
+
+    const setup = () => {
+      const rect = root.getBoundingClientRect();
+      const dpr = Math.min(window.devicePixelRatio || 1, 2);
+      canvas.width = Math.max(1, Math.round(rect.width * dpr));
+      canvas.height = Math.max(1, Math.round(rect.height * dpr));
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      fieldRef.current = buildField(rect.width, rect.height);
+    };
+
+    const draw = () => {
+      const field = fieldRef.current;
+      const colors = colorsRef.current;
+      if (!field || !colors) return;
+      const rect = root.getBoundingClientRect();
+      const now = performance.now();
+      if (startRef.current === null) startRef.current = now;
+      const elapsed = now - startRef.current;
+      const reduced = reducedRef.current;
+      const activeCat = activeRef.current;
+      const mouse = mouseRef.current;
+
+      ctx.clearRect(0, 0, rect.width, rect.height);
+
+      const driftX = reduced ? 0 : Math.sin(now * 0.00012) * 4;
+      const driftY = reduced ? 0 : Math.cos(now * 0.00009) * 3;
+
+      /* Compute frame positions first so links and nodes agree */
+      for (const n of field.nodes) {
+        const depth = 0.4 + (n.radius / 2.5) * 0.8;
+        let x = n.x + driftX * depth;
+        let y = n.y + driftY * depth;
+        if (!reduced && mouse.active) {
+          const dx = x - mouse.x;
+          const dy = y - mouse.y;
+          const d = Math.hypot(dx, dy);
+          if (d < 110 && d > 0.001) {
+            const push = ((110 - d) / 110) ** 2 * 14;
+            x += (dx / d) * push;
+            y += (dy / d) * push;
+          }
+        }
+        n.px = x;
+        n.py = y;
+        const p = reduced ? 1 : Math.min(Math.max((elapsed - n.delay) / 700, 0), 1);
+        n.appear = p * p * (3 - 2 * p); /* smoothstep */
+      }
+
+      ctx.lineWidth = 1;
+      for (const link of field.links) {
+        const catAlpha = activeCat && link.category !== activeCat ? 0.1 : 1;
+        const appear = Math.min(link.a.appear, link.b.appear);
+        if (appear <= 0 || catAlpha <= 0) continue;
+        ctx.strokeStyle = link.bridge ? colors.ink : colors[link.category];
+        ctx.globalAlpha = (link.bridge ? 0.16 : 0.26) * appear * catAlpha;
+        ctx.beginPath();
+        ctx.moveTo(link.a.px, link.a.py);
+        ctx.lineTo(link.b.px, link.b.py);
+        ctx.stroke();
+      }
+
+      for (const n of field.nodes) {
+        if (n.appear <= 0) continue;
+        const catAlpha = activeCat && n.category !== activeCat ? 0.12 : 1;
+        let alpha = 0.85 * n.appear * catAlpha;
+        if (n.bright && !reduced) {
+          alpha *= 0.75 + 0.25 * Math.sin(now * 0.001 * n.twinkleSpeed + n.twinklePhase);
+        }
+        const color = colors[n.category];
+        if (n.bright) {
+          ctx.globalAlpha = 0.1 * n.appear * catAlpha;
+          ctx.fillStyle = color;
+          ctx.beginPath();
+          ctx.arc(n.px, n.py, n.radius * 3.2, 0, Math.PI * 2);
+          ctx.fill();
+        }
+        ctx.globalAlpha = Math.max(alpha, 0);
+        ctx.fillStyle = color;
+        ctx.beginPath();
+        ctx.arc(n.px, n.py, n.radius, 0, Math.PI * 2);
+        ctx.fill();
+      }
+
+      const hoveredNode = hoveredRef.current
+        ? field.nodes.find((n) => n.id === hoveredRef.current.id)
+        : null;
+      if (hoveredNode) {
+        ctx.globalAlpha = 0.9;
+        ctx.strokeStyle = colors.brass;
+        ctx.beginPath();
+        ctx.arc(hoveredNode.px, hoveredNode.py, hoveredNode.radius + 5, 0, Math.PI * 2);
+        ctx.stroke();
+      }
+      ctx.globalAlpha = 1;
+    };
+
+    const tick = () => {
+      if (!runningRef.current) return;
+      draw();
+      rafRef.current = requestAnimationFrame(tick);
+    };
+
+    const start = () => {
+      if (runningRef.current || reducedRef.current) return;
+      runningRef.current = true;
+      rafRef.current = requestAnimationFrame(tick);
+    };
+
+    const stop = () => {
+      runningRef.current = false;
+      cancelAnimationFrame(rafRef.current);
+    };
+
+    setup();
+    if (reducedRef.current) {
+      draw();
+    }
+
+    const io = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) start();
+        else stop();
+      },
+      { threshold: 0.05 }
+    );
+    io.observe(root);
