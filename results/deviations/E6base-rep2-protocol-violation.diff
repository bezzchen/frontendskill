+    const onReduced = () => {
+      reducedRef.current = reducedQuery.matches;
+      if (reducedQuery.matches) {
+        stop();
+        draw();
+      } else {
+        start();
+      }
+    };
+    reducedQuery.addEventListener("change", onReduced);
+
+    const redrawStatic = () => {
+      if (reducedRef.current) draw();
+    };
+    root.addEventListener("constellation:redraw", redrawStatic);
+
+    return () => {
+      stop();
+      io.disconnect();
+      ro.disconnect();
+      window.clearTimeout(resizeTimer);
+      window.removeEventListener("pointermove", onPointerMove);
+      darkQuery.removeEventListener("change", onScheme);
+      reducedQuery.removeEventListener("change", onReduced);
+      root.removeEventListener("constellation:redraw", redrawStatic);
+    };
+  }, []);
+
+  /* Static (reduced-motion) canvases still reflect discipline isolation */
+  useEffect(() => {
+    const root = rootRef.current;
+    if (root) root.dispatchEvent(new Event("constellation:redraw"));
+  }, [active]);
+
+  const toggleCategory = (cat) => {
+    setActive((current) => (current === cat ? null : cat));
+  };
+
+  return (
+    <div ref={rootRef} className="pointer-events-none absolute inset-0">
+      <canvas
+        ref={canvasRef}
+        role="img"
+        aria-label="Constellation chart plotting 500 working notes across engineering, research, design, and math."
+        className="absolute inset-0 h-full w-full"
+      />
+      <div className="pointer-events-auto absolute bottom-6 right-6 z-10 hidden w-64 rounded-lg border border-[var(--line)] bg-[color-mix(in_srgb,var(--surface)_88%,transparent)] p-4 backdrop-blur-sm lg:block">
+        <p className="kicker">Observation chart</p>
+        <p className="type-mono mt-1 text-xs text-[var(--muted)]">
+          500 notes · 4 disciplines · plotted 2026
+        </p>
+        <div className="mt-3 grid gap-1" role="group" aria-label="Isolate a discipline">
+          {CATEGORIES.map((cat) => (
+            <button
+              key={cat}
+              type="button"
+              aria-pressed={active === cat}
+              onClick={() => toggleCategory(cat)}
+              className="type-mono flex items-center justify-between rounded px-2 py-1 text-left text-xs uppercase tracking-[0.14em] transition-opacity hover:bg-[var(--background)]"
+              style={active && active !== cat ? { opacity: 0.45 } : undefined}
+            >
+              <span className="flex items-center gap-2">
+                <span
+                  aria-hidden="true"
+                  className="h-2 w-2 rounded-full"
+                  style={{ background: `var(${CATEGORY_VARS[cat]})` }}
+                />
+                {cat}
+              </span>
+              <span className="text-[var(--muted)]">{COUNTS[cat]}</span>
+            </button>
+          ))}
+        </div>
+        <p
+          aria-live="polite"
+          className="type-mono mt-3 border-t border-[var(--line)] pt-2 text-xs text-[var(--muted)]"
+        >
+          {hovered
+            ? `${hovered.label} · ${hovered.category}`
+            : active
+              ? `${active} isolated — click again to clear`
+              : "hover the field · click a discipline"}
+        </p>
+      </div>
+    </div>
+  );
+}
