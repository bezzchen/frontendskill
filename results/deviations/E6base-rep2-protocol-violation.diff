 * { box-sizing: border-box; }
-html { background: var(--background); color: var(--foreground); }
-body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
+
+html {
+  background: var(--background);
+  color: var(--foreground);
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  font-family: var(--font-body);
+  line-height: 1.6;
+  -webkit-font-smoothing: antialiased;
+}
+
 a { color: inherit; }
 button, input { font: inherit; }
+
+::selection {
+  background: var(--brass);
+  color: var(--background);
+}
+
+:focus-visible {
+  outline: 2px solid var(--brass);
+  outline-offset: 2px;
+  border-radius: 2px;
+}
+
+[id] { scroll-margin-top: 5rem; }
+
+/* Type voices */
+.type-display {
+  font-family: var(--font-display);
+  font-weight: 400;
+  letter-spacing: -0.01em;
+}
+
+.type-mono {
+  font-family: var(--font-mono);
+  font-weight: 400;
+}
+
+.kicker {
+  font-family: var(--font-mono);
+  font-size: 0.6875rem;
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+/* Plotting-grid ground for the observation chart */
+.chart-grid {
+  background-image:
+    linear-gradient(var(--grid-line) 1px, transparent 1px),
+    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
+  background-size: 3rem 3rem;
+}
+
+.hero-scrim {
+  background:
+    radial-gradient(120% 90% at 18% 88%, var(--background) 0%, transparent 55%),
+    linear-gradient(to bottom, transparent 55%, var(--background) 100%);
+}
+
+/* One-time scroll reveals */
+.reveal {
+  opacity: 0;
+  transform: translateY(14px);
+  transition: opacity 0.65s ease, transform 0.65s ease;
+}
+.reveal.is-in {
+  opacity: 1;
+  transform: none;
+}
+
+/* Project plates */
+.plate-card {
+  transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
+}
+.plate-card:hover {
+  transform: translateY(-3px);
+  border-color: color-mix(in srgb, var(--brass) 55%, var(--line));
+  box-shadow: 0 12px 32px -18px rgba(0, 0, 0, 0.35);
+}
+.plate-card svg {
+  transition: transform 0.5s ease;
+}
+.plate-card:hover svg {
+  transform: scale(1.025);
+}
+
+/* Toggle switch */
+.switch {
+  appearance: none;
+  position: relative;
+  width: 2.75rem;
+  height: 1.5rem;
+  flex: none;
+  border-radius: 999px;
+  border: 1px solid var(--line);
+  background: var(--background);
+  cursor: pointer;
+  transition: background 0.25s ease, border-color 0.25s ease;
+}
+.switch::after {
+  content: "";
+  position: absolute;
+  top: 50%;
+  left: 3px;
+  width: 1.05rem;
+  height: 1.05rem;
+  border-radius: 999px;
+  background: var(--muted);
+  transform: translateY(-50%);
+  transition: left 0.25s ease, background 0.25s ease;
+}
+.switch:checked {
+  background: color-mix(in srgb, var(--brass) 24%, var(--background));
+  border-color: var(--brass);
+}
+.switch:checked::after {
+  left: calc(100% - 1.05rem - 3px);
+  background: var(--brass);
+}
+
+/* Primary action */
+.btn-brass {
+  font-family: var(--font-mono);
+  font-size: 0.8125rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  background: var(--brass);
+  color: var(--background);
+  border: none;
+  border-radius: 6px;
+  padding: 0.65rem 1.25rem;
+  cursor: pointer;
+  transition: filter 0.2s ease, transform 0.15s ease;
+}
+.btn-brass:hover { filter: brightness(1.08); }
+.btn-brass:active { transform: translateY(1px); }
+
+/* Form fields */
+.field {
+  width: 100%;
+  border-radius: 6px;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  padding: 0.6rem 0.75rem;
+  transition: border-color 0.2s ease;
+}
+.field:hover { border-color: color-mix(in srgb, var(--muted) 50%, var(--line)); }
+.field:focus-visible { outline-offset: 0; }
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  .reveal { opacity: 1; transform: none; transition: none; }
+  .plate-card, .plate-card svg, .switch, .switch::after, .btn-brass { transition: none; }
+  .plate-card:hover { transform: none; }
+  .plate-card:hover svg { transform: none; }
+}
