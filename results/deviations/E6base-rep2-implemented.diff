   }
 }
 
 * { box-sizing: border-box; }
-html { background: var(--background); color: var(--foreground); }
-body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
+
+html {
+  background: var(--paper);
+  color: var(--ink);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  html { scroll-behavior: smooth; }
+}
+
+body {
+  margin: 0;
+  font-family: var(--font-body);
+  font-size: 1rem;
+  line-height: 1.6;
+  background-color: var(--paper);
+  /* millimeter paper: major + minor rules */
+  background-image:
+    linear-gradient(var(--grid-major) 1px, transparent 1px),
+    linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
+    linear-gradient(var(--grid-minor) 1px, transparent 1px),
+    linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
+  background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
+  -webkit-font-smoothing: antialiased;
+}
+
 a { color: inherit; }
 button, input { font: inherit; }
+
+::selection { background: var(--accent-soft); color: var(--ink); }
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+  border-radius: 2px;
+}
+
+/* ------------------------------------------------------------------ layout */
+
+.sheet {
+  max-width: 76rem;
+  margin: 0 auto;
+  padding-inline: clamp(1.25rem, 4vw, 2.5rem);
+}
+
+section { scroll-margin-top: 5rem; }
+
+/* ------------------------------------------------------------------ type */
+
+.eyebrow {
+  font-family: var(--font-annot);
+  font-size: 0.72rem;
+  font-weight: 500;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+.annot {
+  font-family: var(--font-annot);
+  font-size: 0.72rem;
+  letter-spacing: 0.05em;
+  color: var(--muted);
+}
+
+.display {
+  font-family: var(--font-display);
+  font-stretch: 123%;
+  font-weight: 800;
+  letter-spacing: -0.015em;
+  line-height: 0.95;
+  text-transform: uppercase;
+}
+
+/* ------------------------------------------------------------------ topbar */
+
+.topbar {
+  border-bottom: 1px solid var(--line);
+  background: color-mix(in srgb, var(--paper) 82%, transparent);
+  backdrop-filter: blur(6px);
+}
+
+.topbar-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  padding-block: 0.7rem;
+}
+
+.wordmark {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.65rem;
+  text-decoration: none;
+}
+
+.monogram {
+  display: inline-grid;
+  place-items: center;
+  width: 1.7rem;
+  height: 1.7rem;
+  border: 1.5px solid var(--ink);
+  font-family: var(--font-display);
+  font-stretch: 120%;
+  font-weight: 800;
+  font-size: 0.72rem;
+  letter-spacing: 0.04em;
+}
+
+.wordmark-name {
+  font-family: var(--font-annot);
+  font-size: 0.74rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.topnav {
+  display: flex;
+  gap: 1.5rem;
+}
+
+.topnav a {
+  font-family: var(--font-annot);
+  font-size: 0.72rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  text-decoration: none;
+  color: var(--muted);
+  padding-block: 0.25rem;
+  border-bottom: 1.5px solid transparent;
+  transition: color 0.2s ease, border-color 0.2s ease;
+}
+
+.topnav a:hover { color: var(--accent); border-color: var(--accent); }
+
+/* ------------------------------------------------------------------ hero */
+
+.hero {
+  position: relative;
+  overflow: hidden;
+  border-bottom: 1px solid var(--line);
+}
+
+.hero-inner {
+  position: relative;
+  padding-block: clamp(4.5rem, 11vh, 8.5rem) clamp(3.5rem, 8vh, 6rem);
+}
+
+.hero-fig {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  color: var(--fig-ink);
+  opacity: 0.34;
+  pointer-events: none;
+}
+
+.hero-fig .hero-curve {
+  stroke-dasharray: 1;
+  stroke-dashoffset: 1;
+  animation: draw-in 3.2s cubic-bezier(0.62, 0.04, 0.22, 1) 0.35s forwards;
+}
+
+.penhead {
+  fill: var(--red);
+  offset-rotate: 0deg;
+  animation: pen-travel 26s linear 3.6s infinite;
+  opacity: 0;
+}
+
+@keyframes pen-travel {
+  0% { offset-distance: 0%; opacity: 1; }
+  100% { offset-distance: 100%; opacity: 1; }
+}
+
+@keyframes draw-in {
+  to { stroke-dashoffset: 0; }
+}
+
+.hero-copy { position: relative; max-width: 46rem; }
+
+.hero-copy .eyebrow { display: block; margin-bottom: 1.1rem; }
+
+.hero-title {
+  margin: 0;
+  font-size: clamp(3.1rem, 9.2vw, 6.8rem);
+}
+
+.hero-sub {
+  margin: 1.4rem 0 0;
+  max-width: 34rem;
+  font-size: clamp(1.02rem, 1.5vw, 1.16rem);
+  line-height: 1.65;
+  color: var(--muted);
+  text-wrap: balance;
+}
+
+.hero-sub strong { color: var(--ink); font-weight: 600; }
+
+/* staged entrance */
+.rise { opacity: 0; transform: translateY(14px); animation: rise 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
+.rise-1 { animation-delay: 0.05s; }
+.rise-2 { animation-delay: 0.16s; }
+.rise-3 { animation-delay: 0.3s; }
+.rise-4 { animation-delay: 0.48s; }
+
+@keyframes rise {
+  to { opacity: 1; transform: none; }
+}
+
+/* drafting title block */
+.titleblock {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  width: fit-content;
+  margin-top: clamp(2.2rem, 5vh, 3.4rem);
+  border: 1px solid var(--hairline);
+  background: color-mix(in srgb, var(--surface) 72%, transparent);
+}
+
+@media (min-width: 640px) {
+  .titleblock { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+}
+
+.tb-cell {
+  padding: 0.55rem 1rem 0.6rem;
+  border-right: 1px solid var(--hairline);
+  border-bottom: 1px solid var(--hairline);
+}
+
+.tb-cell:last-child { border-right: 0; }
+
+@media (max-width: 639px) {
+  .tb-cell:nth-child(even) { border-right: 0; }
+  .tb-cell:nth-child(n + 3) { border-bottom: 0; }
+}
+
+@media (min-width: 640px) {
+  .tb-cell { border-bottom: 0; }
+}
+
+.tb-label {
+  display: block;
+  font-family: var(--font-annot);
+  font-size: 0.58rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.tb-value {
+  display: block;
+  margin-top: 0.15rem;
+  font-family: var(--font-annot);
+  font-size: 0.78rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  color: var(--ink);
+  white-space: nowrap;
+}
+
+/* ------------------------------------------------------------- section head */
+
+.shead {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 0.5rem 1.5rem;
+  margin: 0 0 0.9rem;
+}
+
+.shead h2 {
+  margin: 0.35rem 0 0;
+  font-family: var(--font-display);
+  font-stretch: 118%;
+  font-weight: 750;
+  font-size: clamp(1.65rem, 3.2vw, 2.3rem);
+  letter-spacing: -0.01em;
+  line-height: 1.05;
+}
+
+.shead .annot { margin-left: auto; }
+
+.section-note {
+  margin: 0 0 2.2rem;
+  max-width: 40rem;
+  color: var(--muted);
+  font-size: 0.98rem;
+}
+
+.rule { border: 0; border-top: 1px solid var(--line); margin: 0 0 1.6rem; }
+
+/* ------------------------------------------------------------------ plates */
+
+.plate-grid {
+  display: grid;
+  gap: 1.4rem;
+  grid-template-columns: 1fr;
+}
+
+@media (min-width: 720px) {
+  .plate-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+.plate {
+  position: relative;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  border-radius: 6px;
+}
+
+.plate-link {
+  display: block;
+  padding: 0.9rem 0.9rem 1.15rem;
+  text-decoration: none;
+  height: 100%;
+}
+
+/* plot area = a small sheet inside the plate */
+.plotarea {
+  position: relative;
+  border: 1px solid var(--hairline);
+  border-radius: 3px;
+  background-color: var(--plot-bg);
+  background-image:
+    linear-gradient(var(--grid-minor) 1px, transparent 1px),
+    linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
+  background-size: 20px 20px;
+  overflow: hidden;
+}
+
+.plotarea svg {
+  display: block;
+  width: 100%;
+  height: auto;
+  color: var(--fig-ink);
+}
+
+.plotarea path {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.4;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  vector-effect: non-scaling-stroke;
+  stroke-dasharray: 1;
+  stroke-dashoffset: 0;
+  transition:
+    stroke-dashoffset 1.5s cubic-bezier(0.6, 0.05, 0.25, 1) calc(0.12s + var(--i, 0) * 90ms),
+    stroke 0.35s ease;
+}
+
+.plotarea circle {
+  fill: currentColor;
+  transform-box: fill-box;
+  transform-origin: center;
+  transition:
+    transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.3s + var(--i, 0) * 24ms),
+    opacity 0.4s ease calc(0.3s + var(--i, 0) * 24ms),
+    fill 0.35s ease;
+}
+
+/* figure caption row */
+.figcap {
+  display: flex;
+  align-items: baseline;
+  gap: 0.8rem;
+  margin-top: 0.85rem;
+}
+
+.fig-no {
+  font-family: var(--font-annot);
+  font-size: 0.7rem;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  color: var(--accent);
+  white-space: nowrap;
+}
+
+.fig-params {
+  margin-left: auto;
+  font-family: var(--font-annot);
+  font-size: 0.66rem;
+  letter-spacing: 0.03em;
+  color: var(--muted);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.plate h3 {
+  margin: 0.55rem 0 0;
+  font-family: var(--font-display);
+  font-stretch: 112%;
+  font-weight: 730;
+  font-size: 1.22rem;
+  letter-spacing: 0.005em;
+  line-height: 1.2;
+}
+
+.plate-summary {
+  margin: 0.45rem 0 0;
+  font-size: 0.92rem;
+  line-height: 1.55;
+  color: var(--muted);
+}
+
+.plate-meta {
+  margin-top: 0.8rem;
+  font-family: var(--font-annot);
+  font-size: 0.68rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+/* hover: re-ink */
+@media (hover: hover) {
+  .plate {
+    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
+  }
+  .plate:hover {
+    transform: translateY(-3px);
+    border-color: var(--accent);
+    box-shadow: 0 10px 30px -18px color-mix(in srgb, var(--accent) 55%, transparent);
+  }
+  .plate:hover .plotarea { color: var(--accent); }
+  .plate:hover .fig-no { color: var(--accent-strong); }
+}
+
+/* ------------------------------------------------ scroll reveal (JS-armed) */
+
+[data-reveal] {
+  transition: opacity 0.65s ease var(--d, 0ms), transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
+}
+
+.reveal-armed [data-reveal]:not(.in) {
+  opacity: 0;
+  transform: translateY(16px);
+  transition: none;
+}
+
+.reveal-armed [data-reveal]:not(.in) .plotarea path {
+  stroke-dashoffset: 1;
+  transition: none;
+}
+
+.reveal-armed [data-reveal]:not(.in) .plotarea circle {
+  transform: scale(0);
+  opacity: 0;
+  transition: none;
+}
+
+/* ---------------------------------------------------------------- settings */
+
+.panel {
+  border: 1px solid var(--line);
+  background: var(--surface);
+  border-radius: 6px;
+  padding: clamp(1.3rem, 3vw, 2rem);
+}
+
+.panel fieldset {
+  border: 0;
+  margin: 0 0 1.7rem;
+  padding: 0;
+}
+
+.panel fieldset:last-of-type { margin-bottom: 0; }
+
+.panel legend {
+  padding: 0;
+  margin-bottom: 0.75rem;
+  font-weight: 650;
+  font-size: 0.95rem;
+}
+
+.lbl {
+  display: block;
+  font-size: 0.82rem;
+  font-weight: 550;
+  color: var(--muted);
+  margin-bottom: 0.3rem;
+}
+
+.field {
+  width: 100%;
+  padding: 0.55rem 0.75rem;
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  background: var(--paper);
+  color: var(--ink);
+  transition: border-color 0.2s ease, box-shadow 0.2s ease;
+}
+
+.field::placeholder { color: color-mix(in srgb, var(--muted) 70%, transparent); }
+
+.field:focus-visible {
+  outline: none;
+  border-color: var(--accent);
+  box-shadow: 0 0 0 3px var(--accent-soft);
+}
+
+.field-row { margin-bottom: 0.9rem; }
+.field-row:last-child { margin-bottom: 0; }
+
+.toggle-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 0.85rem 1rem;
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  background: var(--paper);
+  cursor: pointer;
+}
+
+.toggle-title { font-size: 0.92rem; font-weight: 550; }
+.toggle-desc { display: block; font-size: 0.8rem; color: var(--muted); margin-top: 0.1rem; }
+
+.switch {
+  appearance: none;
+  -webkit-appearance: none;
+  flex: none;
+  width: 2.5rem;
+  height: 1.45rem;
+  margin: 0;
+  border-radius: 999px;
+  background: var(--line);
+  border: 1px solid var(--hairline);
+  position: relative;
+  cursor: pointer;
+  transition: background 0.2s ease, border-color 0.2s ease;
+}
+
+.switch::after {
+  content: "";
+  position: absolute;
+  top: 50%;
+  left: 3px;
+  width: 1.02rem;
+  height: 1.02rem;
+  border-radius: 50%;
+  background: var(--surface);
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+  transform: translateY(-50%);
+  transition: left 0.18s cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+
+.switch:checked { background: var(--accent); border-color: var(--accent); }
+.switch:checked::after { left: calc(100% - 1.02rem - 3px); background: #fff; }
+
+.form-actions {
+  display: flex;
+  align-items: center;
+  gap: 0.9rem;
+  margin-top: 1.7rem;
+  padding-top: 1.4rem;
+  border-top: 1px solid var(--line);
+}
+
+.btn-primary {
+  padding: 0.55rem 1.15rem;
+  border: 1px solid transparent;
+  border-radius: 4px;
+  background: var(--accent);
+  color: #fff;
+  font-weight: 600;
+  font-size: 0.92rem;
+  cursor: pointer;
+  transition: background 0.2s ease, transform 0.15s ease;
+}
+
+@media (prefers-color-scheme: dark) {
+  .btn-primary { color: #0e1116; }
+}
+
+.btn-primary:hover { background: var(--accent-strong); }
+.btn-primary:active { transform: translateY(1px); }
+
+.save-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  font-size: 0.82rem;
+  color: var(--muted);
+}
+
+.save-chip svg { color: var(--accent); }
+
+/* ---------------------------------------------------------------- footer */
+
+.footer {
+  margin-top: clamp(4rem, 9vh, 7rem);
+  border-top: 1px solid var(--line);
+}
+
+.footer-inner {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.6rem 2rem;
+  align-items: baseline;
+  justify-content: space-between;
+  padding-block: 1.4rem 1.8rem;
+}
+
+.footer a { text-decoration-color: var(--hairline); text-underline-offset: 3px; }
+.footer a:hover { color: var(--accent); }
+
+/* ------------------------------------------------------------ reduced motion */
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+
+  .rise,
+  .hero-fig .hero-curve {
+    animation: none;
+    opacity: 1;
+    transform: none;
+    stroke-dashoffset: 0;
+  }
+
+  .penhead { display: none; }
+
+  [data-reveal],
+  .plotarea path,
+  .plotarea circle,
+  .plate,
+  .switch,
+  .switch::after {
+    transition: none !important;
+  }
+
+  .reveal-armed [data-reveal]:not(.in) {
+    opacity: 1;
+    transform: none;
+  }
+
+  .reveal-armed [data-reveal]:not(.in) .plotarea path { stroke-dashoffset: 0; }
+  .reveal-armed [data-reveal]:not(.in) .plotarea circle { transform: none; opacity: 1; }
+}
