+    --paper: #0e1116;
+    --plot-bg: #10141a;
+    --surface: #151a21;
+    --ink: #e8ecf4;
+    --fig-ink: #c3ccda;
+    --muted: #96a0ae;
+    --line: #242c36;
+    --hairline: #2d3643;
+    --accent: #8fa2ff;
+    --accent-strong: #aab8ff;
+    --accent-soft: rgba(143, 162, 255, 0.11);
