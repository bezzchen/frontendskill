--- /dev/null
+++ b/components/figures.js
@@ -0,0 +1,228 @@
+// Deterministic generative figures. Server-side only: pure math -> SVG path data.
+// Every figure is plotted from the parameters shown in its caption.
+
+function mulberry32(seed) {
+  let a = seed >>> 0;
+  return function () {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const W = 320;
+const H = 200;
+const f = (n) => Math.round(n * 10) / 10;
+
+function poly(points) {
+  return points
+    .map(([x, y], i) => `${i === 0 ? "M" : "L"}${f(x)} ${f(y)}`)
+    .join("");
+}
+
+// FIG. 01 - Lissajous 3:2
+function lissajous() {
+  const pts = [];
+  for (let i = 0; i <= 420; i++) {
+    const t = (i / 420) * Math.PI * 2;
+    pts.push([160 + 122 * Math.sin(3 * t + Math.PI / 2), 100 + 72 * Math.sin(2 * t)]);
+  }
+  return { strokes: [{ d: poly(pts) }], dots: [], caption: "x=sin 3t · y=sin 2t · δ=π/2" };
+}
+
+// FIG. 02 - PCB autoroute: nets left to right, 45° chamfered jogs, pads at ends
+function copper(seed) {
+  const rnd = mulberry32(seed);
+  const strokes = [];
+  const dots = [];
+  const lanes = [32, 60, 88, 116, 144, 172];
+  for (let n = 0; n < 6; n++) {
+    let x = 20;
+    let y = lanes[n];
+    const pts = [[x, y]];
+    dots.push({ cx: x, cy: y, r: 4 });
+    while (x < 284) {
+      x += 18 + Math.floor(rnd() * 3) * 14;
+      if (x > 284) x = 284;
+      pts.push([x, y]);
+      if (x < 270 && rnd() < 0.6) {
+        const dy = (rnd() < 0.5 ? -1 : 1) * (12 + Math.floor(rnd() * 2) * 12);
+        const ny = Math.min(180, Math.max(20, y + dy));
+        const c = Math.min(10, Math.abs(ny - y) / 2);
+        pts.push([x + c, y + Math.sign(ny - y) * c]);
+        pts.push([x + c, ny - Math.sign(ny - y) * 0]); // vertical run
+        y = ny;
+        x += c;
+      }
+    }
+    pts.push([300, y]);
+    dots.push({ cx: 300, cy: y, r: 4 });
+    strokes.push({ d: poly(pts) });
+  }
+  return { strokes, dots, caption: "6 nets · 45° bends · grid 12" };
+}
+
+// FIG. 03 - ridgeline terrain
+function ridgeline(seed) {
+  const rnd = mulberry32(seed);
+  const strokes = [];
+  const rows = 9;
+  const phases = Array.from({ length: rows }, () => [rnd() * 6.3, rnd() * 6.3, rnd() * 6.3]);
+  for (let r = 0; r < rows; r++) {
+    const base = 44 + r * 16;
+    const pts = [];
+    for (let x = 16; x <= 304; x += 4) {
+      const u = (x - 160) / 118;
+      const env = Math.exp(-u * u * 1.7);
+      const nz =
+        Math.sin(x * 0.045 + phases[r][0]) * 0.55 +
+        Math.sin(x * 0.11 + phases[r][1]) * 0.3 +
+        Math.sin(x * 0.23 + phases[r][2]) * 0.15;
+      pts.push([x, base - Math.max(0, env * (26 + 20 * nz))]);
+    }
+    strokes.push({ d: poly(pts) });
+  }
+  return { strokes, dots: [], caption: "9 traces · gaussian mass · σ≈42" };
+}
+
+// FIG. 04 - harmonograph, damped
+function harmonograph() {
+  const pts = [];
+  for (let i = 0; i <= 900; i++) {
+    const t = i * 0.09;
+    const d = Math.exp(-0.011 * t);
+    pts.push([
+      160 + d * (92 * Math.sin(3.01 * t + 1.1) + 34 * Math.sin(2.0 * t)),
+      100 + d * (62 * Math.sin(2.0 * t + 0.4) + 22 * Math.sin(3.0 * t + 2.0)),
+    ]);
+  }
+  return { strokes: [{ d: poly(pts) }], dots: [], caption: "f=3.01:2.00 · decay 0.011" };
+}
+
+// FIG. 05 - isometric lattice of cells with varying height
+function isometric(seed) {
+  const rnd = mulberry32(seed);
+  const strokes = [];
+  const ix = 15; // iso x step
+  const iy = 8.6;
+  const ox = 160;
+  const oy = 58;
+  const cells = [];
+  for (let r = 0; r < 4; r++)
+    for (let c = 0; c < 5; c++) cells.push([c, r, 10 + Math.floor(rnd() * 4) * 9]);
+  cells.sort((a, b) => a[0] + a[1] - (b[0] + b[1]));
+  for (const [c, r, h] of cells) {
+    const x = ox + (c - r) * ix * 1.9;
+    const y = oy + (c + r) * iy * 1.9;
+    const L = ix * 1.55;
+    const T = iy * 1.55;
+    const top = `M${f(x)} ${f(y)}L${f(x + L)} ${f(y + T)}L${f(x)} ${f(y + T * 2)}L${f(x - L)} ${f(y + T)}Z`;
+    const left = `M${f(x - L)} ${f(y + T)}L${f(x - L)} ${f(y + T + h)}L${f(x)} ${f(y + T * 2 + h)}L${f(x)} ${f(y + T * 2)}`;
+    const right = `M${f(x + L)} ${f(y + T)}L${f(x + L)} ${f(y + T + h)}L${f(x)} ${f(y + T * 2 + h)}`;
+    strokes.push({ d: top + left + right });
+  }
+  return { strokes, dots: [], caption: "iso 30° · 20 cells · h∈{10..37}" };
+}
+
+// FIG. 06 - contour rings, modulated radii
+function contours(seed) {
+  const rnd = mulberry32(seed);
+  const strokes = [];
+  const ph = [rnd() * 6.3, rnd() * 6.3, rnd() * 6.3];
+  for (let k = 1; k <= 7; k++) {
+    const base = 11 + k * 12.5;
+    const pts = [];
+    for (let i = 0; i <= 240; i++) {
+      const a = (i / 240) * Math.PI * 2;
+      const m =
+        Math.sin(a * 3 + ph[0]) * 0.16 +
+        Math.sin(a * 5 + ph[1]) * 0.08 +
+        Math.sin(a * 2 + ph[2]) * 0.1;
+      const rr = base * (1 + m * (k / 7));
+      pts.push([160 + rr * 1.35 * Math.cos(a), 100 + rr * 0.86 * Math.sin(a)]);
+    }
+    strokes.push({ d: poly(pts) + "Z" });
+  }
+  return { strokes, dots: [], caption: "7 isolines · Δ=12.5" };
+}
+
+// FIG. 07 - seeded walk on a 12px grid, momentum-biased, crossings allowed
+function gridwalk(seed) {
+  const rnd = mulberry32(seed);
+  const step = 12;
+  let x = 28;
+  let y = 100;
+  let dir = 0; // 0 E, 1 S, 2 W, 3 N
+  const pts = [[x, y]];
+  let steps = 0;
+  for (let i = 0; i < 240; i++) {
+    const candidates = rnd() < 0.55 ? [dir, (dir + 1) % 4, (dir + 3) % 4] : rnd() < 0.5 ? [(dir + 1) % 4, dir, (dir + 3) % 4] : [(dir + 3) % 4, dir, (dir + 1) % 4];
+    for (const nd of candidates) {
+      const nx = x + (nd === 0 ? step : nd === 2 ? -step : 0);
+      const ny = y + (nd === 1 ? step : nd === 3 ? -step : 0);
+      if (nx < 24 || nx > 296 || ny < 20 || ny > 180) continue;
+      x = nx; y = ny; dir = nd;
+      pts.push([x, y]);
+      steps++;
+      break;
+    }
+  }
+  return {
+    strokes: [{ d: poly(pts) }],
+    dots: [{ cx: pts[0][0], cy: pts[0][1], r: 4 }, { cx: x, cy: y, r: 4 }],
+    caption: `walk · ${steps} steps · grid 12 · seed ${seed}`,
+  };
+}
+
+// FIG. 08 - stipple field, radius modulated by a standing wave
+function stipple() {
+  const dots = [];
+  for (let gy = 0; gy < 11; gy++) {
+    for (let gx = 0; gx < 20; gx++) {
+      const x = 24 + gx * 14.3;
+      const y = 24 + gy * 15.4;
+      const u = (x - 160) / 150;
+      const v = (y - 100) / 90;
+      const w = 0.5 + 0.5 * Math.sin(x * 0.055 + Math.sin(y * 0.045) * 2.4);
+      const fall = Math.max(0, 1 - (u * u + v * v) * 0.55);
+      const r = 0.5 + 4.6 * w * fall;
+      if (r > 0.7) dots.push({ cx: f(x), cy: f(y), r: f(r) });
+    }
+  }
+  return { strokes: [], dots, caption: `${dots.length} pts · r ∝ sin(x + sin y)` };
+}
+
+export const FIG_W = W;
+export const FIG_H = H;
+
+export function buildFigure(kind, seed) {
+  switch (kind) {
+    case "lissajous": return lissajous();
+    case "copper": return copper(seed);
+    case "ridgeline": return ridgeline(seed);
+    case "harmonograph": return harmonograph();
+    case "isometric": return isometric(seed);
+    case "contours": return contours(seed);
+    case "gridwalk": return gridwalk(seed);
+    case "stipple": return stipple();
+    default: return lissajous();
+  }
+}
+
+// Hero curve: a 5:4 Lissajous, drawn once on load; the pen head follows this exact path.
+export const HERO_W = 960;
+export const HERO_H = 520;
+
+export function heroCurve() {
+  const pts = [];
+  for (let i = 0; i <= 780; i++) {
+    const t = (i / 780) * Math.PI * 2;
+    pts.push([
+      480 + 430 * Math.sin(5 * t + Math.PI / 6),
+      260 + 205 * Math.sin(4 * t),
+    ]);
+  }
+  return poly(pts);
+}
