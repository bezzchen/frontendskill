+import { FIG_W, FIG_H } from "./figures";
+
+// Server component: renders one pre-computed figure as inline SVG.
+// pathLength=1 normalizes every stroke so CSS can draw it in with a single rule.
+export function FigureSvg({ fig }) {
+  return (
+    <div className="plotarea" aria-hidden="true">
+      <svg viewBox={`0 0 ${FIG_W} ${FIG_H}`} xmlns="http://www.w3.org/2000/svg" role="presentation">
+        {fig.strokes.map((s, i) => (
+          <path key={`s${i}`} d={s.d} pathLength="1" style={{ "--i": i }} />
+        ))}
+        {fig.dots.map((c, i) => (
+          <circle key={`c${i}`} cx={c.cx} cy={c.cy} r={c.r} style={{ "--i": i }} />
+        ))}
+      </svg>
+    </div>
+  );
+}
