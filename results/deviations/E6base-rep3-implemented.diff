diff --git a/components/SkyChart.jsx b/components/SkyChart.jsx
new file mode 100644
index 0000000..dbf7823
--- /dev/null
+++ b/components/SkyChart.jsx
@@ -0,0 +1,364 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+import { constellationItems } from "./ConstellationData";
+
+const CATEGORIES = ["engineering", "research", "design", "math"];
+
+function mulberry32(seed) {
+  let a = seed | 0;
+  return function () {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/* Deterministic star field derived from the dataset. */
+function buildStars() {
+  const rng = mulberry32(20260901);
+  return constellationItems.map((item) => {
+    const z = 0.35 + rng() * 0.65; // depth: parallax + size
+    return {
+      item,
+      cat: CATEGORIES.indexOf(item.category),
+      x0: rng(),
+      y0: Math.pow(rng(), 1.18), // slightly denser sky toward the top
+      z,
+      r: (0.5 + rng() * 0.9) * (0.6 + z * 0.8),
+      bright: rng() < 0.045,
+      tw: rng() * Math.PI * 2,
+      twf: 0.5 + rng() * 1.4,
+      amp: 1.5 + rng() * 3.5,
+      amp2: 1.5 + rng() * 3.5,
+      ph: rng() * Math.PI * 2,
+      ph2: rng() * Math.PI * 2,
+      sp: 0.08 + rng() * 0.14,
+      sp2: 0.08 + rng() * 0.14,
+    };
+  });
+}
+
+/* Constellation links: nearest same-category neighbours, computed once. */
+function buildLinks(stars) {
+  const cell = 0.05;
+  const grid = new Map();
+  stars.forEach((s, i) => {
+    const key = `${Math.floor(s.x0 / cell)},${Math.floor(s.y0 / cell)}`;
+    if (!grid.has(key)) grid.set(key, []);
+    grid.get(key).push(i);
+  });
+  const rng = mulberry32(4145);
+  const pairs = new Set();
+  const links = [];
+  stars.forEach((s, i) => {
+    const cx = Math.floor(s.x0 / cell);
+    const cy = Math.floor(s.y0 / cell);
+    const near = [];
+    for (let gx = cx - 1; gx <= cx + 1; gx++) {
+      for (let gy = cy - 1; gy <= cy + 1; gy++) {
+        const bucket = grid.get(`${gx},${gy}`);
+        if (!bucket) continue;
+        for (const j of bucket) {
+          if (j === i || stars[j].cat !== s.cat) continue;
+          const dx = stars[j].x0 - s.x0;
+          const dy = stars[j].y0 - s.y0;
+          const d = dx * dx + dy * dy;
+          if (d < 0.055 * 0.055) near.push([d, j]);
+        }
+      }
+    }
+    near.sort((a, b) => a[0] - b[0]);
+    const take = near.length > 1 && rng() < 0.3 ? 2 : 1;
+    for (let k = 0; k < Math.min(take, near.length); k++) {
+      const j = near[k][1];
+      const key = i < j ? `${i}-${j}` : `${j}-${i}`;
+      if (!pairs.has(key) && links.length < 420) {
+        pairs.add(key);
+        links.push([Math.min(i, j), Math.max(i, j)]);
+      }
+    }
+  });
+  return links;
+}
+
+export function SkyChart() {
+  const canvasRef = useRef(null);
+  const wrapRef = useRef(null);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    const wrap = wrapRef.current;
+    if (!canvas || !wrap) return;
+    const ctx = canvas.getContext("2d");
+
+    const stars = buildStars();
+    const links = buildLinks(stars);
+    const n = stars.length;
+    const px = new Float32Array(n);
+    const py = new Float32Array(n);
+
+    let w = 0;
+    let h = 0;
+    let dpr = 1;
+    let count = n;
+
+    let palette = null;
+    let monoFam = "monospace";
+
+    const pointer = { x: -1, y: -1, inside: false };
+    const par = { x: 0, y: 0, tx: 0, ty: 0 };
+    let hovered = -1;
+
+    let raf = 0;
+    let running = false;
+    let inView = true;
+    const reducedQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
+    let reduced = reducedQuery.matches;
+
+    const shoot = { active: false, x: 0, y: 0, vx: 0, vy: 0, born: 0, next: 5 + Math.random() * 8 };
+
+    function readPalette() {
+      const cs = getComputedStyle(document.documentElement);
+      const v = (name, fallback) => (cs.getPropertyValue(name) || fallback).trim();
+      palette = {
+        stars: [
+          v("--star-engineering", "#8ab"),
+          v("--star-research", "#cde"),
+          v("--star-design", "#da8"),
+          v("--star-math", "#d87"),
+        ],
+        line: v("--chart-line", "rgba(128,128,128,0.15)"),
+        accent: v("--accent", "#f64"),
+        fg: v("--foreground", "#ccc"),
+        muted: v("--muted", "#889"),
+      };
+      const fam = v("--font-spline", "");
+      monoFam = fam ? `${fam}, monospace` : "monospace";
+    }
+
+    function resize() {
+      const rect = wrap.getBoundingClientRect();
+      w = Math.max(1, rect.width);
+      h = Math.max(1, rect.height);
+      dpr = Math.min(window.devicePixelRatio || 1, 2);
+      canvas.width = Math.round(w * dpr);
+      canvas.height = Math.round(h * dpr);
+      count = w < 640 ? 300 : n;
+      if (reduced) draw(0);
+    }
+
+    function draw(t) {
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      ctx.clearRect(0, 0, w, h);
+
+      par.x += (par.tx - par.x) * 0.06;
+      par.y += (par.ty - par.y) * 0.06;
+
+      for (let i = 0; i < count; i++) {
+        const s = stars[i];
+        px[i] = s.x0 * w + Math.sin(t * s.sp + s.ph) * s.amp + par.x * 26 * s.z;
+        py[i] = s.y0 * h + Math.cos(t * s.sp2 + s.ph2) * s.amp2 + par.y * 18 * s.z;
+      }
+
+      // Constellation lines
+      ctx.strokeStyle = palette.line;
+      ctx.lineWidth = 1;
+      ctx.beginPath();
+      for (const [i, j] of links) {
+        if (i >= count || j >= count) continue;
+        ctx.moveTo(px[i], py[i]);
+        ctx.lineTo(px[j], py[j]);
+      }
+      ctx.stroke();
+
+      // Stars
+      for (let i = 0; i < count; i++) {
+        const s = stars[i];
+        const twinkle = reduced ? 0.75 : 0.62 + 0.38 * Math.sin(t * s.twf + s.tw);
+        ctx.globalAlpha = 0.35 + 0.6 * Math.max(0, twinkle);
+        ctx.fillStyle = palette.stars[s.cat];
+        if (s.bright) {
+          ctx.shadowBlur = 9;
+          ctx.shadowColor = palette.stars[s.cat];
+        }
+        ctx.beginPath();
+        ctx.arc(px[i], py[i], s.bright ? s.r * 2 : s.r, 0, Math.PI * 2);
+        ctx.fill();
+        if (s.bright) ctx.shadowBlur = 0;
+      }
+      ctx.globalAlpha = 1;
+
+      // Shooting star
+      if (!reduced && shoot.active) {
+        const age = t - shoot.born;
+        if (age > 0.9) {
+          shoot.active = false;
+          shoot.next = t + 6 + Math.random() * 9;
+        } else {
+          const sx = shoot.x + shoot.vx * age;
+          const sy = shoot.y + shoot.vy * age;
+          const grad = ctx.createLinearGradient(sx, sy, sx - shoot.vx * 0.14, sy - shoot.vy * 0.14);
+          grad.addColorStop(0, palette.stars[1]);
+          grad.addColorStop(1, "rgba(0,0,0,0)");
+          ctx.strokeStyle = grad;
+          ctx.lineWidth = 1.2;
+          ctx.globalAlpha = Math.sin((age / 0.9) * Math.PI);
+          ctx.beginPath();
+          ctx.moveTo(sx, sy);
+          ctx.lineTo(sx - shoot.vx * 0.14, sy - shoot.vy * 0.14);
+          ctx.stroke();
+          ctx.globalAlpha = 1;
+        }
+      } else if (!reduced && t > shoot.next) {
+        shoot.active = true;
+        shoot.born = t;
+        shoot.x = w * (0.15 + Math.random() * 0.7);
+        shoot.y = h * (0.05 + Math.random() * 0.3);
+        const ang = Math.PI * (0.15 + Math.random() * 0.2);
+        const speed = 260 + Math.random() * 160;
+        shoot.vx = Math.cos(ang) * speed * (Math.random() < 0.5 ? -1 : 1);
+        shoot.vy = Math.sin(ang) * speed;
+      }
+
+      // Hover pick: nearest star, instrument-style readout
+      hovered = -1;
+      if (pointer.inside) {
+        let best = 28 * 28;
+        for (let i = 0; i < count; i++) {
+          const dx = px[i] - pointer.x;
+          const dy = py[i] - pointer.y;
+          const d = dx * dx + dy * dy;
+          if (d < best) {
+            best = d;
+            hovered = i;
+          }
+        }
+      }
+      if (hovered >= 0) {
+        const s = stars[hovered];
+        const hx = px[hovered];
+        const hy = py[hovered];
+        ctx.strokeStyle = palette.accent;
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.arc(hx, hy, 7, 0, Math.PI * 2);
+        ctx.stroke();
+        const flip = hx > w - 170;
+        const lx = hx + (flip ? -14 : 14);
+        ctx.beginPath();
+        ctx.moveTo(hx + (flip ? -8 : 8), hy);
+        ctx.lineTo(lx, hy);
+        ctx.stroke();
+        ctx.font = `10px ${monoFam}`;
+        ctx.textAlign = flip ? "right" : "left";
+        ctx.textBaseline = "middle";
+        ctx.fillStyle = palette.accent;
+        const label = `${s.item.label} / ${s.item.category}`.toUpperCase();
+        ctx.fillText(label, lx + (flip ? -5 : 5), hy);
+      }
+    }
+
+    function frame(now) {
+      raf = 0;
+      if (!running) return;
+      draw(now / 1000);
+      raf = requestAnimationFrame(frame);
+    }
+
+    function setRunning(on) {
+      const next = on && inView && !document.hidden && !reduced;
+      if (next === running) return;
+      running = next;
+      if (running && !raf) raf = requestAnimationFrame(frame);
+      if (!running && raf) {
+        cancelAnimationFrame(raf);
+        raf = 0;
+      }
+    }
+
+    function onPointerMove(e) {
+      const rect = canvas.getBoundingClientRect();
+      const x = e.clientX - rect.left;
+      const y = e.clientY - rect.top;
+      const inside = x >= 0 && y >= 0 && x <= rect.width && y <= rect.height;
+      pointer.x = x;
+      pointer.y = y;
+      pointer.inside = inside;
+      if (inside) {
+        par.tx = x / rect.width - 0.5;
+        par.ty = y / rect.height - 0.5;
+      } else {
+        par.tx = 0;
+        par.ty = 0;
+      }
+      if (reduced) draw(0);
+    }
+    function onPointerLeave(e) {
+      if (e.relatedTarget) return; // only when leaving the window
+      pointer.inside = false;
+      par.tx = 0;
+      par.ty = 0;
+      if (reduced) draw(0);
+    }
+
+    const onScheme = () => {
+      readPalette();
+      if (reduced) draw(0);
+    };
+    const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
+
+    const onReduced = () => {
+      reduced = reducedQuery.matches;
+      if (reduced) {
+        setRunning(false);
+        par.x = par.tx = 0;
+        par.y = par.ty = 0;
+        draw(0);
+      } else {
+        setRunning(true);
+      }
+    };
+
+    const io = new IntersectionObserver(
+      (entries) => {
+        inView = entries[0]?.isIntersecting ?? true;
+        setRunning(true);
+      },
+      { threshold: 0 }
+    );
+    const ro = new ResizeObserver(resize);
+    const onVisibility = () => setRunning(true);
+
+    readPalette();
+    resize();
+    if (reduced) draw(0);
+    else setRunning(true);
+
+    io.observe(canvas);
+    ro.observe(wrap);
+    window.addEventListener("pointermove", onPointerMove, { passive: true });
+    window.addEventListener("pointerout", onPointerLeave, { passive: true });
+    document.addEventListener("visibilitychange", onVisibility);
+    darkQuery.addEventListener("change", onScheme);
+    reducedQuery.addEventListener("change", onReduced);
+
+    return () => {
+      setRunning(false);
+      io.disconnect();
+      ro.disconnect();
+      window.removeEventListener("pointermove", onPointerMove);
+      window.removeEventListener("pointerout", onPointerLeave);
+      document.removeEventListener("visibilitychange", onVisibility);
+      darkQuery.removeEventListener("change", onScheme);
+      reducedQuery.removeEventListener("change", onReduced);
+    };
+  }, []);
+
+  return (
+    <div ref={wrapRef} aria-hidden="true" className="absolute inset-0 overflow-hidden">
+      <canvas ref={canvasRef} className="block h-full w-full" />
+    </div>
+  );
+}
