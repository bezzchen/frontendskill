+
+function mulberry32(seed) {
+  let a = seed | 0;
+  return function () {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const f = (x) => Math.round(x * 100) / 100;
+
+/* Shared chart-frame ticks so all plates read as one atlas. */
+function FrameTicks() {
+  const ticks = [];
+  for (let i = 1; i < 8; i++) {
+    const x = f((320 / 8) * i);
+    ticks.push(`M${x} 0V5`, `M${x} 200V195`);
+  }
+  for (let i = 1; i < 5; i++) {
+    const y = f((200 / 5) * i);
+    ticks.push(`M0 ${y}H5`, `M320 ${y}H315`);
+  }
+  return <path d={ticks.join("")} stroke="var(--chart-line)" strokeWidth="1" fill="none" />;
+}
+
+/* Systems: circuit-trace walks across a survey grid. */
+function LatticeFigure({ seed }) {
+  const rng = mulberry32(seed * 7919 + 17);
+  const cols = 13;
+  const rows = 8;
+  const mx = 26;
+  const my = 24;
+  const sx = (320 - mx * 2) / (cols - 1);
+  const sy = (200 - my * 2) / (rows - 1);
+  const pt = (c, r) => [f(mx + c * sx), f(my + r * sy)];
+
+  const walk = (steps) => {
+    let c = 1 + Math.floor(rng() * (cols - 2));
+    let r = 1 + Math.floor(rng() * (rows - 2));
+    let horizontal = rng() < 0.5;
+    const pts = [pt(c, r)];
+    for (let i = 0; i < steps; i++) {
+      const d = (1 + Math.floor(rng() * 3)) * (rng() < 0.5 ? -1 : 1);
+      if (horizontal) c = Math.max(0, Math.min(cols - 1, c + d));
+      else r = Math.max(0, Math.min(rows - 1, r + d));
+      horizontal = !horizontal;
+      pts.push(pt(c, r));
+    }
+    return pts;
+  };
+  const toPath = (pts) => "M" + pts.map(([x, y]) => `${x} ${y}`).join("L");
+
+  const inkWalks = Array.from({ length: 4 }, () => walk(5 + Math.floor(rng() * 3)));
+  const accent = walk(8);
+
+  const dots = [];
+  for (let c = 0; c < cols; c++)
+    for (let r = 0; r < rows; r++) {
+      const [x, y] = pt(c, r);
+      dots.push(<circle key={`${c}-${r}`} cx={x} cy={y} r="1" fill="var(--chart-line)" />);
+    }
+
+  return (
+    <g>
+      {dots}
+      {inkWalks.map((pts, i) => (
+        <path
+          key={i}
+          d={toPath(pts)}
+          fill="none"
+          stroke="currentColor"
+          strokeOpacity={0.5 - i * 0.08}
+          strokeWidth="1"
+          strokeLinejoin="round"
+        />
+      ))}
+      <path
+        className="figure-trace"
+        d={toPath(accent)}
+        pathLength="1"
+        fill="none"
+        stroke="var(--accent)"
+        strokeWidth="1.5"
+        strokeLinejoin="round"
+      />
+      <circle cx={accent[0][0]} cy={accent[0][1]} r="2.6" fill="var(--accent)" />
+      <circle
+        cx={accent[accent.length - 1][0]}
+        cy={accent[accent.length - 1][1]}
+        r="2.6"
+        fill="none"
+        stroke="var(--accent)"
+        strokeWidth="1.2"
+      />
+    </g>
+  );
+}
+
+/* Computational design: distorted isoline contours around a survey mark. */
+function IsolineFigure({ seed }) {
+  const rng = mulberry32(seed * 104729 + 3);
+  const cx = 160 + (rng() - 0.5) * 36;
+  const cy = 102 + (rng() - 0.5) * 24;
+  const p1 = rng() * Math.PI * 2;
+  const p2 = rng() * Math.PI * 2;
+  const squash = 0.72 + rng() * 0.12;
+
+  const ring = (k) => {
+    const base = 13 + k * 11.5;
+    const a1 = (2.5 + rng() * 4) * (0.35 + k / 7);
+    const a2 = (1.2 + rng() * 2.4) * (0.35 + k / 7);
+    let d = "";
+    for (let deg = 0; deg <= 360; deg += 5) {
+      const th = (deg * Math.PI) / 180;
+      const r = base + a1 * Math.sin(3 * th + p1) + a2 * Math.sin(5 * th + p2);
+      const x = f(cx + r * Math.cos(th));
+      const y = f(cy + r * Math.sin(th) * squash);
+      d += (deg === 0 ? "M" : "L") + `${x} ${y}`;
+    }
+    return d + "Z";
+  };
+
+  const rings = Array.from({ length: 8 }, (_, k) => ring(k));
+  const accentD = rings[3];
+
+  return (
+    <g>
+      {rings.map((d, k) => (
+        <path
+          key={k}
+          d={d}
+          fill="none"
+          stroke="currentColor"
+          strokeOpacity={f(0.52 - k * 0.045)}
+          strokeWidth="1"
+        />
+      ))}
+      <path
+        className="figure-trace"
+        d={accentD}
+        pathLength="1"
+        fill="none"
+        stroke="var(--accent)"
+        strokeWidth="1.4"
+      />
+      <path
+        d={`M${f(cx - 5)} ${f(cy)}H${f(cx + 5)}M${f(cx)} ${f(cy - 5)}V${f(cy + 5)}`}
+        stroke="currentColor"
+        strokeOpacity="0.7"
+        strokeWidth="1"
+      />
+    </g>
+  );
+}
+
+/* Interfaces: pen-tool easing curves with visible control handles. */
+function EasingFigure({ seed }) {
+  const rng = mulberry32(seed * 15485863 + 11);
+  const x0 = 38;
+  const x1 = 282;
+
+  const curves = Array.from({ length: 3 }, () => {
+    const y0 = 150 + (rng() - 0.5) * 28;
+    const y1 = 46 + (rng() - 0.5) * 28;
+    const c1x = x0 + 55 + rng() * 55;
+    const c1y = y0 - 30 - rng() * 70;
+    const c2x = x1 - 55 - rng() * 55;
+    const c2y = y1 + 30 + rng() * 70;
+    return { y0: f(y0), y1: f(y1), c1x: f(c1x), c1y: f(c1y), c2x: f(c2x), c2y: f(c2y) };
+  });
+  const a = curves[1];
+  const d = (c) => `M${x0} ${c.y0}C${c.c1x} ${c.c1y} ${c.c2x} ${c.c2y} ${x1} ${c.y1}`;
+
+  const rules = Array.from({ length: 5 }, (_, i) => f(30 + i * 35));
+
+  return (
+    <g>
+      {rules.map((y) => (
+        <line key={y} x1="24" x2="296" y1={y} y2={y} stroke="var(--chart-faint)" strokeWidth="1" />
+      ))}
+      {curves.map((c, i) =>
+        i === 1 ? null : (
+          <path key={i} d={d(c)} fill="none" stroke="currentColor" strokeOpacity="0.4" strokeWidth="1" />
+        )
+      )}
+      <line x1={x0} y1={a.y0} x2={a.c1x} y2={a.c1y} stroke="var(--chart-line)" strokeDasharray="3 3" />
+      <line x1={x1} y1={a.y1} x2={a.c2x} y2={a.c2y} stroke="var(--chart-line)" strokeDasharray="3 3" />
+      <path
+        className="figure-trace"
+        d={d(a)}
+        pathLength="1"
+        fill="none"
+        stroke="var(--accent)"
+        strokeWidth="1.6"
+      />
+      <circle cx={a.c1x} cy={a.c1y} r="2.6" fill="var(--surface)" stroke="var(--muted)" strokeWidth="1" />
+      <circle cx={a.c2x} cy={a.c2y} r="2.6" fill="var(--surface)" stroke="var(--muted)" strokeWidth="1" />
+      <rect x={x0 - 2.5} y={a.y0 - 2.5} width="5" height="5" fill="currentColor" />
+      <rect x={x1 - 2.5} y={a.y1 - 2.5} width="5" height="5" fill="currentColor" />
+    </g>
+  );
+}
+
+/* Research: annotated scatter with a fitted trace. */
+function ScatterFigure({ seed }) {
+  const rng = mulberry32(seed * 6700417 + 29);
+  const pts = Array.from({ length: 24 }, () => ({
+    x: f(30 + rng() * 260),
+    y: f(34 + rng() * 136),
+    r: f(1.2 + rng() * 1.9),
+    open: rng() < 0.18,
+  }));
+  const fit = [...pts]
+    .sort((p, q) => p.x - q.x)
+    .filter((_, i) => i % 3 === 0);
+  const fitD = "M" + fit.map((p) => `${p.x} ${f(p.y * 0.4 + 60)}`).join("L");
+  const mark = pts[Math.floor(rng() * pts.length)];
+  const flip = mark.x > 220;
+
+  return (
+    <g>
+      {pts.map((p, i) =>
+        p.open ? (
+          <circle key={i} cx={p.x} cy={p.y} r={p.r + 1} fill="none" stroke="currentColor" strokeOpacity="0.55" strokeWidth="1" />
+        ) : (
+          <circle key={i} cx={p.x} cy={p.y} r={p.r} fill="currentColor" fillOpacity="0.55" />
+        )
+      )}
+      <path className="figure-trace" d={fitD} pathLength="1" fill="none" stroke="var(--accent)" strokeWidth="1.4" strokeLinejoin="round" />
+      <circle cx={mark.x} cy={mark.y} r="6" fill="none" stroke="var(--muted)" strokeWidth="1" />
+      <line
+        x1={f(mark.x + (flip ? -6 : 6))}
+        y1={mark.y}
+        x2={f(mark.x + (flip ? -30 : 30))}
+        y2={mark.y}
+        stroke="var(--muted)"
+        strokeWidth="1"
+      />
+      <text
+        x={f(mark.x + (flip ? -34 : 34))}
+        y={f(mark.y + 2.5)}
+        textAnchor={flip ? "end" : "start"}
+        fill="var(--muted)"
+        style={{ font: "7px var(--font-spline), monospace", letterSpacing: "0.08em" }}
+      >
+        OBS {String(seed).padStart(2, "0")}
+      </text>
+    </g>
+  );
+}
+
+const FIGURES = {
+  Systems: LatticeFigure,
+  "Computational design": IsolineFigure,
+  Interfaces: EasingFigure,
+  Research: ScatterFigure,
+};
+
+function PlateFigure({ project }) {
+  const Figure = FIGURES[project.tag];
+  return (
+    <svg
+      viewBox="0 0 320 200"
+      preserveAspectRatio="xMidYMid slice"
+      aria-hidden="true"
+      focusable="false"
+      className="h-full w-full text-[var(--foreground)]"
+    >
+      <FrameTicks />
+      <g className="figure-plot">
+        <Figure seed={project.id} />
+      </g>
+    </svg>
+  );
+}
 
 export function ProjectGrid() {
   return (
-    <section aria-labelledby="projects-title" className="space-y-6">
-      <h2 id="projects-title" className="text-3xl font-semibold">Selected projects</h2>
