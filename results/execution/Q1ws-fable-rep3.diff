diff --git a/app/globals.css b/app/globals.css
index 6529d42..ed1403b 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -7,6 +7,8 @@
   --muted: #6b6b66;
   --surface: #ffffff;
   --line: #deded8;
+  --line-strong: color-mix(in oklab, var(--line) 55%, var(--muted));
+  --danger: #b3261e;
 }
 
 @media (prefers-color-scheme: dark) {
@@ -16,6 +18,7 @@
     --muted: #a0a099;
     --surface: #181817;
     --line: #31312f;
+    --danger: #f28b82;
   }
 }
 
@@ -24,3 +27,51 @@ html { background: var(--background); color: var(--foreground); }
 body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
 a { color: inherit; }
 button, input { font: inherit; }
+
+/* Consistent, high-contrast keyboard focus across the site. */
+:where(a, button, input, select, textarea, [tabindex]):focus-visible {
+  outline: 2px solid var(--foreground);
+  outline-offset: 2px;
+}
+
+/*
+ * Toggle switch built on a native checkbox: keyboard, label association,
+ * and form semantics come from the input itself; this is presentation only.
+ */
+.switch {
+  appearance: none;
+  -webkit-appearance: none;
+  flex: none;
+  position: relative;
+  width: 2.25rem;
+  height: 1.25rem;
+  margin: 0;
+  border-radius: 999px;
+  background: var(--muted);
+  cursor: pointer;
+  transition: background-color 160ms ease;
+}
+.switch::before {
+  content: "";
+  position: absolute;
+  top: 0.125rem;
+  left: 0.125rem;
+  width: 1rem;
+  height: 1rem;
+  border-radius: 999px;
+  background: var(--surface);
+  box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
+  transition: transform 160ms ease;
+}
+.switch:checked { background: var(--foreground); }
+.switch:checked::before { transform: translateX(1rem); }
+
+/* Reduce all motion to imperceptible durations when the user asks for it. */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
