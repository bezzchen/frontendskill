 @import "tailwindcss";
 
+/* ------------------------------------------------------------------
+   MERIDIAN — design tokens
+   Stage (light canvas where compositions render) + Chrome (instrument
+   panel). Functional NLE colors: playhead red, keyframe amber,
+   selection cyan.
+------------------------------------------------------------------- */
 :root {
   color-scheme: light dark;
-  --background: #f5f5f3;
-  --foreground: #161616;
-  --muted: #6b6b66;
-  --surface: #ffffff;
-  --line: #deded8;
+
+  --paper: #ebede9;
+  --paper-high: #f6f7f4;
+  --ink: #17191b;
+  --muted: #575c55;
+  --hair: #c7cac1;
+  --hair-soft: #d9dcd3;
+
+  --chrome: #141519;
+  --chrome-2: #1b1d22;
+  --chrome-deep: #0e0f12;
+  --chrome-line: #2b2e34;
+  --chrome-ink: #e9ebe6;
+  --chrome-mut: #8f949a;
+
+  --red: #d8391c;
+  --red-hi: #ff5a3c;
+  --amber: #f2b63c;
+  --cyan: #3fc1d8;
+
+  --sans: var(--font-archivo), "Archivo", system-ui, sans-serif;
+  --mono: var(--font-martian), "Martian Mono", ui-monospace, monospace;
+
+  --dock-h: 116px;
+  --wrap: 1240px;
 }
 
 @media (prefers-color-scheme: dark) {
   :root {
-    --background: #111110;
-    --foreground: #f5f5f2;
-    --muted: #a0a099;
-    --surface: #181817;
-    --line: #31312f;
+    --paper: #1b1d20;
+    --paper-high: #212327;
+    --ink: #eceee9;
+    --muted: #a0a59e;
+    --hair: #34373c;
+    --hair-soft: #2a2d31;
+    --chrome: #101114;
+    --chrome-2: #17181c;
+    --chrome-deep: #0b0c0e;
+    --chrome-line: #292c31;
+    --red: #ff5a3c;
+  }
+}
+
+/* ------------------------------------------------------------------
+   Base
+------------------------------------------------------------------- */
+* {
+  box-sizing: border-box;
+}
+
+html {
+  background: var(--paper);
+  color: var(--ink);
+  scroll-behavior: auto; /* the dock owns smoothness deliberately */
+}
+
+body {
+  margin: 0;
+  font-family: var(--sans);
+  font-size: 16.5px;
+  line-height: 1.6;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  overflow-x: clip;
+}
+
+a {
+  color: inherit;
+}
+
+button,
+input {
+  font: inherit;
+}
+
+::selection {
+  background: var(--red);
+  color: #fff;
+}
+
+:focus-visible {
+  outline: 2px solid var(--cyan);
+  outline-offset: 2px;
+  border-radius: 2px;
+}
+
+.mono {
+  font-family: var(--mono);
+}
+
+.wrap {
+  max-width: var(--wrap);
+  margin-inline: auto;
+  padding-inline: clamp(20px, 4vw, 48px);
+}
+
+main {
+  padding-bottom: calc(var(--dock-h) + 88px);
+}
+
+.skip {
+  position: absolute;
+  left: 16px;
+  top: -60px;
+  z-index: 100;
+  background: var(--ink);
+  color: var(--paper);
+  padding: 10px 16px;
+  border-radius: 6px;
+  font-size: 14px;
+  transition: top 0.15s ease;
+}
+
+.skip:focus-visible {
+  top: 16px;
+}
+
+/* Progressive enhancement: interactive chrome appears once JS runs */
+.dock,
+.sweep,
+.btn[data-play] {
+  display: none;
+}
+
+/* ------------------------------------------------------------------
+   Header
+------------------------------------------------------------------- */
+.site-head {
+  border-bottom: 1px solid var(--hair);
+}
+
+.site-head .wrap {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding-block: 18px;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 10px;
+  text-decoration: none;
+}
+
+.brand .word {
+  font-family: var(--sans);
+  font-variation-settings: "wdth" 125;
+  font-weight: 800;
+  font-size: 17px;
+  letter-spacing: 0.06em;
+}
+
+.brand .beta {
+  font-family: var(--mono);
+  font-size: 9px;
+  letter-spacing: 0.14em;
+  color: var(--red);
+  border: 1px solid currentColor;
+  border-radius: 3px;
+  padding: 2px 5px;
+  transform: translateY(-2px);
+}
+
+/* ------------------------------------------------------------------
+   Buttons
+------------------------------------------------------------------- */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  border: 1px solid var(--ink);
+  border-radius: 7px;
+  padding: 12px 22px;
+  font-size: 15px;
+  font-weight: 600;
+  text-decoration: none;
+  background: none;
+  color: var(--ink);
+  cursor: pointer;
+  transition: background-color 0.16s ease, color 0.16s ease,
+    border-color 0.16s ease;
+}
+
+.btn-primary {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.btn-primary:hover {
+  background: var(--red);
+  border-color: var(--red);
+  color: #fff;
+}
+
+.btn-ghost:hover {
+  border-color: var(--red);
+  color: var(--red);
+}
+
+.btn-small {
+  padding: 8px 14px;
+  font-size: 13.5px;
+  border-radius: 6px;
+}
+
+.btn .tri {
+  width: 0;
+  height: 0;
+  border-block: 5px solid transparent;
+  border-left: 8px solid var(--red);
+}
+
+.btn-ghost:hover .tri {
+  border-left-color: currentColor;
+}
+
+/* ------------------------------------------------------------------
+   Eyebrows / section furniture — clip metadata, mirrored in the dock
+------------------------------------------------------------------- */
+.eyebrow {
+  font-family: var(--mono);
+  font-size: 10.5px;
+  font-weight: 500;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--muted);
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 0 0 22px;
+}
+
+.eyebrow::before {
+  content: "";
+  width: 7px;
+  height: 7px;
+  background: var(--amber);
+  border: 1px solid var(--ink);
+  rotate: 45deg;
+  flex: none;
+}
+
+.eyebrow .tc-range {
+  margin-left: auto;
+  color: var(--red);
+  letter-spacing: 0.08em;
+}
+
+section {
+  scroll-margin-top: 24px;
+}
+
+/* ------------------------------------------------------------------
+   Hero
+------------------------------------------------------------------- */
+.hero .wrap {
+  padding-top: clamp(48px, 9vh, 96px);
+}
+
+.h1 {
+  margin: 0 0 30px;
+  font-variation-settings: "wdth" 125;
+  font-weight: 800;
+  text-transform: uppercase;
+  font-size: clamp(42px, 7.7vw, 108px);
+  line-height: 0.93;
+  letter-spacing: -0.012em;
+}
+
+.h1 .hw {
+  display: inline-block;
+}
+
+.hero-sub {
+  max-width: 60ch;
+  margin: 0 0 34px;
+  font-size: clamp(16.5px, 1.5vw, 19px);
+  color: var(--muted);
+}
+
+.hero-sub strong {
+  color: var(--ink);
+  font-weight: 600;
+}
+
+.hero-ctas {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+  margin-bottom: clamp(48px, 8vh, 84px);
+}
+
+html.js .btn[data-play] {
+  display: inline-flex;
+}
+
+/* Hero figure: drafting-table cubic, grabbed by its handles */
+.hero-fig {
+  border-block: 1px solid var(--hair);
+  background: var(--paper-high);
+}
+
+.hero-fig svg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+.fig-caption {
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 12px 0 0;
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.12em;
+  color: var(--muted);
+  text-transform: uppercase;
+}
+
+.scrub-hint {
+  margin-top: clamp(40px, 7vh, 72px);
+  font-family: var(--mono);
+  font-size: 11px;
+  letter-spacing: 0.1em;
+  color: var(--muted);
+  display: none;
+}
+
+html.js .scrub-hint {
+  display: block;
+}
+
+.scrub-hint b {
+  color: var(--red);
+  font-weight: 500;
+}
+
+/* Hero entrance — a one-shot render pass, armed by JS, killed by RM */
+.hero.play .hw {
+  animation: hw-rise 0.8s cubic-bezier(0.18, 0.9, 0.24, 1.12) both;
+  animation-delay: calc(0.1s + var(--i) * 0.07s);
+}
+
+.hero.play .hero-sub,
+.hero.play .hero-ctas,
+.hero.play .eyebrow {
+  animation: soft-rise 0.7s ease-out both;
+}
+
+.hero.play .eyebrow {
+  animation-delay: 0.02s;
+}
+
+.hero.play .hero-sub {
+  animation-delay: 0.42s;
+}
+
+.hero.play .hero-ctas {
+  animation-delay: 0.52s;
+}
+
+.hero.play .curve {
+  stroke-dasharray: 1;
+  stroke-dashoffset: 1;
+  animation: draw-in 1.15s cubic-bezier(0.45, 0, 0.2, 1) 0.45s both;
+}
+
+.hero.play .fig-detail {
+  animation: soft-rise 0.6s ease-out 1.15s both;
+}
+
+@keyframes hw-rise {
+  from {
+    opacity: 0;
+    transform: translateY(0.38em);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+@keyframes soft-rise {
+  from {
+    opacity: 0;
+    transform: translateY(14px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+@keyframes draw-in {
+  to {
+    stroke-dashoffset: 0;
+  }
+}
+
+/* ------------------------------------------------------------------
+   Sections
+------------------------------------------------------------------- */
+.section {
+  padding-top: clamp(72px, 12vh, 132px);
+}
+
+.h2 {
+  margin: 0 0 18px;
+  font-variation-settings: "wdth" 125;
+  font-weight: 800;
+  text-transform: uppercase;
+  font-size: clamp(30px, 4.4vw, 56px);
+  line-height: 0.98;
+  letter-spacing: -0.008em;
+}
+
+.lede {
+  max-width: 58ch;
+  margin: 0 0 44px;
+  color: var(--muted);
+  font-size: 17px;
+}
+
+/* ------------------------------------------------------------------
+   Capability cards — instrument panels with scrubbed demos
+------------------------------------------------------------------- */
+.cards {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 18px;
+}
+
+.card {
+  background: var(--paper-high);
+  border: 1px solid var(--hair);
+  border-radius: 10px;
+  padding: 20px 20px 22px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.card-label {
+  font-family: var(--mono);
+  font-size: 9.5px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--muted);
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.card-label i {
+  font-style: normal;
+  color: var(--red);
+}
+
+.card h3 {
+  margin: 0;
+  font-size: 21px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+
+.card p {
+  margin: 0;
+  color: var(--muted);
+  font-size: 15px;
+  line-height: 1.55;
+}
+
+.demo {
+  margin-top: auto;
+  border: 1px solid var(--hair-soft);
+  border-radius: 7px;
+  background: var(--paper);
+  overflow: hidden;
+}
+
+.demo svg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+
+/* Code demo (card + band) */
+.code {
+  font-family: var(--mono);
+  font-size: 11.5px;
+  line-height: 1.75;
+  letter-spacing: 0;
+  padding: 14px 16px;
+  margin: 0;
+  overflow-x: auto;
+  white-space: pre;
+}
+
+.code .ln {
+  display: block;
+}
+
+.code .c-dim {
+  color: var(--muted);
+}
+
+.code .c-red {
+  color: var(--red);
+}
+
+.code .c-amb {
+  color: #a8842c;
+}
+
+.code .c-cyn {
+  color: #2a8fa2;
+}
+
+/* armed = JS + motion OK: lines hide until the playhead compiles them */
+.armed .ln {
+  opacity: 0;
+  transform: translateY(6px);
+  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.3, 1.15);
+}
+
+.armed .ln.on {
+  opacity: 1;
+  transform: none;
+}
+
+/* ------------------------------------------------------------------
+   Export band — chrome material, terminal output
+------------------------------------------------------------------- */
+.band {
+  margin-top: clamp(80px, 13vh, 140px);
+  background: var(--chrome);
+  color: var(--chrome-ink);
+  border-block: 1px solid var(--chrome-line);
+  padding-block: clamp(64px, 9vh, 110px);
+}
+
+.band .eyebrow {
+  color: var(--chrome-mut);
+}
+
+.band .eyebrow .tc-range {
+  color: var(--red-hi);
+}
+
+.band-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
+  gap: clamp(28px, 4vw, 64px);
+  align-items: start;
+}
+
+.band .h2 {
+  color: var(--chrome-ink);
+}
+
+.band .lede {
+  color: var(--chrome-mut);
+  margin-bottom: 26px;
+}
+
+.band-stats {
+  display: flex;
+  gap: 28px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  font-family: var(--mono);
+  font-size: 10.5px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--chrome-mut);
+}
+
+.band-stats b {
+  display: block;
+  font-size: 20px;
+  letter-spacing: 0;
+  color: var(--chrome-ink);
+  font-weight: 500;
+  margin-bottom: 4px;
+}
+
+.band-stats .hot {
+  color: var(--red-hi);
+}
+
+.terminal {
+  background: var(--chrome-deep);
+  border: 1px solid var(--chrome-line);
+  border-radius: 10px;
+  overflow: hidden;
+}
+
+.term-bar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 14px;
+  border-bottom: 1px solid var(--chrome-line);
+  font-family: var(--mono);
+  font-size: 9.5px;
+  letter-spacing: 0.12em;
+  color: var(--chrome-mut);
+  text-transform: uppercase;
+}
+
+.term-bar::before {
+  content: "";
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--red-hi);
+}
+
+.terminal .code {
+  font-size: 12px;
+  padding: 18px 20px 22px;
+  color: #c8cdc9;
+}
+
+.terminal .c-ok {
+  color: var(--cyan);
+}
+
+.terminal .c-amb {
+  color: var(--amber);
+}
+
+.terminal .c-red {
+  color: var(--red-hi);
+}
+
+.terminal .c-dim {
+  color: #6b7076;
+}
+
+/* ------------------------------------------------------------------
+   Access / footer
+------------------------------------------------------------------- */
+.access .h2 {
+  max-width: 17ch;
+}
+
+.access-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 20px;
+  margin-top: 36px;
+}
+
+.access-alt {
+  font-family: var(--mono);
+  font-size: 11px;
+  letter-spacing: 0.08em;
+  color: var(--muted);
+}
+
+.access-alt a {
+  color: var(--red);
+  text-underline-offset: 3px;
+}
+
+.site-foot {
+  margin-top: clamp(72px, 11vh, 120px);
+  border-top: 1px solid var(--hair);
+  padding-top: 26px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px 32px;
+  justify-content: space-between;
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.site-foot .jkl b {
+  color: var(--ink);
+  font-weight: 500;
+  border: 1px solid var(--hair);
+  border-radius: 3px;
+  padding: 1px 4px;
+  background: var(--paper-high);
+}
+
+/* ------------------------------------------------------------------
+   THE DOCK — this page is a Meridian composition
+------------------------------------------------------------------- */
+html.js .dock {
+  display: grid;
+}
+
+html.js .sweep {
+  display: block;
+}
+
+.dock {
+  position: fixed;
+  inset-inline: 0;
+  bottom: 0;
+  z-index: 60;
+  height: var(--dock-h);
+  grid-template-columns: 246px minmax(0, 1fr);
+  background: var(--chrome);
+  border-top: 1px solid var(--chrome-line);
+  color: var(--chrome-ink);
+  box-shadow: 0 -12px 32px rgba(10, 11, 13, 0.18);
+}
+
+.dock-side {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 7px;
+  padding: 10px 16px;
+  border-right: 1px solid var(--chrome-line);
+  min-width: 0;
+}
+
+.transport {
+  display: flex;
+  gap: 6px;
+}
+
+.t-btn {
+  width: 30px;
+  height: 26px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--chrome-2);
+  border: 1px solid var(--chrome-line);
+  border-radius: 5px;
+  color: var(--chrome-ink);
+  cursor: pointer;
+  padding: 0;
+}
+
+.t-btn:hover {
+  border-color: var(--cyan);
+  color: var(--cyan);
+}
+
+.t-btn svg {
+  display: block;
+}
+
+.t-play {
+  color: var(--red-hi);
+}
+
+.tc {
+  font-family: var(--mono);
+  font-size: 16px;
+  font-weight: 500;
+  letter-spacing: 0.05em;
+  color: var(--red-hi);
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+}
+
+.dock-meta {
+  font-family: var(--mono);
+  font-size: 8.5px;
+  letter-spacing: 0.08em;
+  color: var(--chrome-mut);
+  line-height: 1.5;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.dock-main {
+  display: flex;
+  min-width: 0;
+}
+
+.dock-gut {
+  flex: none;
+  width: 32px;
+  display: flex;
+  flex-direction: column;
+  border-right: 1px solid var(--chrome-line);
+}
+
+.dock-gut .g {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-family: var(--mono);
+  font-size: 7.5px;
+  letter-spacing: 0.1em;
+  color: var(--chrome-mut);
+}
+
+.g-ruler {
+  height: 26px;
+  border-bottom: 1px solid var(--chrome-line);
+}
+
+.g-marks {
+  height: 15px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
+}
+
+.g-clips {
+  height: 40px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
+}
+
+.g-audio {
+  height: 17px;
+}
+
+.dock-tl {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+}
+
+.lane {
+  position: relative;
+}
+
+.ruler {
+  height: 26px;
+  border-bottom: 1px solid var(--chrome-line);
+  cursor: col-resize;
+  touch-action: none;
+  overflow: hidden;
+}
+
+.ruler:focus-visible {
+  outline-offset: -2px;
+}
+
+.tick-label {
+  position: absolute;
+  bottom: 4px;
+  transform: translateX(4px);
+  font-family: var(--mono);
+  font-size: 8px;
+  letter-spacing: 0.06em;
+  color: var(--chrome-mut);
+  pointer-events: none;
+}
+
+.track {
+  border-bottom: 1px solid rgba(255, 255, 255, 0.045);
+}
+
+.t-marks {
+  height: 15px;
+}
+
+.t-clips {
+  height: 40px;
+}
+
+.t-audio {
+  height: 17px;
+  border-bottom: 0;
+}
+
+.mark {
+  position: absolute;
+  top: 3px;
+  bottom: 3px;
+  border-radius: 2px;
+  background: var(--chrome-2);
+  border: 1px solid #303439;
+}
+
+.mark::before {
+  content: "";
+  position: absolute;
+  left: -2px;
+  top: 50%;
+  width: 4px;
+  height: 4px;
+  translate: 0 -50%;
+  rotate: 45deg;
+  background: var(--amber);
+}
+
+.clip {
+  position: absolute;
+  top: 5px;
+  bottom: 5px;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  padding: 0 9px;
+  border-radius: 5px;
+  background: #22252b;
+  border: 1px solid #363a41;
+  color: #ccd1d7;
+  font-family: var(--mono);
+  font-size: 8.5px;
+  letter-spacing: 0.1em;
+  white-space: nowrap;
+  overflow: hidden;
+  cursor: pointer;
+  transition: border-color 0.15s ease, background-color 0.15s ease;
+}
+
+.clip:hover {
+  border-color: var(--cyan);
+  color: #fff;
+}
+
+.clip[data-active="true"] {
+  background: #2b2f36;
+  border-color: var(--red-hi);
+  color: #fff;
+}
+
+.clip .kf {
+  flex: none;
+  width: 5px;
+  height: 5px;
+  rotate: 45deg;
+  background: var(--amber);
+}
+
+.aline {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 50%;
+  height: 1px;
+  background: #2e3238;
+}
+
+.aname {
+  position: absolute;
+  right: 8px;
+  top: 50%;
+  translate: 0 -50%;
+  font-family: var(--mono);
+  font-size: 7.5px;
+  letter-spacing: 0.1em;
+  color: #5b6067;
+  pointer-events: none;
+}
+
+.playhead {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 0;
+  width: 1px;
+  background: var(--red-hi);
+  z-index: 5;
+  pointer-events: none;
+  will-change: transform;
+}
+
+.ph-grab {
+  position: absolute;
+  top: 0;
+  left: -5px;
+  width: 11px;
+  height: 14px;
+  background: var(--red-hi);
+  clip-path: polygon(0 0, 100% 0, 100% 60%, 50% 100%, 0 60%);
+}
+
+/* The meridian — playhead's shadow cast up through the page */
+.sweep {
+  position: fixed;
+  top: 0;
+  bottom: var(--dock-h);
+  left: 0;
+  width: 1px;
+  background: var(--red);
+  opacity: 0.16;
+  z-index: 30;
+  pointer-events: none;
+  will-change: transform;
+}
+
+/* ------------------------------------------------------------------
+   Reduced motion — the static cut. All content, no choreography.
+------------------------------------------------------------------- */
+@media (prefers-reduced-motion: reduce) {
+  .hero.play .hw,
+  .hero.play .hero-sub,
+  .hero.play .hero-ctas,
+  .hero.play .eyebrow,
+  .hero.play .fig-detail {
+    animation: none;
+  }
+
+  .hero.play .curve {
+    animation: none;
+    stroke-dasharray: none;
+    stroke-dashoffset: 0;
+  }
+
+  .armed .ln {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+
+  [data-reveal] {
+    opacity: 1 !important;
+    transform: none !important;
+  }
+
+  html.js .btn[data-play],
+  .t-play,
+  .jkl {
+    display: none;
+  }
+
+  .btn,
+  .clip {
+    transition: none;
+  }
+}
+
+/* ------------------------------------------------------------------
+   Responsive
+------------------------------------------------------------------- */
+@media (max-width: 1023px) {
+  .sweep {
+    display: none !important;
+  }
+
+  .band-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 860px) {
+  .cards {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .card {
+    max-width: 560px;
   }
 }
 
-* { box-sizing: border-box; }
-html { background: var(--background); color: var(--foreground); }
-body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
-a { color: inherit; }
-button, input { font: inherit; }
+@media (max-width: 720px) {
+  :root {
+    --dock-h: 56px;
+  }
+
+  body {
+    font-size: 15.5px;
+  }
+
+  .dock {
+    grid-template-columns: auto minmax(0, 1fr);
+    align-items: stretch;
+    padding-bottom: env(safe-area-inset-bottom);
+    height: calc(var(--dock-h) + env(safe-area-inset-bottom));
+  }
+
+  .dock-side {
+    flex-direction: row;
+    align-items: center;
+    gap: 10px;
+    padding: 0 12px;
+  }
+
+  .transport {
+    gap: 4px;
+  }
+
+  .t-btn {
+    width: 26px;
+    height: 24px;
+  }
+
+  .tc {
+    font-size: 11px;
+  }
+
+  .dock-meta,
+  .t-marks,
+  .t-audio,
+  .dock-gut {
+    display: none;
+  }
+
+  .ruler {
+    height: 22px;
+  }
+
+  .t-clips {
+    height: calc(var(--dock-h) - 23px);
+    border-bottom: 0;
+  }
+
+  .clip {
+    font-size: 7.5px;
+    padding: 0 6px;
+    gap: 5px;
+  }
+
+  .eyebrow .tc-range {
+    display: none;
+  }
+
+  .site-foot {
+    flex-direction: column;
+    gap: 10px;
+  }
+}
