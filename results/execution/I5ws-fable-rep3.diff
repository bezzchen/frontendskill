+              }`}
+            >
+              {label}
+            </button>
+          ))}
+        </div>
+
+        <div role="group" aria-label="Filter by discipline" className="flex flex-wrap gap-2">
+          <button
+            type="button"
+            aria-pressed={filter === null}
+            onClick={() => setFilter(null)}
+            className={`rounded-full border px-3 py-1 text-sm ${
