index 0000000..b96a1b2
--- /dev/null
+++ b/app/lib/engine.js
@@ -0,0 +1,96 @@
+/*
+ * Meridian micro-engine — the keyframe sampler that drives the hero.
+ *
+ * Deliberately dependency-free: the launch page's thesis is frame-level
+ * precision, and a 2 kB bespoke sampler keeps a single owner for every
+ * transform on the page (no second animation engine to fight with).
+ */
+
+export const FPS = 60;
+export const DUR = 6; // seconds — 360 frames
+
+/* Standard cubic-bezier(x1, y1, x2, y2) solver: Newton-Raphson with a
+   bisection fallback. Same contract as CSS easing functions. */
+export function cubicBezier(p1x, p1y, p2x, p2y) {
+  const cx = 3 * p1x;
+  const bx = 3 * (p2x - p1x) - cx;
+  const ax = 1 - cx - bx;
+  const cy = 3 * p1y;
+  const by = 3 * (p2y - p1y) - cy;
+  const ay = 1 - cy - by;
+  const sampleX = (t) => ((ax * t + bx) * t + cx) * t;
+  const sampleY = (t) => ((ay * t + by) * t + cy) * t;
+  const sampleDX = (t) => (3 * ax * t + 2 * bx) * t + cx;
+  return (x) => {
+    if (x <= 0) return 0;
+    if (x >= 1) return 1;
+    let t = x;
+    for (let i = 0; i < 6; i++) {
+      const err = sampleX(t) - x;
+      if (Math.abs(err) < 1e-5) return sampleY(t);
+      const d = sampleDX(t);
+      if (Math.abs(d) < 1e-6) break;
+      t -= err / d;
+    }
+    let lo = 0;
+    let hi = 1;
+    for (let i = 0; i < 22; i++) {
+      t = (lo + hi) / 2;
+      if (sampleX(t) < x) lo = t;
+      else hi = t;
+    }
+    return sampleY(t);
+  };
+}
+
+export const EASE = {
+  linear: (u) => u,
+  outQuint: cubicBezier(0.22, 1, 0.36, 1),
+  outExpo: cubicBezier(0.16, 1, 0.3, 1),
+  inOutCubic: cubicBezier(0.65, 0, 0.35, 1),
+  outBack: cubicBezier(0.34, 1.56, 0.64, 1),
+};
+
+/* Sample one channel: kfs = [{ t, v, e? }] sorted by t.
+   The ease named on a keyframe shapes the segment arriving at it. */
+export function sample(kfs, t) {
+  const n = kfs.length;
+  if (t <= kfs[0].t) return kfs[0].v;
+  if (t >= kfs[n - 1].t) return kfs[n - 1].v;
+  let i = 0;
+  while (i < n - 2 && t >= kfs[i + 1].t) i++;
+  const a = kfs[i];
+  const b = kfs[i + 1];
+  const u = (t - a.t) / (b.t - a.t);
+  const e = b.e ? EASE[b.e] : EASE.linear;
+  return a.v + (b.v - a.v) * e(u);
+}
+
+/* SMPTE-style timecode: HH:MM:SS:FF at 60 fps. */
+export function smpte(t) {
+  const f = Math.max(0, Math.round(t * FPS));
+  const ff = f % FPS;
+  const s = Math.floor(f / FPS);
+  const ss = s % 60;
+  const m = Math.floor(s / 60);
+  const pad = (x) => String(x).padStart(2, "0");
+  return `00:${pad(m)}:${pad(ss)}:${pad(ff)}`;
+}
+
+/* Tiny clock bus so detached chrome (the app-bar timecode chip) can watch
+   the hero's transport without prop-drilling or per-frame React renders. */
+export const clock = {
+  t: DUR,
+  playing: false,
+  listeners: new Set(),
+  publish(t, playing) {
+    this.t = t;
+    this.playing = playing;
+    for (const fn of this.listeners) fn(t, playing);
+  },
+  subscribe(fn) {
+    this.listeners.add(fn);
+    fn(this.t, this.playing);
+    return () => this.listeners.delete(fn);
+  },
+};
