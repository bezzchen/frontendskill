// Damped harmonic oscillator released from unit displacement at rest.
export function springParams({ stiffness, damping, mass = 1 }) {
  const omega0 = Math.sqrt(stiffness / mass);
  const zeta = damping / (2 * Math.sqrt(stiffness * mass));
  let settle;
  if (zeta < 1) settle = 4.6 / (zeta * omega0);
  else settle = 4.6 / (omega0 * (zeta - Math.sqrt(Math.max(zeta * zeta - 1, 0)) || 1e-6));
  const overshoot = zeta < 1 ? Math.exp((-zeta * Math.PI) / Math.sqrt(1 - zeta * zeta)) : 0;
  return { omega0, zeta, settle, overshoot };
}

export function springResponse(t, { omega0, zeta }) {
  if (t <= 0) return 1;
  if (zeta < 1) {
    const wd = omega0 * Math.sqrt(1 - zeta * zeta);
    return Math.exp(-zeta * omega0 * t) * (Math.cos(wd * t) + ((zeta * omega0) / wd) * Math.sin(wd * t));
  }
  if (Math.abs(zeta - 1) < 1e-6) return Math.exp(-omega0 * t) * (1 + omega0 * t);
  const root = Math.sqrt(zeta * zeta - 1);
  const s1 = -omega0 * (zeta - root);
  const s2 = -omega0 * (zeta + root);
  const A = -s2 / (s1 - s2);
  const B = s1 / (s1 - s2);
  return A * Math.exp(s1 * t) + B * Math.exp(s2 * t);
}

