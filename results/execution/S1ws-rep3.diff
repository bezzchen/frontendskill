+  font-size: 0.9375rem;
+  color: var(--color-ice);
+  margin-top: 1.25rem;
+}
+.readout code { font: inherit; }
+
+/* ---------- chrome ---------- */
+
+.site-header {
+  position: fixed;
+  inset: 0 0 auto 0;
+  z-index: 30;
+  height: 64px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 var(--gutter);
+  pointer-events: none;
+  background: linear-gradient(to bottom, var(--color-ground) 0%, color-mix(in srgb, var(--color-ground) 80%, transparent) 55%, transparent 100%);
+}
+.site-header > * { pointer-events: auto; }
+
+.wordmark {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.6rem;
+  font-weight: 500;
+  font-size: 1.125rem;
+  letter-spacing: -0.01em;
+  text-decoration: none;
+  margin: 0;
+}
+.wordmark::before {
+  content: "";
+  width: 2px;
+  height: 1.05em;
+  background: var(--color-amber);
+  border-radius: 1px;
+}
+.wordmark--large { font-size: 2rem; }
+
+.header-cta {
+  font-size: 0.9375rem;
+  text-decoration: none;
+  padding: 0.5rem 0.95rem;
+  border: 1px solid var(--color-rule);
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--color-ground) 75%, transparent);
+}
+.header-cta:hover { border-color: var(--color-slate); }
+
+/* ---------- stage + acts ---------- */
+
+.composition { position: relative; }
+
+.stage {
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  height: 100dvh;
+  z-index: 0;
+  overflow: hidden;
+}
+.stage__canvas {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  display: block;
+  opacity: 0;
+  transition: opacity 1.4s ease;
+}
+.stage__canvas[data-ready] { opacity: 1; }
+
+.acts {
+  position: relative;
+  z-index: 1;
+  margin-top: -100vh;
+  margin-top: -100dvh;
+}
+
+.act {
+  position: relative;
+  min-height: 100vh;
+  min-height: 100dvh;
+  display: grid;
+  grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
+  column-gap: clamp(2rem, 6vw, 6rem);
+  row-gap: 2.5rem;
+  align-items: center;
+  padding: 7rem var(--gutter) calc(var(--hud-h) + 4rem);
+}
+.act--hold { min-height: 130vh; min-height: 130dvh; }
+.act--export { min-height: 125vh; min-height: 125dvh; }
+.act--release { min-height: 110vh; min-height: 110dvh; }
+
+.act--overture {
+  grid-template-columns: minmax(0, 1fr);
+  align-content: center;
+  row-gap: 3.5rem;
+}
+
+.act__text { max-width: var(--measure); }
+.act__text--wide { max-width: 46rem; }
+
+.act__marker {
+  display: flex;
+  gap: 0.9rem;
+  align-items: baseline;
+  margin: 0 0 1.5rem;
+  font-size: 0.9375rem;
+  color: var(--color-slate);
+}
+.act__marker[aria-current] .act__numeral { color: var(--color-amber); }
+.act__numeral { font-weight: 500; }
+.act__time { font-family: var(--font-mono); font-size: 0.875rem; }
+
+/* Instruments: the DOM elements the field forms on. */
+.instrument {
+  position: relative;
+  width: min(100%, 34rem);
+  justify-self: center;
+}
+.instrument--ruler {
+  grid-column: 1 / -1;
+  width: 100%;
+  height: 180px;
+  justify-self: stretch;
+}
+.instrument--lattice {
+  aspect-ratio: 5 / 4;
+  touch-action: pan-y;
+  cursor: grab;
+}
+.instrument--lattice:active { cursor: grabbing; }
+.instrument--code { width: min(100%, 36rem); min-width: 0; }
+.instrument--globe {
+  aspect-ratio: 1;
+  cursor: grab;
+  touch-action: pan-y;
+}
+.instrument--globe:active { cursor: grabbing; }
+
+/* Vector fallbacks, only when WebGL2 is unavailable. */
+.fallback { display: none; width: 100%; height: 100%; }
+[data-renderer="none"] .fallback { display: block; }
+.fallback line, .fallback circle, .fallback ellipse {
+  stroke: var(--color-ice);
+  stroke-width: 1;
+  fill: none;
+  vector-effect: non-scaling-stroke;
+  opacity: 0.7;
+}
+.fallback .fallback__head, .fallback .fallback__prime { stroke: var(--color-amber); stroke-width: 2; opacity: 1; }
+
+/* ---------- easing editor ---------- */
+
+.editor {
+  width: min(100%, 24rem);
+  justify-self: center;
+  padding: 32% 0;
+}
+.editor__plot { position: relative; aspect-ratio: 1; }
+.editor__svg {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.editor__svg line, .editor__svg path, .editor__svg rect {
+  vector-effect: non-scaling-stroke;
+  fill: none;
+}
+.editor__grid line { stroke: var(--color-rule); stroke-width: 1; }
+.editor__frame { stroke: var(--color-slate); stroke-width: 1; opacity: 0.6; }
+.editor__linear { stroke: var(--color-slate); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.6; }
+.editor__arm { stroke: var(--color-amber); stroke-width: 1; opacity: 0.7; }
+.editor__curve { stroke: var(--color-ice); stroke-width: 1.5; opacity: 0.95; }
+.editor__handle {
+  position: absolute;
+  width: 22px;
+  height: 22px;
+  margin: 0;
+  padding: 0;
+  border-radius: 50%;
+  border: 2px solid var(--color-ground);
+  background: var(--color-amber);
+  transform: translate(-50%, -50%);
+  cursor: grab;
+  touch-action: none;
+}
+.editor__handle:active { cursor: grabbing; }
+
+/* ---------- controls ---------- */
+
+.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.5rem 0 0; }
+.chip {
+  padding: 0.45rem 0.9rem;
+  border-radius: 999px;
+  border: 1px solid var(--color-rule);
+  background: transparent;
+  cursor: pointer;
+  font-size: 0.9375rem;
