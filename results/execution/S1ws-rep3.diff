+  transition: border-color 160ms ease, color 160ms ease;
+}
+.chip:hover { border-color: var(--color-slate); }
+.chip[aria-pressed="true"] { border-color: var(--color-amber); color: var(--color-amber); }
+.chip--action { border-color: var(--color-ice); color: var(--color-ice); }
+.chip--small { padding: 0.3rem 0.7rem; font-size: 0.8125rem; }
+
+.controls { display: grid; gap: 0.9rem; margin: 0.75rem 0 0; }
+.slider {
+  display: grid;
+  grid-template-columns: 6rem 1fr 3rem;
+  align-items: center;
+  gap: 0.9rem;
+}
+.slider__name { font-size: 0.9375rem; }
+.slider__value { font-family: var(--font-mono); font-size: 0.875rem; text-align: right; color: var(--color-ice); }
+
+input[type="range"] {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 100%;
+  height: 24px;
+  margin: 0;
+  background: transparent;
+  cursor: pointer;
+}
+input[type="range"]::-webkit-slider-runnable-track { height: 2px; background: var(--color-rule); }
+input[type="range"]::-moz-range-track { height: 2px; background: var(--color-rule); }
+input[type="range"]::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 16px;
+  height: 16px;
+  margin-top: -7px;
+  border-radius: 50%;
+  background: var(--color-amber);
+  border: 2px solid var(--color-ground);
+}
+input[type="range"]::-moz-range-thumb {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: var(--color-amber);
+  border: 2px solid var(--color-ground);
+}
+
+.spring-plot { margin: 1.25rem 0 0; width: 100%; max-width: 26rem; }
+.spring-plot svg { display: block; width: 100%; height: 5rem; overflow: visible; }
+.spring-plot__axis { stroke: var(--color-rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
+.spring-plot__line { stroke: var(--color-ice); stroke-width: 1.5; fill: none; vector-effect: non-scaling-stroke; }
+.spring-plot figcaption {
+  display: flex;
+  justify-content: space-between;
+  font-family: var(--font-mono);
+  font-size: 0.75rem;
+  color: var(--color-slate);
+  margin-top: 0.35rem;
+}
+
+/* ---------- code ---------- */
+
+.code {
+  min-width: 0;
+  border: 1px solid var(--color-rule);
+  border-radius: 6px;
+  background: color-mix(in srgb, var(--color-panel) 55%, transparent);
+  font-family: var(--font-mono);
+  font-size: 0.875rem;
+  line-height: 1.65;
+  overflow: hidden;
+}
+.code__bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0.5rem 1rem;
+  border-top: 1px solid var(--color-rule);
+  border-bottom: 1px solid var(--color-rule);
+  color: var(--color-slate);
+  font-size: 0.8125rem;
+}
+.code__bar:first-child { border-top: 0; }
+.code__pre {
+  margin: 0;
+  padding: 1rem 1.1rem 1.2rem;
+  overflow-x: auto;
+  opacity: var(--arrive, 1);
+  color: var(--color-bone);
+}
+.tok-sel { color: var(--color-bone); }
+.tok-prop { color: var(--color-slate); }
+.tok-val { color: var(--color-bone); }
+.tok-at { color: var(--color-slate); }
+.tok-fn { color: var(--color-ice); }
+.tok-str { color: var(--color-ice); }
+.tok-live { color: var(--color-amber); }
+.tok-cm { color: var(--color-slate); font-style: italic; }
+
+/* ---------- release ---------- */
+
+.cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.25rem; margin-top: 1.5rem; }
+.cta {
+  display: inline-block;
+  padding: 0.8rem 1.4rem;
+  border-radius: 999px;
+  background: var(--color-bone);
+  color: var(--color-ground);
+  text-decoration: none;
+  font-weight: 500;
+}
+.cta:hover { background: #ffffff; }
+
+/* ---------- end slate ---------- */
+
+.end-slate {
+  position: relative;
+  z-index: 1;
+  min-height: 100vh;
+  min-height: 100dvh;
+  display: grid;
+  align-content: center;
+  padding: 6rem var(--gutter) calc(var(--hud-h) + 4rem);
+  background: var(--color-ground);
+  border-top: 1px solid var(--color-rule);
+}
+.end-slate__inner { max-width: 44rem; }
+.facts {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
+  gap: 1.5rem 2rem;
+  margin: 2.5rem 0;
+}
+.facts dt { color: var(--color-slate); font-size: 0.875rem; margin-bottom: 0.25rem; }
+.facts dd { margin: 0; font-family: var(--font-mono); font-size: 0.9375rem; }
+
+/* ---------- HUD timeline ---------- */
+
+.hud {
+  position: fixed;
+  inset: auto 0 0 0;
+  z-index: 30;
+  height: var(--hud-h);
+  display: grid;
+  grid-template-columns: 13rem minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 1.5rem;
+  padding: 0 var(--gutter);
+  background: color-mix(in srgb, var(--color-panel) 92%, transparent);
+  border-top: 1px solid var(--color-rule);
+  backdrop-filter: blur(6px);
+}
+.hud__time { display: flex; flex-direction: column; line-height: 1.2; }
+.hud__tc { font-family: var(--font-mono); font-size: 0.9375rem; color: var(--color-amber); }
+.hud__act { font-size: 0.8125rem; color: var(--color-slate); }
+
+.hud__ruler {
+  position: relative;
+  height: 40px;
+  align-self: center;
+}
+.hud__range {
+  position: absolute;
+  inset: 0;
+  height: 100%;
+  z-index: 2;
+}
+.hud__range::-webkit-slider-runnable-track {
+  height: 14px;
+  background:
+    repeating-linear-gradient(90deg, var(--color-rule) 0 1px, transparent 1px 2.0833333%) 0 100% / 100% 6px no-repeat,
+    linear-gradient(var(--color-rule), var(--color-rule)) 0 100% / 100% 1px no-repeat;
+}
+.hud__range::-moz-range-track {
+  height: 14px;
+  background:
+    repeating-linear-gradient(90deg, var(--color-rule) 0 1px, transparent 1px 2.0833333%) 0 100% / 100% 6px no-repeat,
+    linear-gradient(var(--color-rule), var(--color-rule)) 0 100% / 100% 1px no-repeat;
+}
+.hud__range::-webkit-slider-thumb {
+  width: 24px;
+  height: 40px;
+  margin-top: -13px;
+  border-radius: 0;
+  background: transparent;
+  border: 0;
+}
+.hud__range::-moz-range-thumb {
+  width: 24px;
+  height: 40px;
+  border-radius: 0;
+  background: transparent;
+  border: 0;
+}
+.hud__head {
+  position: absolute;
+  top: 2px;
+  bottom: 6px;
+  left: 0;
+  width: 2px;
+  margin-left: -1px;
+  background: var(--color-amber);
+  pointer-events: none;
+  z-index: 3;
+}
+.hud__head::before {
+  content: "";
+  position: absolute;
+  top: -2px;
+  left: -5px;
+  border: 6px solid transparent;
+  border-top: 7px solid var(--color-amber);
+  border-bottom: 0;
+}
+.hud__markers {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+.hud__marker {
+  position: absolute;
+  bottom: 2px;
+  transform: translateX(-50%);
+  pointer-events: auto;
+  z-index: 4;
+}
+.hud__marker-button {
+  position: relative;
+  width: 14px;
+  height: 14px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  cursor: pointer;
+}
+.hud__marker-button::before {
+  content: "";
+  position: absolute;
+  left: 3px;
+  top: 3px;
+  width: 8px;
+  height: 8px;
+  background: var(--color-slate);
+  transform: rotate(45deg);
+  transition: background-color 160ms ease;
+}
+.hud__marker[data-current] .hud__marker-button::before { background: var(--color-amber); }
+.hud__marker-name {
+  position: absolute;
+  bottom: 18px;
+  left: 50%;
+  transform: translateX(-50%);
+  white-space: nowrap;
+  font-size: 0.75rem;
+  color: var(--color-slate);
+  opacity: 0;
+  transition: opacity 160ms ease;
+}
+.hud__marker-button:hover .hud__marker-name,
+.hud__marker-button:focus-visible .hud__marker-name,
+.hud__marker[data-current] .hud__marker-name { opacity: 1; }
+.hud__marker[data-current] .hud__marker-name { color: var(--color-bone); }
+
+.hud__motion {
+  padding: 0.4rem 0.8rem;
+  border-radius: 999px;
+  border: 1px solid var(--color-rule);
+  background: transparent;
+  font-size: 0.8125rem;
+  color: var(--color-slate);
+  cursor: pointer;
+  white-space: nowrap;
+}
+.hud__motion:hover { border-color: var(--color-slate); color: var(--color-bone); }
+
+/* ---------- reduced motion ---------- */
+
+@media (prefers-reduced-motion: reduce) {
+  .stage__canvas { transition: none; }
+  .chip, .hud__marker-button::before, .hud__marker-name { transition: none; }
+}
+[data-motion="reduced"] .stage__canvas { transition: none; }
+[data-motion="reduced"] .chip,
+[data-motion="reduced"] .hud__marker-button::before,
+[data-motion="reduced"] .hud__marker-name { transition: none; }
+[data-motion="reduced"] .code__pre { opacity: 1; }
+[data-motion="reduced"] .instrument--lattice,
+[data-motion="reduced"] .instrument--globe { cursor: default; }
+
+/* ---------- mobile recipe ---------- */
+
+@media (max-width: 899px) {
+  :root { --hud-h: 60px; }
+  .act {
+    grid-template-columns: minmax(0, 1fr);
+    row-gap: 2rem;
+    padding-top: 6rem;
+    align-content: center;
+  }
+  .act--hold, .act--export, .act--release { min-height: 100vh; min-height: 100dvh; }
+  .instrument { justify-self: start; }
+  .instrument--ruler { height: 140px; }
+  .editor { width: min(100%, 20rem); justify-self: start; padding: 32% 0; }
+  .lede { font-size: 1.125rem; }
+  .hud {
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    gap: 0.9rem;
+  }
+  .hud__act-name { display: none; }
+  .hud__marker-name { display: none; }
+  .header-cta { display: none; }
+  .slider { grid-template-columns: 5rem 1fr 2.5rem; }
+}
+@media (max-width: 480px) {
+  .code__pre { white-space: pre-wrap; overflow-wrap: anywhere; }
+  .hud__motion { padding: 0.35rem 0.6rem; font-size: 0.75rem; }
+  .hud__time { min-width: 5.5rem; }
+}
