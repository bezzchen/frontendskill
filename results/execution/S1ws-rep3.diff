+  vec3 la = formation(uA, s, t, sa, aa, ha, oa);
+  vec3 lb = formation(uB, s, t, sb, ab, hb, ob);
+  vec3 wa = toWorld(la, uRect[uA]);
+  vec3 wb = toWorld(lb, uRect[uB]);
