+// Motion math shared by the UI, the exported-code block and the GPU field.
+// The shader re-implements the same cubic-bezier solve and spring response so
+// what the visitor sees on screen is exactly what the code block describes.
+
+export function cubicBezier(x1, y1, x2, y2) {
+  const cx = 3 * x1;
+  const bx = 3 * (x2 - x1) - cx;
+  const ax = 1 - cx - bx;
+  const cy = 3 * y1;
+  const by = 3 * (y2 - y1) - cy;
+  const ay = 1 - cy - by;
+  const sampleX = (t) => ((ax * t + bx) * t + cx) * t;
+  const sampleY = (t) => ((ay * t + by) * t + cy) * t;
+  const sampleDX = (t) => (3 * ax * t + 2 * bx) * t + cx;
+
+  function solveT(x) {
+    let t = x;
+    for (let i = 0; i < 8; i++) {
+      const dx = sampleDX(t);
+      if (Math.abs(dx) < 1e-6) break;
+      const err = sampleX(t) - x;
+      if (Math.abs(err) < 1e-6) return t;
+      t = Math.min(1, Math.max(0, t - err / dx));
+    }
+    let lo = 0;
+    let hi = 1;
+    for (let i = 0; i < 24; i++) {
+      t = (lo + hi) / 2;
+      if (sampleX(t) < x) lo = t;
+      else hi = t;
+    }
+    return t;
+  }
+
+  return (x) => (x <= 0 ? 0 : x >= 1 ? 1 : sampleY(solveT(x)));
+}
+
+export function formatBezier([x1, y1, x2, y2]) {
+  const f = (v) => (Math.abs(v) < 0.005 ? "0.00" : v.toFixed(2));
+  return `cubic-bezier(${f(x1)}, ${f(y1)}, ${f(x2)}, ${f(y2)})`;
+}
+
+export const EASING_PRESETS = [
+  { name: "Ease out", value: [0.32, 0, 0.18, 1] },
+  { name: "Ease in-out", value: [0.65, 0, 0.35, 1] },
+  { name: "Anticipate", value: [0.36, -0.3, 0.26, 1] },
+  { name: "Overshoot", value: [0.34, 1.3, 0.64, 1] },
+  { name: "Linear", value: [0, 0, 1, 1] },
+];
+
+export const SPRING_LIMITS = {
+  stiffness: { min: 40, max: 400, step: 5 },
+  damping: { min: 2, max: 40, step: 1 },
+};
+
+// Damped harmonic oscillator released from unit displacement at rest.
+export function springParams({ stiffness, damping, mass = 1 }) {
+  const omega0 = Math.sqrt(stiffness / mass);
+  const zeta = damping / (2 * Math.sqrt(stiffness * mass));
+  let settle;
+  if (zeta < 1) settle = 4.6 / (zeta * omega0);
+  else settle = 4.6 / (omega0 * (zeta - Math.sqrt(Math.max(zeta * zeta - 1, 0)) || 1e-6));
+  const overshoot = zeta < 1 ? Math.exp((-zeta * Math.PI) / Math.sqrt(1 - zeta * zeta)) : 0;
+  return { omega0, zeta, settle, overshoot };
+}
+
+export function springResponse(t, { omega0, zeta }) {
+  if (t <= 0) return 1;
+  if (zeta < 1) {
+    const wd = omega0 * Math.sqrt(1 - zeta * zeta);
+    return Math.exp(-zeta * omega0 * t) * (Math.cos(wd * t) + ((zeta * omega0) / wd) * Math.sin(wd * t));
+  }
+  if (Math.abs(zeta - 1) < 1e-6) return Math.exp(-omega0 * t) * (1 + omega0 * t);
+  const root = Math.sqrt(zeta * zeta - 1);
+  const s1 = -omega0 * (zeta - root);
+  const s2 = -omega0 * (zeta + root);
+  const A = -s2 / (s1 - s2);
+  const B = s1 / (s1 - s2);
+  return A * Math.exp(s1 * t) + B * Math.exp(s2 * t);
+}
+
+export const RUNTIME_SECONDS = 48;
+export const FPS = 24;
+
+export function timecode(seconds, fps = FPS) {
+  const total = Math.max(0, Math.round(seconds * fps));
+  const f = total % fps;
+  const s = Math.floor(total / fps) % 60;
+  const m = Math.floor(total / fps / 60) % 60;
+  const h = Math.floor(total / fps / 3600);
+  const p = (n) => String(n).padStart(2, "0");
+  return `${p(h)}:${p(m)}:${p(s)}:${p(f)}`;
+}
+
+export const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);
