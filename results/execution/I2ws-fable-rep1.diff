diff --git a/app/globals.css b/app/globals.css
index 6529d42..26b4368 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -24,3 +24,103 @@ html { background: var(--background); color: var(--foreground); }
 body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
 a { color: inherit; }
 button, input { font: inherit; }
+
+/* --- Experience system ------------------------------------------------- */
+
+/* Small screens (default): a plain vertical flow; the inactive view is
+   hidden like a regular tab panel. */
+.exp-stage {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+.exp-shell[data-state="float"] { display: none; }
+.exp-ring { display: none; }
+.exp-hint-desktop { display: none; }
+.exp-hint-mobile { display: inline; }
+
+.exp-card { cursor: default; }
+.exp-card:focus-visible {
+  outline: 2px solid var(--foreground);
+  outline-offset: 2px;
+}
+
+/* While swiping between views, keep vertical scroll native on the cards. */
+@media (max-width: 63.999rem) {
+  .exp-stage [data-card] { touch-action: pan-y; }
+}
+
+/* Large screens: structured column + orbit field around the core. */
+@media (min-width: 64rem) {
+  .exp-hint-desktop { display: inline; }
+  .exp-hint-mobile { display: none; }
+
+  .exp-stage {
+    display: grid;
+    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
+    column-gap: 1.5rem;
+    row-gap: 0.75rem;
+    align-content: center;
+    min-height: 32rem;
+  }
+  .exp-shell[data-state="dock"] {
+    grid-column: 1;
+    z-index: 1;
+  }
+  .exp-shell[data-state="float"] {
+    display: block;
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 11rem;
+    z-index: 10;
+    opacity: 0; /* revealed by the entrance animation once JS places it */
+    will-change: transform;
+  }
+  .exp-core {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 12rem;
+    z-index: 2;
+    opacity: 0; /* revealed once JS centers it in the field */
+  }
+  .exp-ring {
+    display: block;
+    position: absolute;
+    top: 0;
+    left: 0;
+    z-index: 0;
+    border: 1px dashed var(--line);
+    border-radius: 50%;
+    opacity: 0;
+    pointer-events: none;
+  }
+  .exp-shell.is-grabbed { z-index: 30; }
+  .is-grabbed .exp-card { box-shadow: 0 14px 40px rgb(0 0 0 / 0.16); }
+}
+
+/* Reduced motion: drag/swipe affordances are disabled, so the hint that
+   advertises them is hidden. Content and tab controls remain untouched. */
+@media (prefers-reduced-motion: reduce) {
+  .exp-hint { display: none; }
+  .exp-system * { transition: none !important; }
+}
+
+/* No JavaScript: show every card in plain flow so nothing is lost. */
+@media (scripting: none) {
+  .exp-shell[data-state="float"] {
+    display: block;
+    position: static !important;
+    width: auto !important;
+    opacity: 1 !important;
+    transform: none !important;
+  }
+  .exp-core {
+    position: static !important;
+    width: auto !important;
+    opacity: 1 !important;
+  }
+  .exp-ring { display: none !important; }
+}
