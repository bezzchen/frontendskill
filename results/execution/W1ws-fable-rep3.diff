+  .cel-card { transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s; }
+  .cel-card:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -22px color-mix(in srgb, var(--color-ink) 35%, transparent); }
