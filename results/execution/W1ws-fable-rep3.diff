+          heldRef.current = "loop";
+          loopTweenRef.current.pause();
+        } else if (tlRef.current?.isActive()) {
+          heldRef.current = "main";
+          tlRef.current.pause();
+        } else {
+          heldRef.current = null;
+        }
+      },
+    });
