diff --git a/app/lib/governor.js b/app/lib/governor.js
new file mode 100644
index 0000000..53dd885
--- /dev/null
+++ b/app/lib/governor.js
@@ -0,0 +1,55 @@
+// Loop governor: any continuous/ambient animation registers here.
+// It is force-paused whenever its surface leaves the viewport or the
+// document is hidden, and resumed when both conditions clear.
+// State is published on window.__meridian.loops for verification.
+
+export function governLoop(id, el, { onPlay, onPause }) {
+  const s = { id, wants: false, hidden: document.hidden, offscreen: false, running: false };
+
+  const publish = () => {
+    const w = (window.__meridian ||= { loops: {} });
+    (w.loops ||= {})[id] = { ...s };
+  };
+
+  const apply = () => {
+    const ok = s.wants && !s.hidden && !s.offscreen;
+    if (ok && !s.running) {
+      s.running = true;
+      onPlay();
+    } else if (!ok && s.running) {
+      s.running = false;
+      onPause();
+    }
+    publish();
+  };
+
+  const io = new IntersectionObserver(
+    (entries) => {
+      for (const e of entries) s.offscreen = !e.isIntersecting;
+      apply();
+    },
+    { threshold: 0 }
+  );
+  io.observe(el);
+
+  const vis = () => {
+    s.hidden = document.hidden;
+    apply();
+  };
+  document.addEventListener("visibilitychange", vis);
+  publish();
+
+  return {
+    setWants(v) {
+      if (s.wants !== v) {
+        s.wants = v;
+        apply();
+      }
+    },
+    state: () => ({ ...s }),
+    dispose() {
+      io.disconnect();
+      document.removeEventListener("visibilitychange", vis);
+    },
+  };
+}
