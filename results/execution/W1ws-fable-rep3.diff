+  /* ---------- autoplay once fonts are in (skipped under reduced motion) ---------- */
+  useEffect(() => {
+    if (prmNow()) return;
+    let cancelled = false;
+    const kick = () => {
+      if (cancelled || !tlRef.current || scrubbingRef.current) return;
+      requestStart(() => tlRef.current.play(0));
