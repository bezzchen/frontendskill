new file mode 100644
index 0000000..b625b0a
--- /dev/null
+++ b/app/lib/usePrm.js
@@ -0,0 +1,23 @@
+"use client";
+import { useEffect, useState } from "react";
+
+/** Synchronous check — safe to call in effects only. */
+export function prmNow() {
+  return (
+    window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
+    document.documentElement.classList.contains("prm-force")
+  );
+}
+
+/** Reactive prefers-reduced-motion. `null` until known (client-only). */
+export function usePrm() {
+  const [prm, setPrm] = useState(null);
+  useEffect(() => {
+    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
+    const compute = () => setPrm(prmNow());
+    compute();
+    mq.addEventListener("change", compute);
+    return () => mq.removeEventListener("change", compute);
+  }, []);
+  return prm;
+}
