  const onKey = (i) => (e) => {
    const step = e.shiftKey ? 0.01 : 0.05;
    let x = bez[i * 2], y = bez[i * 2 + 1];
    switch (e.key) {
      case "ArrowLeft": x -= step; break;
      case "ArrowRight": x += step; break;
      case "ArrowUp": y += step; break;
      case "ArrowDown": y -= step; break;
      default: return;
    }
    e.preventDefault();
    update(i, x, y);
  };

