export const DEFAULT_BEZIER = [0.32, 0, 0.18, 1];
export const DEFAULT_SPRING = { stiffness: 180, damping: 14, mass: 1, v0: 0 };
export const BEZIER_PRESETS = [
  { name: "Ease out", value: [0.32, 0, 0.18, 1] },
  { name: "Ease in", value: [0.7, 0, 0.9, 0.3] },
