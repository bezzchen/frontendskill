+// Shared timeline model. Everything visual derives from master time T (seconds).
+// The GLSL in components/field/shaders.js mirrors sunElevation/sunAzimuth/skyMix exactly.
+
+export const DURATION = 50; // seconds of master timeline
+export const FPS = 30; // timecode frame rate
+
+export const ACTS = [
+  { id: "dawn", scene: "Dawn", title: "The playhead", start: 0, end: 10 },
+  { id: "morning", scene: "Morning", title: "Keyframes", start: 10, end: 20 },
+  { id: "noon", scene: "Noon", title: "Springs", start: 20, end: 30 },
+  { id: "dusk", scene: "Dusk", title: "Export", start: 30, end: 40 },
+  { id: "night", scene: "Night", title: "Early access", start: 40, end: 50 },
+];
+
+export const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
+export const lerp = (a, b, t) => a + (b - a) * t;
+export const smoothstep = (a, b, x) => {
+  const t = clamp((x - a) / (b - a), 0, 1);
+  return t * t * (3 - 2 * t);
+};
+
+// ---- Sun -------------------------------------------------------------------
+// Arc parameter s: 0 = sunrise, 0.5 = meridian (T = 25), 1 = sunset (T = 35).
+export function sunArc(T) {
+  if (T < 25) return clamp((0.5 * (T + 2)) / 27, 0, 1);
+  return clamp(0.5 + (0.5 * (T - 25)) / 10, 0, 1);
+}
+export function sunElevation(T) {
+  const s = sunArc(T);
+  let el = 1.2 * Math.sin(Math.PI * s);
+  if (T > 35) el = -0.25 * smoothstep(35, 40, T) + 0.2 * smoothstep(44, 50, T);
+  return el; // radians
+}
+export function sunAzimuth(T) {
+  return Math.PI * sunArc(T);
+}
+export function sunDirection(T) {
+  const el = sunElevation(T);
+  const az = sunAzimuth(T);
+  const x = Math.cos(az) * Math.cos(el);
+  const y = Math.sin(el);
+  const z = -Math.cos(el) * Math.sin(az) * 0.9 - 0.15;
+  const l = Math.hypot(x, y, z) || 1;
+  return [x / l, y / l, z / l];
+}
+
+// Day mix factors shared with the shaders.
+export function dayMix(T) {
+  const el = sunElevation(T);
+  const kUp = smoothstep(-0.07, 0.13, el);
+  const g = (el - 0.02) / 0.16;
+  const kGlow = Math.exp(-g * g);
+  const night = 1 - smoothstep(-0.2, 0.02, el);
+  return { el, kUp, kGlow, night };
+}
+
+// ---- Colors (hex helpers) ----------------------------------------------------
+export const hex = (h) => {
+  const n = parseInt(h.slice(1), 16);
+  return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
+};
+export const mix3 = (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
+export const toCss = (c, a = 1) =>
+  `rgba(${Math.round(clamp(c[0], 0, 1) * 255)}, ${Math.round(clamp(c[1], 0, 1) * 255)}, ${Math.round(
+    clamp(c[2], 0, 1) * 255
+  )}, ${a})`;
+
+export const PALETTE = {
+  paper: hex("#f1eee7"),
+  ink: hex("#141a2e"),
+  nightInk: hex("#0d1024"),
+  nightHorizon: hex("#1a2145"),
+  dayZenith: hex("#7f9dd6"),
+  dayHorizon: hex("#e9eef5"),
+  glowHorizon: hex("#f3b184"),
+  glowZenith: hex("#55639f"),
+  warmPaper: hex("#f0c39c"),
+  shadow: hex("#26305e"),
+  ultramarine: hex("#2c3ee6"),
+  periwinkle: hex("#8d9bff"),
+  sun: hex("#ff9f2e"),
+};
+
+// Theme snapshot for the DOM at time T (same math as the ground shader).
+export function themeAt(T) {
+  const { kUp, kGlow, night } = dayMix(T);
+  const P = PALETTE;
+  let ground = mix3(P.nightInk, P.paper, kUp);
+  ground = mix3(ground, P.warmPaper, kGlow * 0.35);
+  let horizon = mix3(P.nightHorizon, P.dayHorizon, kUp);
+  horizon = mix3(horizon, P.glowHorizon, kGlow);
+  const fg = mix3(P.ink, P.paper, night);
+  const accent = mix3(P.ultramarine, P.periwinkle, night);
+  const dir = sunDirection(T);
+  // Screen-space shadow for standing DOM objects: falls away from the sun,
+  // downward on screen, longer when the sun is low. Vanishes at night.
+  const el = Math.max(dayMix(T).el, 0.02);
+  const len = clamp(0.32 / Math.tan(el), 0.02, 1.6);
+  const shX = -dir[0] * len;
+  const shY = 0.22 * len + 0.03;
+  const shA = kUp * clamp(0.5 - len * 0.14, 0.2, 0.5) * (1 - night);
+  return { ground, horizon, fg, accent, night, kUp, kGlow, shX, shY, shA };
+}
+
+// ---- Timecode ----------------------------------------------------------------
+export function timecode(T) {
+  const total = clamp(T, 0, DURATION);
+  const s = Math.floor(total);
+  const f = Math.floor((total - s) * FPS);
+  const mm = Math.floor(s / 60);
+  const ss = s % 60;
+  const p = (n) => String(n).padStart(2, "0");
+  return `00:${p(mm)}:${p(ss)}:${p(f)}`;
+}
+
+export function actAt(T) {
+  for (let i = ACTS.length - 1; i >= 0; i--) if (T >= ACTS[i].start) return i;
+  return 0;
+}
+
+// ---- Cubic bezier easing (CSS semantics) -------------------------------------
+export function cubicBezierSolver(x1, y1, x2, y2) {
+  const ax = 3 * x1 - 3 * x2 + 1, bx = 3 * x2 - 6 * x1, cx = 3 * x1;
+  const ay = 3 * y1 - 3 * y2 + 1, by = 3 * y2 - 6 * y1, cy = 3 * y1;
+  const sx = (t) => ((ax * t + bx) * t + cx) * t;
+  const sy = (t) => ((ay * t + by) * t + cy) * t;
+  const dx = (t) => (3 * ax * t + 2 * bx) * t + cx;
+  return (x) => {
+    if (x <= 0) return 0;
+    if (x >= 1) return 1;
+    let t = x;
+    for (let i = 0; i < 8; i++) {
+      const e = sx(t) - x;
+      const d = dx(t);
+      if (Math.abs(e) < 1e-6) break;
+      if (Math.abs(d) < 1e-6) break;
+      t -= e / d;
+    }
+    if (t < 0 || t > 1 || Math.abs(sx(t) - x) > 1e-4) {
+      let lo = 0, hi = 1;
+      for (let i = 0; i < 24; i++) {
+        t = (lo + hi) / 2;
+        if (sx(t) < x) lo = t; else hi = t;
+      }
+    }
+    return sy(t);
+  };
+}
+export function easeLUT(bez, n = 256) {
+  const f = cubicBezierSolver(bez[0], bez[1], bez[2], bez[3]);
+  const out = new Float32Array(n);
+  for (let i = 0; i < n; i++) out[i] = f(i / (n - 1));
+  return out;
+}
+export const fmt = (v, d = 2) => {
+  const s = Number(v).toFixed(d);
+  if (!s.includes(".")) return s;
+  const t = s.replace(/\.?0+$/, "");
+  return t === "" || t === "-" ? "0" : t;
+};
+export function bezierCss(b) {
+  return `cubic-bezier(${b.map((v) => fmt(v, 2)).join(", ")})`;
+}
+
+// ---- Spring (damped harmonic oscillator, analytic) --------------------------
+// Position from 0 to 1 with initial velocity v0 (in target units per second).
+export function springSolver(stiffness, damping, mass, v0 = 0) {
+  const k = Math.max(stiffness, 1), c = Math.max(damping, 0), m = Math.max(mass, 0.05);
+  const w0 = Math.sqrt(k / m);
+  const zeta = c / (2 * Math.sqrt(k * m));
+  const x0 = 1; // displacement from target
+  if (zeta < 1) {
+    const wd = w0 * Math.sqrt(1 - zeta * zeta);
+    const A = x0, B = (-v0 + zeta * w0 * x0) / wd;
+    return (t) => 1 - Math.exp(-zeta * w0 * t) * (A * Math.cos(wd * t) + B * Math.sin(wd * t));
+  }
+  if (Math.abs(zeta - 1) < 1e-6) {
+    const A = x0, B = -v0 + w0 * x0;
+    return (t) => 1 - (A + B * t) * Math.exp(-w0 * t);
+  }
+  const r1 = -w0 * (zeta - Math.sqrt(zeta * zeta - 1));
+  const r2 = -w0 * (zeta + Math.sqrt(zeta * zeta - 1));
+  const B = (-v0 - r1 * x0) / (r2 - r1), A = x0 - B;
+  return (t) => 1 - (A * Math.exp(r1 * t) + B * Math.exp(r2 * t));
+}
+export const SPRING_WINDOW = 2.4; // seconds shown by the field
+export function springLUT(sp, n = 512, window = SPRING_WINDOW) {
+  const f = springSolver(sp.stiffness, sp.damping, sp.mass, sp.v0 || 0);
+  const out = new Float32Array(n);
+  for (let i = 0; i < n; i++) out[i] = f((i / (n - 1)) * window);
+  return out;
+}
+export function springSettleMs(sp) {
+  const f = springSolver(sp.stiffness, sp.damping, sp.mass, sp.v0 || 0);
+  let last = 0;
+  for (let i = 0; i <= 600; i++) {
+    const t = i / 100;
+    if (Math.abs(1 - f(t)) > 0.004) last = t;
+  }
+  return Math.max(120, Math.round((last + 0.03) * 1000));
+}
+export function springLinearCss(sp, samples = 16) {
+  const ms = springSettleMs(sp);
+  const f = springSolver(sp.stiffness, sp.damping, sp.mass, sp.v0 || 0);
+  const vals = [];
+  for (let i = 0; i <= samples; i++) vals.push(fmt(f((i / samples) * (ms / 1000)), 2));
+  vals[vals.length - 1] = "1";
+  return { ms, linear: `linear(${vals.join(", ")})`, values: vals };
+}
+
+export const DEFAULT_BEZIER = [0.32, 0, 0.18, 1];
+export const DEFAULT_SPRING = { stiffness: 180, damping: 14, mass: 1, v0: 0 };
+export const BEZIER_PRESETS = [
+  { name: "Ease out", value: [0.32, 0, 0.18, 1] },
+  { name: "Ease in", value: [0.7, 0, 0.9, 0.3] },
+  { name: "Anticipate", value: [0.6, -0.35, 0.3, 1.25] },
+  { name: "Linear", value: [0, 0, 1, 1] },
+];
+
+// Act weights without per-frame stagger (DOM visibility, camera).
+export function actWeights(T, w = 1.6) {
+  const s1 = smoothstep(10 - w, 10 + w, T), s2 = smoothstep(20 - w, 20 + w, T);
+  const s3 = smoothstep(30 - w, 30 + w, T), s4 = smoothstep(40 - w, 40 + w, T);
+  return [1 - s1, s1 - s2, s2 - s3, s3 - s4, s4];
+}
