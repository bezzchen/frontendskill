// Shared timeline model. Everything visual derives from master time T (seconds).
// The GLSL in components/field/shaders.js mirrors sunElevation/sunAzimuth/skyMix exactly.

export const DURATION = 50; // seconds of master timeline
export const FPS = 30; // timecode frame rate

export const ACTS = [
  { id: "dawn", scene: "Dawn", title: "The playhead", start: 0, end: 10 },
  { id: "morning", scene: "Morning", title: "Keyframes", start: 10, end: 20 },
  { id: "noon", scene: "Noon", title: "Springs", start: 20, end: 30 },
  { id: "dusk", scene: "Dusk", title: "Export", start: 30, end: 40 },
  { id: "night", scene: "Night", title: "Early access", start: 40, end: 50 },
];

export const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
export const lerp = (a, b, t) => a + (b - a) * t;
export const smoothstep = (a, b, x) => {
  const t = clamp((x - a) / (b - a), 0, 1);
  return t * t * (3 - 2 * t);
};

// ---- Sun -------------------------------------------------------------------
// Arc parameter s: 0 = sunrise, 0.5 = meridian (T = 25), 1 = sunset (T = 35).
export function sunArc(T) {
  if (T < 25) return clamp((0.5 * (T + 2)) / 27, 0, 1);
  return clamp(0.5 + (0.5 * (T - 25)) / 10, 0, 1);
}
export function sunElevation(T) {
  const s = sunArc(T);
  let el = 1.2 * Math.sin(Math.PI * s);
  if (T > 35) el = -0.25 * smoothstep(35, 40, T) + 0.2 * smoothstep(44, 50, T);
  return el; // radians
}
export function sunAzimuth(T) {
  return Math.PI * sunArc(T);
}
export function sunDirection(T) {
  const el = sunElevation(T);
  const az = sunAzimuth(T);
  const x = Math.cos(az) * Math.cos(el);
  const y = Math.sin(el);
  const z = -Math.cos(el) * Math.sin(az) * 0.9 - 0.15;
  const l = Math.hypot(x, y, z) || 1;
  return [x / l, y / l, z / l];
}

// Day mix factors shared with the shaders.
export function dayMix(T) {
  const el = sunElevation(T);
  const kUp = smoothstep(-0.07, 0.13, el);
  const g = (el - 0.02) / 0.16;
  const kGlow = Math.exp(-g * g);
  const night = 1 - smoothstep(-0.2, 0.02, el);
  return { el, kUp, kGlow, night };
}

// ---- Colors (hex helpers) ----------------------------------------------------
export const hex = (h) => {
  const n = parseInt(h.slice(1), 16);
  return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
};
export const mix3 = (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
export const toCss = (c, a = 1) =>
  `rgba(${Math.round(clamp(c[0], 0, 1) * 255)}, ${Math.round(clamp(c[1], 0, 1) * 255)}, ${Math.round(
    clamp(c[2], 0, 1) * 255
  )}, ${a})`;

export const PALETTE = {
  paper: hex("#f1eee7"),
  ink: hex("#141a2e"),
  nightInk: hex("#0d1024"),
  nightHorizon: hex("#1a2145"),
  dayZenith: hex("#7f9dd6"),
  dayHorizon: hex("#e9eef5"),
  glowHorizon: hex("#f3b184"),
  glowZenith: hex("#55639f"),
  warmPaper: hex("#f0c39c"),
  shadow: hex("#26305e"),
  ultramarine: hex("#2c3ee6"),
  periwinkle: hex("#8d9bff"),
  sun: hex("#ff9f2e"),
};

// Theme snapshot for the DOM at time T (same math as the ground shader).
export function themeAt(T) {
  const { kUp, kGlow, night } = dayMix(T);
  const P = PALETTE;
  let ground = mix3(P.nightInk, P.paper, kUp);
  ground = mix3(ground, P.warmPaper, kGlow * 0.35);
  let horizon = mix3(P.nightHorizon, P.dayHorizon, kUp);
  horizon = mix3(horizon, P.glowHorizon, kGlow);
  const fg = mix3(P.ink, P.paper, night);
  const accent = mix3(P.ultramarine, P.periwinkle, night);
