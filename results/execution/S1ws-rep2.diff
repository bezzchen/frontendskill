// ---- Timecode ----------------------------------------------------------------
export function timecode(T) {
  const total = clamp(T, 0, DURATION);
  const s = Math.floor(total);
  const f = Math.floor((total - s) * FPS);
  const mm = Math.floor(s / 60);
  const ss = s % 60;
  const p = (n) => String(n).padStart(2, "0");
  return `00:${p(mm)}:${p(ss)}:${p(f)}`;
}

export function actAt(T) {
  for (let i = ACTS.length - 1; i >= 0; i--) if (T >= ACTS[i].start) return i;
  return 0;
}

// ---- Cubic bezier easing (CSS semantics) -------------------------------------
export function cubicBezierSolver(x1, y1, x2, y2) {
  const ax = 3 * x1 - 3 * x2 + 1, bx = 3 * x2 - 6 * x1, cx = 3 * x1;
  const ay = 3 * y1 - 3 * y2 + 1, by = 3 * y2 - 6 * y1, cy = 3 * y1;
  const sx = (t) => ((ax * t + bx) * t + cx) * t;
  const sy = (t) => ((ay * t + by) * t + cy) * t;
  const dx = (t) => (3 * ax * t + 2 * bx) * t + cx;
  return (x) => {
    if (x <= 0) return 0;
    if (x >= 1) return 1;
    let t = x;
    for (let i = 0; i < 8; i++) {
      const e = sx(t) - x;
      const d = dx(t);
      if (Math.abs(e) < 1e-6) break;
      if (Math.abs(d) < 1e-6) break;
      t -= e / d;
    }
    if (t < 0 || t > 1 || Math.abs(sx(t) - x) > 1e-4) {
      let lo = 0, hi = 1;
      for (let i = 0; i < 24; i++) {
