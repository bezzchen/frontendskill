};
export function bezierCss(b) {
  return `cubic-bezier(${b.map((v) => fmt(v, 2)).join(", ")})`;
}

// ---- Spring (damped harmonic oscillator, analytic) --------------------------
// Position from 0 to 1 with initial velocity v0 (in target units per second).
export function springSolver(stiffness, damping, mass, v0 = 0) {
  const k = Math.max(stiffness, 1), c = Math.max(damping, 0), m = Math.max(mass, 0.05);
  const w0 = Math.sqrt(k / m);
  const zeta = c / (2 * Math.sqrt(k * m));
  const x0 = 1; // displacement from target
  if (zeta < 1) {
    const wd = w0 * Math.sqrt(1 - zeta * zeta);
    const A = x0, B = (-v0 + zeta * w0 * x0) / wd;
    return (t) => 1 - Math.exp(-zeta * w0 * t) * (A * Math.cos(wd * t) + B * Math.sin(wd * t));
  }
  if (Math.abs(zeta - 1) < 1e-6) {
    const A = x0, B = -v0 + w0 * x0;
    return (t) => 1 - (A + B * t) * Math.exp(-w0 * t);
  }
  const r1 = -w0 * (zeta - Math.sqrt(zeta * zeta - 1));
  const r2 = -w0 * (zeta + Math.sqrt(zeta * zeta - 1));
  const B = (-v0 - r1 * x0) / (r2 - r1), A = x0 - B;
  return (t) => 1 - (A * Math.exp(r1 * t) + B * Math.exp(r2 * t));
}
export const SPRING_WINDOW = 2.4; // seconds shown by the field
export function springLUT(sp, n = 512, window = SPRING_WINDOW) {
  const f = springSolver(sp.stiffness, sp.damping, sp.mass, sp.v0 || 0);
  const out = new Float32Array(n);
  for (let i = 0; i < n; i++) out[i] = f((i / (n - 1)) * window);
