+"use client";
+import { useSyncExternalStore } from "react";
+import { DEFAULT_BEZIER, DEFAULT_SPRING } from "./timeline";
+
+// One mutable model, read per-frame by the renderer (no React re-render per frame),
+// plus a small subscription for the discrete values React cares about.
+export const store = {
+  T: 0,
+  idle: 0,
+  mode: "full", // "full" | "calm"
+  reduced: false,
+  playing: false,
+  expectedScrollY: -1,
+  tier: "high",
+  tierN: 40000,
+  gl: "unknown", // "unknown" | "ok" | "none"
+  bezier: DEFAULT_BEZIER.slice(),
+  easeVersion: 0,
+  spring: { ...DEFAULT_SPRING },
+  springVersion: 0,
+  springTrigger: -100,
+  springHead: 1,
+  easeHead: 0,
+  pointer: { x: -1, y: -1, active: false, k: 0 },
+  impulses: new Float32Array(32),
+  impulseIdx: 0,
+  glyphEl: null,
+  glyphs: null,
+  glyphCount: 0,
+  glyphVersion: 0,
+  dirty: true,
+  running: false,
+  frameCount: 0,
+  fps: 0,
+};
+
+const listeners = new Set();
+const frameListeners = new Set();
+let starter = null;
+
+export function setState(patch) {
+  Object.assign(store, patch);
+  for (const l of listeners) l();
+}
+export function subscribe(fn) {
+  listeners.add(fn);
+  return () => listeners.delete(fn);
+}
+export function useStore(selector) {
+  return useSyncExternalStore(subscribe, () => selector(store), () => selector(store));
+}
+export function onFrame(fn) {
+  frameListeners.add(fn);
+  return () => frameListeners.delete(fn);
+}
+export function emitFrame(info) {
+  for (const l of frameListeners) l(info);
+}
+export function setStarter(fn) {
+  starter = fn;
+  return () => { if (starter === fn) starter = null; };
+}
+export function requestRender() {
+  store.dirty = true;
+  if (starter) starter();
+}
+export function setBezier(b) {
+  store.bezier = b.map((v) => Math.round(v * 100) / 100);
+  store.easeVersion++;
+  for (const l of listeners) l();
+  requestRender();
+}
+export function setSpring(patch, retrigger = true) {
+  store.spring = { ...store.spring, ...patch };
+  store.springVersion++;
+  if (retrigger) store.springTrigger = store.idle;
+  for (const l of listeners) l();
+  requestRender();
+}
+export function retriggerSpring() {
+  store.springTrigger = store.idle;
+  requestRender();
+}
+export function addImpulse(x, strength) {
+  const i = store.impulseIdx % 8;
+  store.impulses[i * 4] = x;
+  store.impulses[i * 4 + 1] = store.idle;
+  store.impulses[i * 4 + 2] = strength;
+  store.impulses[i * 4 + 3] = 0;
+  store.impulseIdx++;
+  requestRender();
+}
+export function setGlyphs(data, count, el) {
+  store.glyphs = data;
+  store.glyphCount = count;
+  store.glyphEl = el;
+  store.glyphVersion++;
+  requestRender();
+}
