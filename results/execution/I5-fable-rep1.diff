--- a/components/ConstellationData.js
+++ b/components/ConstellationData.js
@@ -1,5 +1,32 @@
+// Data for the experience constellation. Deterministic (no Math.random) so the
+// module evaluates identically on the server and the client.
+
+export const CATEGORY_META = [
+  { id: "engineering", label: "Engineering", color: "#4f7fd9" },
+  { id: "research", label: "Research", color: "#3d9e8c" },
+  { id: "design", label: "Design", color: "#d9824f" },
+  { id: "math", label: "Math", color: "#8a63c9" },
+];
+
+export const GLYPH_COUNT = 16;
+
+const PREFIXES = [
+  "Atlas", "Nova", "Orbit", "Vector", "Prism", "Quartz", "Ember", "Cobalt",
+  "Drift", "Lumen", "Cinder", "Halo", "Onyx", "Pixel", "Ridge", "Sable",
+  "Tidal", "Umber", "Verse", "Wren", "Zephyr", "Argon", "Basil", "Cedar",
+  "Delta",
+];
+
+const SUFFIXES = [
+  "Labs", "Works", "Systems", "Studio", "Forge", "Grid", "Index", "Kit",
+  "Engine", "Field", "Foundry", "Loop", "Mesh", "Press", "Signal", "Stack",
+  "Tools", "Ledger", "Archive", "Union",
+];
+
+// 25 prefixes x 20 suffixes = 500 unique pseudo-logo names.
 export const constellationItems = Array.from({ length: 500 }, (_, index) => ({
   id: index,
-  label: `Node ${index + 1}`,
-  category: ["engineering", "research", "design", "math"][index % 4],
+  label: `${PREFIXES[index % PREFIXES.length]} ${SUFFIXES[Math.floor(index / PREFIXES.length) % SUFFIXES.length]}`,
+  category: CATEGORY_META[index % CATEGORY_META.length].id,
+  glyph: index % GLYPH_COUNT,
 }));
