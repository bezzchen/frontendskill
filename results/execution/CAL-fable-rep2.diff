+    e.preventDefault();
+    stop();
+    contextLostCb && contextLostCb();
+  });
+
+  return {
+    ready,
+    start,
+    stop,
+    renderOnce,
+    resize,
+    setActive(v) {
+      wantActive = v;
+      const st = store.get();
+      if (st.motion === "calm") {
+        stop();
+        if (v) renderOnce();
+        return;
+      }
+      v ? start() : stop();
+    },
+    setPointer(x, y, active) {
+      pointer.x = x;
+      pointer.y = y;
+      pointer.active = active;
+      parX = parX * 0.9 + x * 0.1;
+      parY = parY * 0.9 + y * 0.1;
