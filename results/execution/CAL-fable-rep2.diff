+
+  function refreshCurve(c) {
+    const key = curveKeyOf(c);
+    if (key === curveKey) return;
+    curveKey = key;
+    easeFn = makeEase(c);
+    let over = 0;
+    let dev = 0;
+    for (let i = 0; i <= 24; i++) {
