+    tap() {
+      tapPulse = 1.0;
+    },
+    ignite() {
+      igniteV = 1;
+    },
+    onContextLost(cb) {
+      contextLostCb = cb;
+    },
+    dispose() {
+      disposed = true;
+      stop();
+      scene.traverse((o) => {
+        if (o.geometry) o.geometry.dispose();
+        if (o.material) {
+          if (o.material.map) o.material.map.dispose();
+          o.material.dispose();
+        }
+      });
+      renderer.dispose();
+    },
+  };
+}
