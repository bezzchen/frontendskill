+  padding: 9px 13px;
+  cursor: pointer;
+  transition: color 0.2s;
+}
+.cp-copy:hover {
+  color: var(--meridian);
+}
+.cp-pre {
+  margin: 0;
+  padding: 14px 16px 16px;
+  font-family: var(--font-mono), monospace;
+  font-size: 11.5px;
+  line-height: 1.65;
+  overflow: auto;
+  max-height: 300px;
+  color: #c9d2e0;
+}
+.cp-pre .cmt {
+  color: #55617a;
+}
+.cp-pre .kw {
+  color: #e8b36b;
+}
+.cp-pre .str {
+  color: #7fd8c8;
+}
+.cp-pre .num {
+  color: var(--signal);
+}
+.cp-pre .fn {
+  color: #dfe6f2;
+}
+.cp-pre .live {
+  color: var(--meridian);
+  background: rgba(255, 179, 92, 0.09);
+  border-radius: 3px;
+  padding: 0 2px;
+}
+
+/* ============================================================ calm mode
+   A designed variant, not a gutted one: composed stills, cuts instead of
+   tweens, everything readable, every control still working. */
+.stage[data-motion="calm"] .card {
+  opacity: 1;
+  transform: none;
+  transition: none;
+}
+.stage[data-motion="calm"] .play-only {
+  display: none;
+}
+.stage[data-motion="calm"] .hint {
+  visibility: hidden;
+}
+.stage[data-motion="calm"] .poster svg {
+  transition: none;
+}
+.stage[data-motion="calm"] .boot {
+  transition: opacity 0.16s;
+  clip-path: none;
+}
+.stage[data-motion="calm"] .boot-leaving {
+  opacity: 0;
+}
+.stage[data-motion="calm"] .boot-progress span {
+  animation: none;
+  width: 100%;
+}
+
+/* system-level reduced motion baseline (before JS, and belt-and-braces) */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+  html {
+    scroll-behavior: auto !important;
+  }
+}
+
+/* ============================================================ responsive */
+@media (max-width: 980px) {
+  .dock {
+    grid-template-columns: 158px 1fr;
+    gap: 12px;
+  }
+  .dock-right {
+    display: none;
+  }
+  .chapter-name {
+    display: none;
+  }
+  .tc-sub {
+    display: none;
+  }
+}
+@media (max-width: 700px) {
   :root {
-    --background: #111110;
-    --foreground: #f5f5f2;
-    --muted: #a0a099;
-    --surface: #181817;
-    --line: #31312f;
+    --dock-h: 92px;
+    --top-h: 54px;
+  }
+  .chip,
+  .tc-top {
+    display: none;
+  }
+  .brand-name {
+    font-size: 17px;
+  }
+  .toggle {
+    padding: 7px 9px;
+  }
+  .btn {
+    padding: 10px 13px;
+    font-size: 10px;
+  }
+  .dock {
+    grid-template-columns: 96px 1fr;
+    gap: 10px;
+    padding-inline: 12px;
+  }
+  .tc-block {
+    display: none;
+  }
+  .tracks .track-name {
+    display: none;
+  }
+  .card {
+    max-width: 100%;
+    top: 13vh;
+  }
+  .act {
+    padding-inline: 14px;
+  }
+  .site-footer {
+    flex-direction: column;
+    gap: 8px;
   }
 }
 
-* { box-sizing: border-box; }
-html { background: var(--background); color: var(--foreground); }
-body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
-a { color: inherit; }
-button, input { font: inherit; }
+/* round 1 refinements */
+.nobr {
+  white-space: nowrap;
+}
+.chapter b {
+  margin-right: 5px;
+}
+.hero-card {
+  background: transparent;
+  border-color: transparent;
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  padding-left: 0;
+  box-shadow: none;
+}
+.hero-card::before {
+  content: "";
+  position: absolute;
+  inset: -60px -60px -60px -140px;
+  z-index: -1;
+  background: radial-gradient(88% 80% at 32% 45%, rgba(4, 6, 10, 0.62) 26%, transparent 72%);
+  pointer-events: none;
+}
+
+/* lock-mode (screenshot harness): pin the current act's card in place */
+.stage.lockmode .act {
+  height: 20vh !important;
+  padding: 0;
+}
+.stage.lockmode .card {
+  display: none;
+}
+.stage.lockmode[data-act="0"] .act[data-card="0"] .card,
+.stage.lockmode[data-act="1"] .act[data-card="1"] .card,
+.stage.lockmode[data-act="2"] .act[data-card="2"] .card,
+.stage.lockmode[data-act="3"] .act[data-card="3"] .card,
+.stage.lockmode[data-act="4"] .act[data-card="4"] .card {
+  display: block;
+  position: fixed;
+  top: 14vh;
+  left: clamp(18px, 6vw, 110px);
+  right: auto;
+  margin: 0;
+  opacity: 1;
+  transform: none;
+}
+.stage.lockmode[data-act="1"] .act[data-card="1"] .card,
+.stage.lockmode[data-act="3"] .act[data-card="3"] .card {
+  left: auto;
+  right: clamp(18px, 5vw, 96px);
+}
+
+/* act III density fixes */
+.ce-svg {
+  max-width: 430px;
+}
+.ce-linear {
+  stroke: rgba(138, 148, 168, 0.3);
+  stroke-width: 1;
+  stroke-dasharray: 2 4;
+}
+.act[data-card="2"] .card {
+  top: clamp(70px, 10vh, 130px);
+  max-width: 620px;
+}
+.act[data-card="2"] .body {
+  margin-bottom: 8px;
+}
+.act[data-card="2"] .caption {
+  margin-top: 10px;
+}
+.curve-editor {
+  margin-top: 12px;
+}
+
+/* mobile overflow + fit fixes */
+html,
+body {
+  overflow-x: clip;
+}
+@media (max-width: 700px) {
+  .display .nobr {
+    white-space: normal;
+  }
+  .hero-card::before {
+    inset: -30px -14px;
+  }
+  .display {
+    font-size: clamp(44px, 12vw, 60px);
+  }
+}
+@media (max-width: 560px) {
+  .topbar .btn-primary {
+    display: none;
+  }
+}
