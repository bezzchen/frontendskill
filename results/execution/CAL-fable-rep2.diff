+  let playT = 0;
+  let clock = 0;
+  let last = 0;
+  let raf = null;
+  let running = false;
+  let wantActive = false;
+  let disposed = false;
+  let igniteV = 0;
+  let endFlash = 0;
+  let prevEnded = false;
+  let pointer = { x: 10, y: 10, active: false };
+  let parX = 0;
+  let parY = 0;
+  let ptrAmp = 0;
+  let tapPulse = 0;
+  let easeFn = makeEase(store.get().curve);
+  let curveKey = "";
+  let curveEnergy = 0.4;
+  let fov = 66;
+
+  const curveKeyOf = (c) =>
