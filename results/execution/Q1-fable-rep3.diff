diff --git a/app/globals.css b/app/globals.css
index 6529d42..c9e5c6d 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -7,6 +7,7 @@
   --muted: #6b6b66;
   --surface: #ffffff;
   --line: #deded8;
+  --danger: #b42318;
 }
 
 @media (prefers-color-scheme: dark) {
@@ -16,6 +17,7 @@
     --muted: #a0a099;
     --surface: #181817;
     --line: #31312f;
+    --danger: #f97066;
   }
 }
 
@@ -24,3 +26,27 @@ html { background: var(--background); color: var(--foreground); }
 body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
 a { color: inherit; }
 button, input { font: inherit; }
+
+/* One consistent, high-contrast keyboard focus ring across the site. */
+:focus-visible {
+  outline: 2px solid var(--foreground);
+  outline-offset: 2px;
+}
+
+/* Micro-appearance for inline status and validation messages. */
+@keyframes settings-fade-in {
+  from { opacity: 0; transform: translateY(-2px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* Reduced motion: state changes still happen, just instantly. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
