--- a/app/globals.css
+++ b/app/globals.css
@@ -24,3 +24,36 @@ html { background: var(--background); color: var(--foreground); }
 body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
 a { color: inherit; }
 button, input { font: inherit; }
+
+/* ---------------------------------------------------------------------------
+   Experience system — progressive enhancement hooks.
+   Without JavaScript the section stays a plain responsive grid (see the
+   component); once the desktop scope boots it flips the stage into an
+   absolutely-positioned orbital canvas. All motion values live in JS —
+   these rules only describe the enhanced structure.
+--------------------------------------------------------------------------- */
+[data-experience-system] .orb-hit { cursor: inherit; }
+[data-experience-system] .orb-card { transition: box-shadow 180ms ease; }
+[data-experience-system] .orb-item.is-grabbed .orb-card {
+  box-shadow: 0 16px 44px rgb(0 0 0 / 0.16);
+}
+
+@media (min-width: 1024px) {
+  [data-experience-system][data-enhanced] {
+    display: block;
+    height: 42rem;
+  }
+  [data-experience-system][data-enhanced] .orb-item {
+    position: absolute;
+    top: 0;
+    left: 0;
+    margin: 0;
+    will-change: transform;
+  }
+  [data-experience-system][data-enhanced] .orb-drag {
+    will-change: transform;
+  }
+  [data-experience-system][data-enhanced] .orb-ring {
+    display: block;
+  }
+}
