+  transition: background 150ms ease, color 150ms ease;
+}
+.ce-play:hover { background: var(--solar); color: #171006; }
+.ce-note {
+  margin: 0.7rem 0 0;
+  font-size: 0.72rem;
+  color: var(--faint);
+}
+
+/* ————— Code panel ————— */
+.code-panel {
+  border: 1px solid var(--line);
