--- /dev/null
+++ b/lib/engine.js
@@ -0,0 +1,475 @@
+/*
+ * Meridian field engine — raw WebGL2, no dependencies.
+ *
+ * One instanced draw call renders N "keyframe diamonds". Every formation the
+ * field can take (hero arc, dope sheet, easing river, compiled grid, zenith
+ * line) is computed procedurally in the vertex shader from per-instance
+ * seeds, and blended by act weights derived from a single master-timeline
+ * uniform (uScroll). CPU cost per frame is a handful of uniform uploads.
+ */
+
+const VERT = `#version 300 es
+precision highp float;
+
+layout(location = 0) in vec4 aSeed;   // r0..r3 in [0,1)
+layout(location = 1) in vec4 aSeed2;  // r4..r7 in [0,1)
+
+uniform vec2  uRes;       // drawing buffer px
+uniform float uAspect;    // w/h
+uniform float uTime;      // seconds
+uniform float uScroll;    // master timeline, 0..1 (smoothed)
+uniform float uBounds[5]; // act start fractions b0..b4
+uniform vec4  uCurve;     // x1,y1,x2,y2
+uniform vec4  uPointer;   // world x, world y, strength, _
+uniform float uFlow;      // 1 = live, 0 = frozen (reduced motion poster)
+uniform float uSizePx;    // base diamond size in device px
+
+out vec3  vColor;
+out float vAlpha;
+out float vGlow;
+out vec2  vCorner;
+
+const vec3 SOLAR   = vec3(0.961, 0.722, 0.271);
+const vec3 SOLAR2  = vec3(0.816, 0.541, 0.149);
+const vec3 PAPER   = vec3(0.937, 0.925, 0.890);
+const vec3 GLASS   = vec3(0.612, 0.773, 0.871);
+const vec3 DUSK    = vec3(0.384, 0.447, 0.596);
+
+float bez1(float t, float p1, float p2) {
+  float it = 1.0 - t;
+  return 3.0*it*it*t*p1 + 3.0*it*t*t*p2 + t*t*t;
+}
+float bezD(float t, float p1, float p2) {
+  float it = 1.0 - t;
+  return 3.0*it*it*p1 + 6.0*it*t*(p2 - p1) + 3.0*t*t*(1.0 - p2);
+}
+float win(float s, float a, float b, float f) {
+  return smoothstep(a - f, a + f, s) * (1.0 - smoothstep(b - f, b + f, s));
+}
+
+void main() {
+  float A = uAspect;
+  float s = uScroll;
+  float F = 0.035; // act crossfade feather
+
+  // ——— act weights ———
+  float w0 = 1.0 - smoothstep(uBounds[1] - F, uBounds[1] + F, s);
+  float w1 = win(s, uBounds[1], uBounds[2], F);
+  float w2 = win(s, uBounds[2], uBounds[3], F);
+  float w3 = win(s, uBounds[3], uBounds[4], F);
+  float w4 = smoothstep(uBounds[4] - F, uBounds[4] + F, s);
+
+  vec2  pos   = vec2(0.0);
+  vec3  col   = vec3(0.0);
+  float alpha = 0.0;
+  float size  = 0.0;
+  float tFroze = uTime * uFlow;
+
+  // ——— F0 · first light: dust + a sun arc ———
+  if (w0 > 0.001) {
+    bool onArc = aSeed.w < 0.42;
+    vec2 p;
+    float a0;
+    vec3 c0;
+    if (onArc) {
+      float x = mix(-A, A, aSeed.x);
+      float nx = x / A;
+      p = vec2(x, 0.02 + 0.52 * (1.0 - nx * nx) - 0.3);
+      p.y += (aSeed.y - 0.5) * 0.055;
+      float peak = 1.0 - abs(nx);
+      a0 = 0.25 + 0.85 * peak * peak;
+      c0 = mix(SOLAR2, SOLAR, peak);
+      if (aSeed2.x > 0.92) c0 = PAPER;
+    } else {
+      p = vec2(mix(-A, A, aSeed.x), mix(-1.05, 1.05, aSeed.y));
+      a0 = 0.05 + 0.14 * aSeed2.y;
+      c0 = mix(DUSK, GLASS, aSeed2.x);
+    }
+    p += 0.018 * vec2(sin(tFroze * 0.24 + aSeed.z * 6.283), cos(tFroze * 0.19 + aSeed.y * 6.283));
+    pos += w0 * p; col += w0 * c0; alpha += w0 * a0;
+    size += w0 * (onArc ? 1.05 : 0.6);
+  }
+
+  // ——— F1 · the dope sheet: seven tracks, a sweeping playhead ———
+  if (w1 > 0.001) {
+    float row = floor(aSeed.x * 7.0);
+    float x = mix(-0.92 * A, 0.92 * A, aSeed.y);
+    if (aSeed2.x < 0.55) {
+      x = ((floor(aSeed.y * 24.0) + 0.5) / 24.0) * 1.84 * A - 0.92 * A; // beat-quantised keys
+    }
+    float y = 0.62 - row * 0.205;
+    y += sin(tFroze * 0.5 + aSeed.z * 6.283) * 0.008;
+
+    float lp = clamp((s - uBounds[1]) / max(uBounds[2] - uBounds[1], 1e-4), 0.0, 1.0);
+    float ph = mix(-0.92 * A, 0.92 * A, lp);
+    float flash = exp(-abs(x - ph) * (9.0 / max(A, 1.0))) * 1.5;
+    float lit = (1.0 - step(ph, x)) * 0.4;
+
+    float a1 = 0.16 + lit + flash;
+    vec3 c1 = mix(mix(DUSK, PAPER, 0.35), SOLAR, clamp(lit * 1.6 + flash, 0.0, 1.0));
+    pos += w1 * vec2(x, y); col += w1 * c1; alpha += w1 * a1;
+    size += w1 * (1.15 + flash * 0.9);
+  }
+
+  // ——— F2 · the easing river: your curve, made of light ———
+  if (w2 > 0.001) {
+    float u = fract(aSeed.x + tFroze * (0.02 + 0.045 * aSeed.y));
+    bool ghost = aSeed2.y > 0.86; // linear reference stream
+    float gx = ghost ? u : bez1(u, uCurve.x, uCurve.z);
+    float gy = ghost ? u : bez1(u, uCurve.y, uCurve.w);
+    vec2 p = vec2(mix(-0.98 * A, 0.98 * A, gx), mix(-0.62, 0.42, gy));
+
+    vec2 d = vec2(bezD(u, uCurve.x, uCurve.z), bezD(u, uCurve.y, uCurve.w));
+    float speed = ghost ? 1.0 : length(d);
+    vec2 n = normalize(vec2(-d.y, d.x) + 1e-4);
+    p += (ghost ? vec2(0.0, 1.0) : n) * (aSeed.z - 0.5) * (ghost ? 0.02 : 0.085);
+
+    float a2 = ghost ? 0.14 : (0.10 + 0.42 * clamp(speed * 0.55, 0.0, 1.4));
+    vec3 c2 = ghost ? GLASS : mix(SOLAR2, mix(SOLAR, PAPER, 0.45), clamp(speed * 0.4, 0.0, 1.0));
+    pos += w2 * p; col += w2 * c2; alpha += w2 * a2;
+    size += w2 * (ghost ? 0.55 : 0.95);
+  }
+
+  // ——— F3 · compile: the field quantises into a code grid ———
+  if (w3 > 0.001) {
+    float gx = (floor(aSeed.x * 64.0) + 0.5) / 64.0;
+    float gy = (floor(aSeed.y * 36.0) + 0.5) / 36.0;
+    vec2 p = vec2(mix(-0.96 * A, 0.96 * A, gx), mix(-0.78, 0.78, gy));
+    float scan = smoothstep(0.94, 1.0, fract(gy * 1.0 - tFroze * 0.05));
+    float a3 = 0.07 + 0.30 * scan + 0.10 * step(0.94, aSeed2.z);
+    vec3 c3 = mix(mix(DUSK, GLASS, 0.6), PAPER, scan);
+    pos += w3 * p; col += w3 * c3; alpha += w3 * a3;
+    size += w3 * 0.5;
+  }
+
+  // ——— F4 · zenith: everything converges on the meridian ———
+  if (w4 > 0.001) {
+    float t = aSeed.x * 2.0 - 1.0;
+    float x = sign(t) * pow(abs(t), 1.4) * A;
+    float yy = aSeed.y - 0.5;
+    float yLine = sign(yy) * pow(abs(yy * 2.0), 3.0) * 0.42;
+    yLine += sin(tFroze * 0.6 + aSeed.z * 6.283) * 0.006;
+    float core = exp(-abs(yLine) * 7.0) * exp(-abs(x) / A * 1.15);
+    float y = yLine - 0.28; // ride below the CTA, above the timeline bar
+    float a4 = 0.08 + core * 1.25;
+    vec3 c4 = mix(SOLAR2, mix(SOLAR, PAPER, core), core);
+    pos += w4 * vec2(x, y); col += w4 * c4; alpha += w4 * a4;
+    size += w4 * (0.8 + core * 0.9);
+  }
+
+  // ——— pointer ripple ———
+  vec2 pd = pos - uPointer.xy;
+  float push = exp(-dot(pd, pd) * 9.0) * 0.11 * uPointer.z;
+  pos += normalize(pd + 1e-4) * push;
+
+  // ——— twinkle ———
+  alpha *= 0.78 + 0.24 * sin(uTime * (0.5 + aSeed2.w * 1.6) + aSeed.x * 40.0);
+
+  float px = uSizePx * (0.55 + aSeed2.z * 0.95) * size;
+  vec2 corner = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1)) * 2.0 - 1.0;
+  vCorner = corner;
+  vColor = col;
+  vAlpha = clamp(alpha, 0.0, 1.6);
+  vGlow = clamp(px / max(uSizePx, 1.0) - 0.3, 0.2, 1.4);
+
+  vec2 clip = vec2(pos.x / A, pos.y);
+  clip += corner * (px * 2.0) / uRes;
+  gl_Position = vec4(clip, 0.0, 1.0);
+}`;
+
+const FRAG = `#version 300 es
+precision mediump float;
+
+in vec3  vColor;
+in float vAlpha;
+in float vGlow;
+in vec2  vCorner;
+out vec4 outColor;
+
+void main() {
+  float d = abs(vCorner.x) + abs(vCorner.y);
+  float core = 1.0 - smoothstep(0.5, 1.0, d);
+  float glow = exp(-d * 1.9) * 0.55;
+  float a = (core + glow * vGlow) * vAlpha;
+  // tiny dither to avoid banding in the glow
+  a += (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 255.0;
+  outColor = vec4(vColor * a, a);
+}`;
+
+function mulberry32(seed) {
+  return function () {
+    seed |= 0;
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function supportsWebGL2() {
+  try {
+    const c = document.createElement("canvas");
+    return !!c.getContext("webgl2");
+  } catch {
+    return false;
+  }
+}
+
+export class Field {
+  constructor(canvas, opts = {}) {
+    this.canvas = canvas;
+    this.count = opts.count ?? 12000;
+    this.dprCap = opts.dprCap ?? 2;
+    this.sizeBase = opts.sizePx ?? 3.1;
+
+    this.gl = null;
+    this.program = null;
+    this.vao = null;
+    this.uni = {};
+
+    this.targetScroll = 0;
+    this.scroll = 0;
+    this.bounds = new Float32Array([0, 0.2, 0.4, 0.6, 0.8]);
+    this.curve = new Float32Array([0.34, 1.4, 0.24, 1]);
+    this.pointer = { x: 0, y: 0, tx: 0, ty: 0, strength: 0 };
+
+    this.mode = "flow"; // "flow" | "static"
+    this.running = false;
+    this.raf = 0;
+    this.lastT = 0;
+    this.staticTime = 40; // frozen clock for the reduced-motion poster
+    this.staticAct = -1;
+
+    // adaptive quality
+    this.ema = 16;
+    this.frames = 0;
+    this.qualityStep = 0;
+
+    this._loop = this._loop.bind(this);
+    this._onContextLost = this._onContextLost.bind(this);
+    this._onContextRestored = this._onContextRestored.bind(this);
+    this.onContextLost = opts.onContextLost || null;
+  }
+
+  init() {
+    const gl = this.canvas.getContext("webgl2", {
+      alpha: true,
+      antialias: false,
+      depth: false,
+      stencil: false,
+      premultipliedAlpha: true,
+      powerPreference: "high-performance",
+    });
+    if (!gl) return false;
+    this.gl = gl;
+
+    const compile = (type, src) => {
+      const sh = gl.createShader(type);
+      gl.shaderSource(sh, src);
+      gl.compileShader(sh);
+      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
+        console.error("[meridian] shader:", gl.getShaderInfoLog(sh));
+        return null;
+      }
+      return sh;
+    };
+    const vs = compile(gl.VERTEX_SHADER, VERT);
+    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
+    if (!vs || !fs) return false;
+
+    const prog = gl.createProgram();
+    gl.attachShader(prog, vs);
+    gl.attachShader(prog, fs);
+    gl.linkProgram(prog);
+    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
+      console.error("[meridian] link:", gl.getProgramInfoLog(prog));
+      return false;
+    }
+    this.program = prog;
+
+    for (const name of ["uRes", "uAspect", "uTime", "uScroll", "uCurve", "uPointer", "uFlow", "uSizePx"]) {
+      this.uni[name] = gl.getUniformLocation(prog, name);
+    }
+    this.uni.uBounds = gl.getUniformLocation(prog, "uBounds[0]");
+
+    // per-instance seeds — deterministic so reloads look identical
+    const rand = mulberry32(19260817);
+    const seeds = new Float32Array(this.count * 8);
+    for (let i = 0; i < seeds.length; i++) seeds[i] = rand();
+
+    const vao = gl.createVertexArray();
+    gl.bindVertexArray(vao);
+    const buf = gl.createBuffer();
+    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+    gl.bufferData(gl.ARRAY_BUFFER, seeds, gl.STATIC_DRAW);
+    gl.enableVertexAttribArray(0);
+    gl.vertexAttribPointer(0, 4, gl.FLOAT, false, 32, 0);
+    gl.vertexAttribDivisor(0, 1);
+    gl.enableVertexAttribArray(1);
+    gl.vertexAttribPointer(1, 4, gl.FLOAT, false, 32, 16);
+    gl.vertexAttribDivisor(1, 1);
+    gl.bindVertexArray(null);
+    this.vao = vao;
+
+    gl.disable(gl.DEPTH_TEST);
+    gl.enable(gl.BLEND);
+    gl.blendFunc(gl.ONE, gl.ONE); // additive light
+
+    this.canvas.addEventListener("webglcontextlost", this._onContextLost, false);
+    this.canvas.addEventListener("webglcontextrestored", this._onContextRestored, false);
+
+    this.resize();
+    return true;
+  }
+
+  _onContextLost(e) {
+    e.preventDefault();
+    this.stop();
+    if (this.onContextLost) this.onContextLost();
+  }
+  _onContextRestored() {
+    this.init();
+    if (this.mode === "flow") this.start();
+    else this.renderStatic(true);
+  }
+
+  resize() {
+    const dpr = Math.min(window.devicePixelRatio || 1, this.dprCap);
+    const w = Math.round(window.innerWidth * dpr);
+    const h = Math.round(window.innerHeight * dpr);
+    if (this.canvas.width !== w || this.canvas.height !== h) {
+      this.canvas.width = w;
+      this.canvas.height = h;
+    }
+    this.dpr = dpr;
+    if (this.mode === "static") this.renderStatic(true);
+  }
+
+  setScroll(t) {
+    this.targetScroll = t;
+    if (this.mode === "static") this.renderStatic(false);
+  }
+  setBounds(arr) {
+    for (let i = 0; i < 5; i++) this.bounds[i] = arr[i] ?? this.bounds[i];
+    if (this.mode === "static") this.renderStatic(true);
+  }
+  setCurve(c) {
+    this.curve[0] = c[0]; this.curve[1] = c[1]; this.curve[2] = c[2]; this.curve[3] = c[3];
+    if (this.mode === "static") this.renderStatic(true);
+  }
+  setPointer(x, y, strength = 1) {
+    this.pointer.tx = x;
+    this.pointer.ty = y;
+    this.pointer.strength = Math.min(this.pointer.strength + strength * 0.25, 1);
+  }
+
+  setMode(mode) {
+    if (this.mode === mode) return;
+    this.mode = mode;
+    if (mode === "static") {
+      this.stop();
+      this.renderStatic(true);
+    }
+  }
+
+  actIndex(t) {
+    let i = 0;
+    for (let k = 1; k < 5; k++) if (t >= this.bounds[k]) i = k;
+    return i;
+  }
+
+  start() {
+    if (this.running || !this.gl || this.mode === "static") return;
+    this.running = true;
+    this.lastT = performance.now();
+    this.raf = requestAnimationFrame(this._loop);
+  }
+  stop() {
+    this.running = false;
+    if (this.raf) cancelAnimationFrame(this.raf);
+    this.raf = 0;
+  }
+
+  _loop(now) {
+    if (!this.running) return;
+    const dt = Math.min((now - this.lastT) / 1000, 0.05);
+    this.lastT = now;
+
+    // critically-damped follow: buttery scrub without lag mush
+    const k = 1 - Math.exp(-dt * 6.5);
+    this.scroll += (this.targetScroll - this.scroll) * k;
+
+    const pk = 1 - Math.exp(-dt * 8);
+    this.pointer.x += (this.pointer.tx - this.pointer.x) * pk;
+    this.pointer.y += (this.pointer.ty - this.pointer.y) * pk;
+    this.pointer.strength *= Math.exp(-dt * 1.4);
+
+    this._draw((now / 1000) % 3600, 1);
+    this._watchQuality(dt);
+    this.raf = requestAnimationFrame(this._loop);
+  }
+
+  renderStatic(force) {
+    if (!this.gl) return;
+    const act = this.actIndex(this.targetScroll);
+    if (!force && act === this.staticAct) return;
+    this.staticAct = act;
+    // pose the field at the act's midpoint: a pure, fully-formed formation
+    const b = this.bounds;
+    const end = act < 4 ? b[act + 1] : 1;
+    this.scroll = (b[act] + end) / 2;
+    this.pointer.strength = 0;
+    this._draw(this.staticTime, 0);
+  }
+
+  _draw(timeSec, flow) {
+    const gl = this.gl;
+    const w = this.canvas.width;
+    const h = this.canvas.height;
+    gl.viewport(0, 0, w, h);
+    gl.clearColor(0, 0, 0, 0);
+    gl.clear(gl.COLOR_BUFFER_BIT);
+
+    gl.useProgram(this.program);
+    gl.bindVertexArray(this.vao);
+    gl.uniform2f(this.uni.uRes, w, h);
+    gl.uniform1f(this.uni.uAspect, w / h);
+    gl.uniform1f(this.uni.uTime, timeSec);
+    gl.uniform1f(this.uni.uScroll, this.scroll);
+    gl.uniform1fv(this.uni.uBounds, this.bounds);
+    gl.uniform4fv(this.uni.uCurve, this.curve);
+    gl.uniform4f(this.uni.uPointer, this.pointer.x, this.pointer.y, this.pointer.strength, 0);
+    gl.uniform1f(this.uni.uFlow, flow);
+    gl.uniform1f(this.uni.uSizePx, this.sizeBase * this.dpr);
+    gl.drawArraysInstanced(gl.TRIANGLE_STRIP, 0, 4, this.count);
+    gl.bindVertexArray(null);
+  }
+
+  _watchQuality(dt) {
+    this.frames++;
+    if (this.frames < 120) return;
+    this.ema = this.ema * 0.96 + dt * 1000 * 0.04;
+    if (this.ema > 23 && this.qualityStep === 0) {
+      this.qualityStep = 1;
+      this.dprCap = Math.min(this.dprCap, 1.25);
+      this.ema = 16;
+      this.resize();
+    } else if (this.ema > 23 && this.qualityStep === 1 && this.frames > 420) {
+      this.qualityStep = 2;
+      this.count = Math.max(Math.floor(this.count * 0.55), 2200);
+      this.ema = 16;
+    }
+  }
+
+  destroy() {
+    this.stop();
+    this.canvas.removeEventListener("webglcontextlost", this._onContextLost);
+    this.canvas.removeEventListener("webglcontextrestored", this._onContextRestored);
+    const gl = this.gl;
+    if (gl) {
+      const ext = gl.getExtension("WEBGL_lose_context");
+      if (ext) ext.loseContext();
+    }
+    this.gl = null;
+  }
+}
