+  transform: rotate(45deg);
+  box-shadow: 0 0 18px rgba(245, 184, 69, 0.7);
+}
+.ce-play {
+  padding: 0.5rem 1.1rem;
+  border: 1px solid var(--solar);
+  border-radius: 999px;
+  background: none;
+  color: var(--solar);
+  font-family: var(--font-mono);
+  font-size: 0.64rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
