+  transition: color 150ms ease, border-color 150ms ease;
+}
+.link-quiet:hover { color: var(--solar); border-color: var(--solar); }
+
+/* ————— Footer ————— */
+.site-footer {
+  position: relative;
+  z-index: 20;
+  background: linear-gradient(180deg, rgba(5, 7, 15, 0) 0%, var(--night-0) 8rem);
+  padding: 10rem var(--hud-x) 7rem;
+}
+.footer-inner {
+  max-width: 62rem;
+  margin: 0 auto;
+  border-top: 1px solid var(--line);
+  padding-top: 2.6rem;
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 2rem;
+  align-items: start;
+}
+.footer-inner p { margin: 0; }
+.colophon {
+  max-width: 34rem;
+  font-size: 0.82rem;
+  line-height: 1.7;
+  color: var(--faint);
+}
+.colophon b { color: var(--muted); font-weight: 500; }
+.footer-meta {
+  text-align: right;
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--faint);
+  line-height: 2.1;
+}
+.footer-meta a { text-decoration: none; }
+.footer-meta a:hover { color: var(--solar); }
+@media (max-width: 720px) {
+  .footer-inner { grid-template-columns: 1fr; }
+  .footer-meta { text-align: left; }
+}
+
+/* ————— Reveals (motion only when welcome) ————— */
+@media (prefers-reduced-motion: no-preference) {
+  .js .reveal {
+    opacity: 0;
+    translate: 0 16px;
+    transition: opacity 700ms ease, translate 700ms cubic-bezier(0.22, 1, 0.36, 1);
+  }
+  .js .reveal.in { opacity: 1; translate: 0 0; }
+}
+
+/* ————— Reduced motion: the calm edition ————— */
+@media (prefers-reduced-motion: reduce) {
+  .tl-fill, .tl-caret, .playhead { transition: none; }
+  .ce-dot { box-shadow: none; }
+}
+
+@media (max-width: 720px) {
+  .block { padding: 1.5rem 1.4rem; }
+  .stage { padding: 5.2rem 1.1rem 6.4rem; }
+  .featrow { grid-template-columns: 1fr; gap: 0.2rem; }
+  h1.headline { font-size: clamp(2.6rem, 11.5vw, 3.6rem); }
+  h2.headline { font-size: clamp(1.9rem, 8vw, 2.6rem); }
+}
