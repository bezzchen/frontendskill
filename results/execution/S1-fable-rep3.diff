+@media (prefers-reduced-motion: no-preference) {
+  .btn-solar:hover { transform: translateY(-2px); }
+  .btn-solar:active { transform: translateY(0); }
+}
+.cta-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: center;
+  gap: 1.4rem;
+  margin-top: 2.4rem;
+}
+.link-quiet {
+  font-family: var(--font-mono);
+  font-size: 0.78rem;
+  letter-spacing: 0.06em;
+  color: var(--muted);
