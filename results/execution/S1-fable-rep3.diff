diff --git a/lib/curve.js b/lib/curve.js
new file mode 100644
index 0000000..aeda7b9
--- /dev/null
+++ b/lib/curve.js
@@ -0,0 +1,71 @@
+/*
+ * The one curve that runs the whole page.
+ * Edited in the Act 02 editor, rendered by the WebGL river,
+ * and compiled into the Act 03 export. A tiny external store so
+ * React components and the engine can all subscribe.
+ */
+
+let state = { x1: 0.34, y1: 1.4, x2: 0.24, y2: 1 };
+const subs = new Set();
+
+export const PRESETS = [
+  { id: "linear", label: "Linear", v: { x1: 0.333, y1: 0.333, x2: 0.667, y2: 0.667 } },
+  { id: "glide", label: "Glide", v: { x1: 0.16, y1: 1, x2: 0.3, y2: 1 } },
+  { id: "snap", label: "Snap", v: { x1: 0.9, y1: 0, x2: 0.1, y2: 1 } },
+  { id: "meridian", label: "Meridian", v: { x1: 0.34, y1: 1.4, x2: 0.24, y2: 1 } },
+];
+
+export const curveStore = {
+  get: () => state,
+  set(next) {
+    state = {
+      x1: clamp(next.x1, 0, 1),
+      y1: clamp(next.y1, -0.6, 1.7),
+      x2: clamp(next.x2, 0, 1),
+      y2: clamp(next.y2, -0.6, 1.7),
+    };
+    subs.forEach((fn) => fn(state));
+  },
+  subscribe(fn) {
+    subs.add(fn);
+    return () => subs.delete(fn);
+  },
+};
+
+function clamp(v, lo, hi) {
+  return Math.min(hi, Math.max(lo, Number.isFinite(v) ? v : lo));
+}
+
+export function fmt(v) {
+  const r = Math.round(v * 100) / 100;
+  return String(r);
+}
+
+export function cssBezier(c) {
+  return `cubic-bezier(${fmt(c.x1)}, ${fmt(c.y1)}, ${fmt(c.x2)}, ${fmt(c.y2)})`;
+}
+
+/* Solve progress = Y(t) where X(t) = x, like the CSS engine does. */
+export function easeAt(x, c) {
+  if (x <= 0) return 0;
+  if (x >= 1) return 1;
+  let t = x;
+  for (let i = 0; i < 8; i++) {
+    const cx = bez(t, c.x1, c.x2) - x;
+    const dx = bezD(t, c.x1, c.x2);
+    if (Math.abs(cx) < 1e-5) break;
+    if (Math.abs(dx) < 1e-6) break;
+    t -= cx / dx;
+    t = Math.min(1, Math.max(0, t));
+  }
+  return bez(t, c.y1, c.y2);
+}
+
+function bez(t, p1, p2) {
+  const it = 1 - t;
+  return 3 * it * it * t * p1 + 3 * it * t * t * p2 + t * t * t;
+}
+function bezD(t, p1, p2) {
+  const it = 1 - t;
+  return 3 * it * it * p1 + 6 * it * t * (p2 - p1) + 3 * t * t * (1 - p2);
+}
