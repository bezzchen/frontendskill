+  justify-self: end;
+  padding: 1.3rem;
+  border: 1px solid var(--line);
+  border-radius: 1.2rem;
+  background: rgba(7, 10, 21, 0.82);
+}
+.ce-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: 0.3rem 1rem;
+  margin-bottom: 0.8rem;
+  font-family: var(--font-mono);
+  font-size: 0.64rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--faint);
+}
+.ce-plot { position: relative; touch-action: none; }
+.ce-plot svg { display: block; width: 100%; height: auto; }
+.ce-grid { stroke: var(--line-soft); stroke-width: 1; }
+.ce-frame { stroke: var(--line); stroke-width: 1; fill: none; }
+.ce-linear { stroke: rgba(156, 197, 222, 0.35); stroke-width: 1; stroke-dasharray: 3 5; }
+.ce-arm { stroke: rgba(239, 236, 227, 0.35); stroke-width: 1; }
+.ce-path { stroke: var(--solar); stroke-width: 2.5; fill: none; stroke-linecap: round; }
+.ce-end { fill: var(--paper); }
+.ce-handle {
+  position: absolute;
+  width: 44px;
+  height: 44px;
+  margin: -22px 0 0 -22px;
+  padding: 0;
+  background: none;
+  border: none;
+  cursor: grab;
+  touch-action: none;
+}
+.ce-handle:active { cursor: grabbing; }
+.ce-handle::after {
+  content: "";
+  position: absolute;
+  inset: 50%;
+  width: 13px;
+  height: 13px;
+  margin: -6.5px 0 0 -6.5px;
+  background: var(--night-0);
+  border: 2px solid var(--glass);
+  transform: rotate(45deg);
+  transition: background 150ms ease, scale 150ms ease;
+}
+.ce-handle:hover::after, .ce-handle:focus-visible::after { background: var(--glass); scale: 1.15; }
+.ce-readout {
+  display: block;
+  font-family: var(--font-mono);
+  font-size: 0.72rem;
+  letter-spacing: 0;
+  text-transform: none;
+  color: var(--glass);
+  font-variant-numeric: tabular-nums;
+}
+.ce-actions {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 0.6rem;
+  margin-top: 0.9rem;
+}
+.ce-presets { display: flex; flex-wrap: wrap; gap: 0.5rem; }
+.ce-chip {
+  padding: 0.42rem 0.85rem;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: none;
+  color: var(--muted);
+  font-family: var(--font-mono);
+  font-size: 0.62rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  cursor: pointer;
+  transition: color 150ms ease, border-color 150ms ease;
+}
+.ce-chip:hover { color: var(--paper); border-color: var(--paper); }
+.ce-chip[aria-pressed="true"] { color: #171006; background: var(--solar); border-color: var(--solar); }
+
+.ce-track {
+  position: relative;
+  height: 34px;
+  margin-top: 1.1rem;
+  border-top: 1px solid var(--line-soft);
+  padding-top: 12px;
+}
+.ce-ghost {
