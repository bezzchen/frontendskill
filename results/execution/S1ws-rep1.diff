index 0000000..332eed1
--- /dev/null
+++ b/lib/spring.js
@@ -0,0 +1,95 @@
+// One damped-spring solution is shared by everything on the page: the vertex shader that
+// draws the field, the CPU springs (pointer ring, playhead smoothing, keyframe settling),
+// and the code the visitor exports. Same math, three hosts.
+
+export function springParams({ stiffness, damping, mass = 1 }) {
+  const omega = Math.sqrt(stiffness / mass);
+  const zeta = damping / (2 * Math.sqrt(stiffness * mass));
+  return { omega, zeta };
+}
+
+// Free response of a damped harmonic oscillator toward 0, starting at displacement x0
+// with velocity v0. Handles under-, critically and over-damped cases.
+export function springResponse(tau, zeta, omega, x0 = 1, v0 = 0) {
+  if (tau <= 0) return x0;
+  if (zeta < 0.999) {
+    const wd = omega * Math.sqrt(1 - zeta * zeta);
+    return (
+      Math.exp(-zeta * omega * tau) *
+      (x0 * Math.cos(wd * tau) + ((v0 + zeta * omega * x0) / wd) * Math.sin(wd * tau))
+    );
+  }
+  if (zeta < 1.001) {
+    return Math.exp(-omega * tau) * (x0 + (v0 + omega * x0) * tau);
+  }
+  const s = omega * Math.sqrt(zeta * zeta - 1);
+  const r1 = -zeta * omega + s;
+  const r2 = -zeta * omega - s;
+  const B = (v0 - r1 * x0) / (r2 - r1);
+  const A = x0 - B;
+  return A * Math.exp(r1 * tau) + B * Math.exp(r2 * tau);
+}
+
+export function describeDamping(zeta) {
+  if (zeta < 0.35) return "bouncy";
+  if (zeta < 0.8) return "underdamped";
+  if (zeta < 1.05) return "critically damped";
+  return "overdamped";
+}
+
+// Time (s) for the envelope to fall under 1% (underdamped approximation).
+export function settleTime(zeta, omega) {
+  return 4.6 / Math.max(zeta * omega, 1e-3);
+}
+
+// A stateful spring for values animated on the CPU.
+export class SpringValue {
+  constructor(value = 0, params = { stiffness: 170, damping: 22, mass: 1 }) {
+    this.x = value;
+    this.v = 0;
+    this.target = value;
+    this.set(params);
+  }
+  set({ stiffness, damping, mass = 1 }) {
+    this.k = stiffness;
+    this.c = damping;
+    this.m = mass;
+  }
+  step(dt) {
+    const n = Math.min(8, Math.max(1, Math.ceil(dt / (1 / 120))));
+    const h = dt / n;
+    for (let i = 0; i < n; i++) {
+      const a = (-this.k * (this.x - this.target) - this.c * this.v) / this.m;
+      this.v += a * h;
+      this.x += this.v * h;
+    }
+    return this.x;
+  }
+  snap(value) {
+    this.x = value;
+    this.target = value;
+    this.v = 0;
+  }
+  get settled() {
+    return Math.abs(this.x - this.target) < 1e-4 && Math.abs(this.v) < 1e-3;
+  }
+}
+
+export const GLSL_SPRING = /* glsl */ `
+float springResponse(float tau, float zeta, float omega, float x0, float v0) {
+  if (tau <= 0.0) return x0;
+  if (zeta < 0.999) {
+    float wd = omega * sqrt(1.0 - zeta * zeta);
+    return exp(-zeta * omega * tau) * (x0 * cos(wd * tau) + ((v0 + zeta * omega * x0) / wd) * sin(wd * tau));
+  }
+  if (zeta < 1.001) {
+    return exp(-omega * tau) * (x0 + (v0 + omega * x0) * tau);
+  }
+  float s = omega * sqrt(zeta * zeta - 1.0);
+  float r1 = -zeta * omega + s;
+  float r2 = -zeta * omega - s;
+  float B = (v0 - r1 * x0) / (r2 - r1);
+  float A = x0 - B;
+  return A * exp(r1 * tau) + B * exp(r2 * tau);
+}
+`;
