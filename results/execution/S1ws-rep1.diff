--- /dev/null
+++ b/lib/acts.js
@@ -0,0 +1,107 @@
+// Five acts on one timeline. Scroll position is the playhead.
+import { clamp01 } from "./document";
+
+export const ACTS = [
+  { id: "meridian", name: "Meridian", span: 0.2 },
+  { id: "timeline", name: "Timeline", span: 0.22 },
+  { id: "springs", name: "Springs", span: 0.22 },
+  { id: "ship", name: "Ship", span: 0.2 },
+  { id: "access", name: "Access", span: 0.16 },
+];
+
+// Scroll distance of the whole document, in viewport heights.
+export const SCROLL_VH = 900;
+
+export const BOUNDS = (() => {
+  let acc = 0;
+  const total = ACTS.reduce((s, a) => s + a.span, 0);
+  return ACTS.map((a) => {
+    const start = acc / total;
+    acc += a.span;
+    return { start, end: acc / total };
+  });
+})();
+
+// Where are we? Which layout are we leaving, which are we entering, how far along.
+// vhFrac is one viewport of scroll expressed in playhead units: the page turn between two
+// acts happens while one copy block slides out and the next slides in, so the field morphs
+// over that same window.
+export function resolve(t, vhFrac) {
+  let index = BOUNDS.findIndex((b) => t < b.end);
+  if (index < 0) index = ACTS.length - 1;
+  const b = BOUNDS[index];
+  const localFrom = clamp01((t - b.start) / (b.end - b.start));
+  let to = index;
+  let morph = 0;
+  if (index < ACTS.length - 1) {
+    const win = Math.min(vhFrac, (b.end - b.start) * 0.7);
+    const startMorph = b.end - win;
+    if (t > startMorph) {
+      to = index + 1;
+      morph = clamp01((t - startMorph) / win);
+    }
+  }
+  return { index, from: index, to, morph, localFrom, localTo: 0, current: morph > 0.5 ? to : index };
+}
+
+// Where the field lives on screen, as fractions of the viewport (y down). The DOM overlays
+// (keyframe handles, pointer ring, frame numbers) are positioned with the same numbers, so
+// what you drag is exactly where the points are.
+export const GEOMETRY = {
+  desktop: {
+    globe: { cx: 0.66, cy: 0.5, r: 0.32 },
+    tracks: { x0: 0.42, y0: 0.14, x1: 0.94, y1: 0.8 },
+    springs: { x0: 0.42, y0: 0.12, x1: 0.94, y1: 0.82 },
+    film: { x0: 0.05, y0: 0.1, x1: 0.95, y1: 0.36 },
+    lineX: 0.66,
+    frames: 24,
+  },
+  tablet: {
+    globe: { cx: 0.74, cy: 0.5, r: 0.24 },
+    tracks: { x0: 0.5, y0: 0.14, x1: 0.95, y1: 0.8 },
+    springs: { x0: 0.5, y0: 0.12, x1: 0.95, y1: 0.82 },
+    film: { x0: 0.04, y0: 0.1, x1: 0.96, y1: 0.34 },
+    lineX: 0.74,
+    frames: 24,
+  },
+  mobile: {
+    globe: { cx: 0.5, cy: 0.66, r: 0.24 },
+    tracks: { x0: 0.06, y0: 0.54, x1: 0.94, y1: 0.87 },
+    springs: { x0: 0.06, y0: 0.54, x1: 0.94, y1: 0.87 },
+    film: { x0: 0.03, y0: 0.44, x1: 0.97, y1: 0.56 },
+    lineX: 0.5,
+    frames: 12,
+  },
+};
+
+export const MOBILE_MAX = 767;
+export const TABLET_MAX = 1199;
+export const isMobileWidth = (w) => w <= MOBILE_MAX;
+export const geoFor = (w) => (w <= MOBILE_MAX ? GEOMETRY.mobile : w <= TABLET_MAX ? GEOMETRY.tablet : GEOMETRY.desktop);
+
+export function laneForAct(geo, act) {
+  if (act === 2) return geo.springs;
+  if (act === 3) return geo.film;
+  return geo.tracks;
+}
+
+// Viewport fractions -> stage space (x in [-aspect, aspect], y up in [-1, 1]).
+export function rectToStage(rect, aspect) {
+  return [(rect.x0 * 2 - 1) * aspect, -(rect.y1 * 2 - 1), (rect.x1 * 2 - 1) * aspect, -(rect.y0 * 2 - 1)];
+}
+
+// CSS custom properties generated from GEOMETRY so the DOM lanes share one source of truth.
+export function geometryCSS() {
+  const vars = (g) =>
+    [
+      ["tracks", g.tracks],
+      ["springs", g.springs],
+      ["film", g.film],
+    ]
+      .map(
+        ([n, r]) =>
+          `--${n}-x:${(r.x0 * 100).toFixed(2)}%;--${n}-y:${(r.y0 * 100).toFixed(2)}%;--${n}-w:${((r.x1 - r.x0) * 100).toFixed(2)}%;--${n}-h:${((r.y1 - r.y0) * 100).toFixed(2)}%;`
+      )
+      .join("") + `--globe-cx:${(g.globe.cx * 100).toFixed(2)}%;--globe-cy:${(g.globe.cy * 100).toFixed(2)}%;--globe-r:${(g.globe.r * 100).toFixed(2)}vh;--frames:${g.frames};`;
+  return `:root{${vars(GEOMETRY.desktop)}}@media (max-width:${TABLET_MAX}px){:root{${vars(GEOMETRY.tablet)}}}@media (max-width:${MOBILE_MAX}px){:root{${vars(GEOMETRY.mobile)}}}`;
+}
