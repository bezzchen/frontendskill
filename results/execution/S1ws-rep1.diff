@@ -0,0 +1,139 @@
+// The Meridian document this page is: four tracks, two keyframes each, one spring.
+// The visitor edits it in acts II and III; act IV prints it.
+import { springParams, springResponse } from "./spring";
+
+export const TRACKS = [
+  { id: "y", name: "Position", unit: "px", min: -40, max: 40, digits: 0 },
+  { id: "opacity", name: "Opacity", unit: "", min: 0, max: 1, digits: 2 },
+  { id: "scale", name: "Scale", unit: "", min: 0.8, max: 1.1, digits: 2 },
+  { id: "rotate", name: "Rotation", unit: "deg", min: -8, max: 8, digits: 1 },
+];
+
+export const DEFAULT_DOC = {
+  name: "reveal",
+  duration: 1.2,
+  spring: { stiffness: 170, damping: 16, mass: 1 },
+  keys: {
+    y: [
+      { t: 0.0, v: 40 },
+      { t: 0.62, v: 0 },
+    ],
+    opacity: [
+      { t: 0.04, v: 0 },
+      { t: 0.55, v: 1 },
+    ],
+    scale: [
+      { t: 0.0, v: 0.92 },
+      { t: 0.7, v: 1 },
+    ],
+    rotate: [
+      { t: 0.08, v: -6 },
+      { t: 0.66, v: 0 },
+    ],
+  },
+};
+
+export const clamp01 = (x) => Math.min(1, Math.max(0, x));
+export const norm = (track, v) => (v - track.min) / (track.max - track.min);
+export const denorm = (track, n) => track.min + n * (track.max - track.min);
+
+export function evalTrack(doc, id, x) {
+  const [k0, k1] = doc.keys[id];
+  if (x <= k0.t) return k0.v;
+  const seg = Math.max(k1.t - k0.t, 0.02);
+  const tau = ((x - k0.t) / seg) * doc.duration;
+  const { zeta, omega } = springParams(doc.spring);
+  return k1.v + (k0.v - k1.v) * springResponse(tau, zeta, omega, 1, 0);
+}
+
+export function sampleDoc(doc, n = 21) {
+  const out = [];
+  for (let i = 0; i < n; i++) {
+    const t = i / (n - 1);
+    out.push({
+      t,
+      y: evalTrack(doc, "y", t),
+      opacity: clamp01(evalTrack(doc, "opacity", t)),
+      scale: evalTrack(doc, "scale", t),
+      rotate: evalTrack(doc, "rotate", t),
+    });
+  }
+  return out;
+}
+
+const fmt = (v, d) => {
+  const s = Number(v).toFixed(d);
+  return /^-0(\.0+)?$/.test(s) ? s.slice(1) : s;
+};
+const pct = (t) => fmt(t * 100, 1).replace(/\.0$/, "");
+
+export function formatValue(track, v) {
+  return `${fmt(v, track.digits)}${track.unit ? " " + track.unit : ""}`;
+}
+
+export function toCSS(doc) {
+  const rows = sampleDoc(doc, 21).map(
+    (s) =>
+      `  ${pct(s.t)}% { transform: translateY(${fmt(s.y, 1)}px) scale(${fmt(s.scale, 3)}) rotate(${fmt(s.rotate, 2)}deg); opacity: ${fmt(s.opacity, 3)}; }`
+  );
+  return [
+    `/* ${doc.name}: ${doc.duration}s, spring ${doc.spring.stiffness}/${doc.spring.damping}, sampled every 5% */`,
+    `@keyframes ${doc.name} {`,
+    ...rows,
+    `}`,
+    ``,
+    `.${doc.name} {`,
+    `  animation: ${doc.name} ${doc.duration}s linear both;`,
+    `}`,
+    ``,
+    `@media (prefers-reduced-motion: reduce) {`,
+    `  .${doc.name} { animation: ${doc.name}-quiet 0.4s ease-out both; }`,
+    `}`,
+    `@keyframes ${doc.name}-quiet {`,
+    `  from { opacity: 0; }`,
+    `  to { opacity: 1; }`,
+    `}`,
+  ].join("\n");
+}
+
+export function toJS(doc) {
+  const k = doc.keys;
+  const key = (id) => `[[${fmt(k[id][0].t, 2)}, ${k[id][0].v}], [${fmt(k[id][1].t, 2)}, ${k[id][1].v}]]`;
+  return [
+    `// ${doc.name}: plain JavaScript, no dependencies, no runtime.`,
+    `const spring = (k, c, m = 1) => {`,
+    `  const w = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m));`,
+    `  const wd = w * Math.sqrt(Math.max(1 - z * z, 1e-6));`,
+    `  return (t) => Math.exp(-z * w * t) * (Math.cos(wd * t) + (z * w / wd) * Math.sin(wd * t));`,
+    `};`,
+    ``,
+    `const ease = spring(${doc.spring.stiffness}, ${doc.spring.damping}, ${doc.spring.mass});`,
+    `const duration = ${doc.duration};`,
+    `const tracks = {`,
+    `  y: ${key("y")},`,
+    `  opacity: ${key("opacity")},`,
+    `  scale: ${key("scale")},`,
+    `  rotate: ${key("rotate")},`,
+    `};`,
+    ``,
+    `const at = ([a, b], t) =>`,
+    `  t <= a[0] ? a[1] : b[1] + (a[1] - b[1]) * ease(((t - a[0]) / Math.max(b[0] - a[0], 0.02)) * duration);`,
+    ``,
+    `// Call with progress 0..1, from your own loop, scroll position, or gesture.`,
+    `export function ${doc.name}(el, t) {`,
+    `  el.style.transform = \`translateY(\${at(tracks.y, t)}px) scale(\${at(tracks.scale, t)}) rotate(\${at(tracks.rotate, t)}deg)\`;`,
+    `  el.style.opacity = Math.min(1, Math.max(0, at(tracks.opacity, t)));`,
+    `}`,
+  ].join("\n");
+}
+
+// The page is a 24-second document at 24 fps.
+export const DOC_SECONDS = 24;
+export const FPS = 24;
+const pad = (n) => String(n).padStart(2, "0");
+export function timecode(t) {
+  const total = Math.round(clamp01(t) * DOC_SECONDS * FPS);
+  const f = total % FPS;
+  const s = Math.floor(total / FPS);
+  return `00:00:${pad(s)}:${pad(f)}`;
+}
