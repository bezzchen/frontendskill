+"use client";
+import { useCallback, useEffect, useState } from "react";
+
+const KEY = "meridian.motion";
+const QUERY = "(prefers-reduced-motion: reduce)";
+
+// The visitor's motion preference: the OS setting by default, overridable on the page.
+// The page's own reduced variant is designed, not stripped, so the override is safe both ways.
+export function useMotionPreference() {
+  const [pref, setPref] = useState("auto");
+  const [system, setSystem] = useState(false);
+  const [ready, setReady] = useState(false);
+
+  useEffect(() => {
+    const mq = window.matchMedia(QUERY);
+    setSystem(mq.matches);
+    try {
+      const saved = window.localStorage.getItem(KEY);
+      if (saved === "full" || saved === "reduced") setPref(saved);
+    } catch {}
+    const onChange = (e) => setSystem(e.matches);
+    mq.addEventListener("change", onChange);
+    setReady(true);
+    return () => mq.removeEventListener("change", onChange);
+  }, []);
+
+  const reduced = pref === "reduced" || (pref === "auto" && system);
+
+  useEffect(() => {
+    if (!ready) return;
+    document.documentElement.dataset.motion = reduced ? "reduced" : "full";
+  }, [reduced, ready]);
+
+  const set = useCallback((next) => {
+    setPref(next);
+    try {
+      if (next === "auto") window.localStorage.removeItem(KEY);
+      else window.localStorage.setItem(KEY, next);
+    } catch {}
+  }, []);
+
+  return { pref, reduced, set, ready, system };
+}
diff --git a/lib/spring.js b/lib/spring.js
