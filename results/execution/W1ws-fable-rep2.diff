@@ -0,0 +1,305 @@
+// ---------------------------------------------------------------
+// Meridian timeline engine.
+// One owner for every per-frame concern on the page.
+//
+// Demand-driven rAF: the loop runs ONLY while one of these holds
+//   - the lerped playhead has not settled on its target
+//   - play mode is advancing the scroll
+//   - an ambient effect is registered AND its surface is on screen
+//     AND the document is visible AND reduced motion is off
+// Otherwise the loop is fully cancelled (verifiable via
+// window.__meridian.frames freezing).
+// ---------------------------------------------------------------
+
+export const FILM_SECONDS = 24;
+export const FILM_FPS = 60;
+
+const isBrowser = typeof window !== "undefined";
+
+const S = {
+  inited: false,
+  target: 0,        // scroll fraction 0..1 (truth from scrollY)
+  current: 0,       // lerped display value handed to subscribers
+  playing: false,
+  playY: 0,         // float scroll position while playing
+  rm: false,        // prefers-reduced-motion
+  raf: 0,
+  running: false,
+  lastTs: 0,
+  now: 0,
+  docH: 1,
+  vh: 1,
+  scrollable: 1,
+  mv: 0,            // measure version (bumped on re-measure)
+  scenes: [],       // { id, el, startT, endT, topY, height }
+  subs: new Set(),
+  ambient: new Set(), // string keys registered by components
+  meter: null,        // window.__meridian instrumentation
+};
+
+function clamp01(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
+
+function measure() {
+  S.vh = window.innerHeight;
+  S.docH = Math.max(1, document.documentElement.scrollHeight);
+  S.scrollable = Math.max(1, S.docH - S.vh);
+  const els = document.querySelectorAll("[data-scene]");
+  S.scenes = Array.from(els).map((el) => {
+    const r = el.getBoundingClientRect();
+    const topY = r.top + window.scrollY;
+    return {
+      id: el.dataset.scene,
+      el,
+      topY,
+      height: r.height,
+      startT: clamp01(topY / S.docH),
+      endT: clamp01((topY + r.height) / S.docH),
+    };
+  });
+  S.mv++;
+  S.target = clamp01(window.scrollY / S.scrollable);
+}
+
+function ambientAllowed() {
+  return S.ambient.size > 0 && !document.hidden && !S.rm;
+}
+
+function payload() {
+  return {
+    t: S.current,
+    seconds: S.current * FILM_SECONDS,
+    playing: S.playing,
+    now: S.now,
+    scenes: S.scenes,
+    mv: S.mv,
+    rm: S.rm,
+  };
+}
+
+function emit() {
+  const p = payload();
+  S.subs.forEach((fn) => fn(p));
+}
+
+function frame(ts) {
+  const dt = Math.min(0.05, S.lastTs ? (ts - S.lastTs) / 1000 : 1 / 60);
+  S.lastTs = ts;
+  S.now = ts / 1000;
+
+  if (S.playing) {
+    // Live-read the scroll ceiling: cached values can flap during
+    // transient viewport resizes, and a false ceiling must clamp the
+    // playhead, not end the film.
+    const maxY = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
+    S.playY = Math.min(S.playY + (maxY / FILM_SECONDS) * dt, maxY);
+    window.scrollTo({ top: S.playY, behavior: "auto" });
+    S.target = clamp01(S.playY / maxY);
+    if (maxY - S.playY < 0.5) {
+      S.endStreak = (S.endStreak || 0) + 1;
+      if (S.endStreak > 5) {
+        S.playing = false;
+        S.endStreak = 0;
+        if (S.meter) S.meter.lastPause = `film-end @ ${Math.round(performance.now())}`;
+        notifyPlayState();
+      }
+    } else {
+      S.endStreak = 0;
+    }
+  }
+
+  const k = S.rm ? 1 : 1 - Math.exp(-dt * 9.5);
+  S.current += (S.target - S.current) * k;
+  if (Math.abs(S.target - S.current) < 0.00012) S.current = S.target;
+
+  emit();
+
+  if (S.meter) {
+    S.meter.frames++;
+    S.meter.t = S.current;
+    S.meter.playing = S.playing;
+    S.meter.ambient = S.ambient.size;
+    S.meter.running = true;
+  }
+
+  const settled = S.current === S.target && !S.playing;
+  if (!settled || ambientAllowed()) {
+    S.raf = requestAnimationFrame(frame);
+  } else {
+    S.running = false;
+    S.lastTs = 0;
+    if (S.meter) S.meter.running = false;
+  }
+}
+
+function ensure() {
+  if (!isBrowser || S.running) return;
+  S.running = true;
+  S.lastTs = 0;
+  S.raf = requestAnimationFrame(frame);
+}
+
+function halt() {
+  if (S.raf) cancelAnimationFrame(S.raf);
+  S.running = false;
+  S.lastTs = 0;
+  if (S.meter) S.meter.running = false;
+}
+
+const playSubs = new Set();
+function notifyPlayState() {
+  if (S.meter) S.meter.playing = S.playing;
+  playSubs.forEach((fn) => fn(S.playing));
+}
+
+// ---- public api -------------------------------------------------
+
+export const engine = {
+  init() {
+    if (!isBrowser || S.inited) return;
+    S.inited = true;
+
+    const rmq = window.matchMedia("(prefers-reduced-motion: reduce)");
+    S.rm = rmq.matches;
+    rmq.addEventListener("change", () => {
+      S.rm = rmq.matches;
+      if (S.rm && S.playing) engine.pause("rm-change");
+      S.current = S.target;
+      ensure();
+    });
+
+    S.meter = { frames: 0, stageWrites: 0, running: false, playing: false, ambient: 0, t: 0 };
+    window.__meridian = S.meter;
+
+    measure();
+    S.current = S.target;
+
+    window.addEventListener("scroll", () => {
+      S.target = clamp01(window.scrollY / S.scrollable);
+      ensure();
+    }, { passive: true });
+
+    window.addEventListener("resize", () => {
+      if (S.meter) {
+        S.meter.resizeLog = S.meter.resizeLog || [];
+        S.meter.resizeLog.push([Math.round(performance.now()), window.innerWidth, window.innerHeight]);
+        if (S.meter.resizeLog.length > 40) S.meter.resizeLog.shift();
+      }
+      measure();
+      ensure();
+    });
+
+    if ("ResizeObserver" in window) {
+      const ro = new ResizeObserver(() => { measure(); ensure(); });
+      ro.observe(document.body);
+    }
+    if (document.fonts && document.fonts.ready) {
+      document.fonts.ready.then(() => { measure(); ensure(); });
+    }
+
+    // Continuous animation must stop the moment the document hides.
+    document.addEventListener("visibilitychange", () => {
+      if (document.hidden) {
+        if (S.playing) {
+          S.playing = false;
+          if (S.meter) S.meter.lastPause = `hidden @ ${Math.round(performance.now())}`;
+          notifyPlayState();
+        }
+        halt();
+      } else {
+        ensure(); // resumes only if there is real work; else it stops itself
+      }
+    });
+
+    // Any manual input interrupts play mode, like a real editor.
+    const interrupt = (e) => { if (S.playing) engine.pause(`interrupt:${e.type}`); };
+    window.addEventListener("wheel", interrupt, { passive: true });
+    window.addEventListener("touchstart", interrupt, { passive: true });
+    window.addEventListener("keydown", (e) => {
+      if (!S.playing) return;
+      const scrollKeys = ["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"];
+      if (scrollKeys.includes(e.key)) engine.pause(`interrupt:key:${e.key}`);
+    });
+
+    ensure();
+  },
+
+  subscribe(fn) {
+    S.subs.add(fn);
+    if (S.inited) fn(payload());
+    return () => S.subs.delete(fn);
+  },
+
+  onPlayState(fn) {
+    playSubs.add(fn);
+    fn(S.playing);
+    return () => playSubs.delete(fn);
+  },
+
+  sceneProgress(id, t) {
+    const sc = S.scenes.find((s) => s.id === id);
+    if (!sc || sc.height <= 0) return 0;
+    return clamp01((t * S.docH - sc.topY) / sc.height);
+  },
+
+  seconds() { return S.current * FILM_SECONDS; },
+  reducedMotion() { return S.rm; },
+  measureVersion() { return S.mv; },
+
+  seekT(t, smooth) {
+    const y = clamp01(t) * S.scrollable;
+    window.scrollTo({ top: y, behavior: smooth && !S.rm ? "smooth" : "auto" });
+    ensure();
+  },
+
+  seekSeconds(sec, smooth) {
+    engine.seekT(sec / FILM_SECONDS, smooth);
+  },
+
+  play() {
+    if (S.rm || S.playing || !isBrowser) return;
+    // At the end of the film, play restarts from the top like an editor.
+    if (S.target > 0.995) {
+      window.scrollTo({ top: 0, behavior: "auto" });
+      S.target = 0;
+      S.current = 0;
+    }
+    S.playY = window.scrollY;
+    S.playing = true;
+    notifyPlayState();
+    ensure();
+  },
+
+  pause(reason) {
+    if (!S.playing) return;
+    S.playing = false;
+    if (S.meter) S.meter.lastPause = `${reason || "api"} @ ${Math.round(performance.now())}`;
+    notifyPlayState();
+  },
+
+  toggle() { S.playing ? engine.pause("toggle") : engine.play(); },
+
+  // Ambient effects (e.g. the stage idle loop) register here. The
+  // loop only stays alive for them while allowed; callers must also
+  // gate on their own IntersectionObserver visibility.
+  setAmbient(key, active) {
+    if (active) S.ambient.add(key); else S.ambient.delete(key);
+    if (S.meter) S.meter.ambient = S.ambient.size;
+    if (active) ensure();
+  },
+
+  countStageWrite() {
+    if (S.meter) S.meter.stageWrites++;
+  },
+};
+
+export function formatTimecode(seconds) {
+  const s = Math.max(0, seconds);
+  const mm = String(Math.floor(s / 60)).padStart(2, "0");
+  const ss = String(Math.floor(s % 60)).padStart(2, "0");
+  const ff = String(Math.floor((s % 1) * FILM_FPS)).padStart(2, "0");
+  return `00:${mm}:${ss}:${ff}`;
+}
+
+export function easeInOutCubic(x) {
+  return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
+}
