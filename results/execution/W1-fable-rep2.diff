diff --git a/app/globals.css b/app/globals.css
index 6529d42..e85e188 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -1,26 +1,1329 @@
 @import "tailwindcss";
 
+/* ============================================================
+   Meridian launch — design tokens
+   The page plays a Meridian editor session: blue-graphite room,
+   vermilion playhead, amber keyframes, four pastel track chips,
+   and warm paper reserved for the one thing you ship.
+   ============================================================ */
+
 :root {
-  color-scheme: light dark;
-  --background: #f5f5f3;
-  --foreground: #161616;
-  --muted: #6b6b66;
-  --surface: #ffffff;
-  --line: #deded8;
+  color-scheme: dark;
+
+  --ink: #0b0c11; /* page ground */
+  --stage: #0f1016; /* editor canvas */
+  --panel: #161822; /* editor chrome */
+  --panel-2: #12141d; /* timeline chrome */
+  --line: #2a2e3d;
+  --line-soft: color-mix(in oklab, var(--line) 60%, transparent);
+
+  --text: #e9ebf2;
+  --muted: #9aa3b8;
+  --dim: #6e7690;
+
+  --paper: #f4f0e6; /* the exported artifact */
+  --paper-ink: #241f15;
+  --paper-line: #d8d2be;
+
+  --play: #ff4b26; /* playhead vermilion */
+  --play-ink: #1a0f08;
+  --key: #ffc148; /* keyframe amber */
+
+  --c-teal: #63d8c7;
+  --c-lilac: #bca9ff;
+  --c-sky: #82baff;
+  --c-moss: #a9cf8b;
+
+  --font-display: "Bricolage Grotesque Variable", "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
+  --font-body: "Archivo Variable", "Archivo", ui-sans-serif, system-ui, "Helvetica Neue", Arial, sans-serif;
+  --font-mono: "Spline Sans Mono Variable", "Spline Sans Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
+}
+
+/* ---------- base ---------- */
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  background: var(--ink);
+  color: var(--text);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  html {
+    scroll-behavior: smooth;
+  }
+}
+
+body {
+  margin: 0;
+  font-family: var(--font-body);
+  font-size: 1rem;
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+a {
+  color: inherit;
+}
+
+button,
+input {
+  font: inherit;
+}
+
+::selection {
+  background: color-mix(in oklab, var(--key) 80%, transparent);
+  color: var(--ink);
+}
+
+:focus-visible {
+  outline: 2px solid var(--key);
+  outline-offset: 2px;
+  border-radius: 3px;
+}
+
+[id] {
+  scroll-margin-top: 28px;
+}
+
+/* ============================================================
+   The editor window (hero)
+   ============================================================ */
+
+.editor {
+  display: flex;
+  flex-direction: column;
+  margin: 14px;
+  min-height: calc(100svh - 28px);
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 14px;
+  overflow: hidden;
+  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
+}
+
+/* ---------- menu bar (doubles as site header) ---------- */
+
+.menubar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  height: 54px;
+  padding: 0 14px 0 18px;
+  border-bottom: 1px solid var(--line);
+  background: var(--panel);
+  flex-shrink: 0;
+}
+
+.mb-brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+
+.mb-logo {
+  fill: var(--key);
+  flex-shrink: 0;
+}
+
+.mb-name {
+  font-family: var(--font-display);
+  font-weight: 650;
+  font-size: 1rem;
+  letter-spacing: 0.005em;
+}
+
+.mb-menus {
+  display: flex;
+  gap: 18px;
+  margin-left: 22px;
+  font-size: 0.84rem;
+  color: color-mix(in oklab, var(--muted) 72%, transparent);
+  cursor: default;
+  user-select: none;
+  white-space: nowrap;
+}
+
+.mb-nav {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.mb-nav a {
+  font-size: 0.87rem;
+  color: var(--muted);
+  text-decoration: none;
+  padding: 7px 11px;
+  border-radius: 7px;
+  white-space: nowrap;
+}
+
+.mb-nav a:hover {
+  color: var(--text);
+  background: rgba(255, 255, 255, 0.05);
+}
+
+.mb-nav .mb-cta {
+  color: #16130a;
+  background: var(--key);
+  font-weight: 600;
+  padding: 7px 14px;
+  border-radius: 8px;
+  margin-left: 6px;
+}
+
+.mb-nav .mb-cta:hover {
+  background: color-mix(in oklab, var(--key) 88%, white);
+  color: #16130a;
+}
+
+/* ---------- stage ---------- */
+
+.stage {
+  position: relative;
+  flex: 1;
+  display: flex;
+  align-items: center;
+  background:
+    radial-gradient(circle, rgba(233, 235, 242, 0.05) 1px, transparent 1.4px) center / 26px 26px,
+    var(--stage);
+  min-height: 400px;
+}
+
+.stage::before,
+.stage::after {
+  content: "";
+  position: absolute;
+  pointer-events: none;
+  opacity: 0.5;
+}
+
+.stage::before {
+  left: 50%;
+  top: 0;
+  bottom: 0;
+  width: 1px;
+  background: repeating-linear-gradient(
+    to bottom,
+    rgba(233, 235, 242, 0.07) 0 5px,
+    transparent 5px 12px
+  );
+}
+
+.stage::after {
+  top: 50%;
+  left: 0;
+  right: 0;
+  height: 1px;
+  background: repeating-linear-gradient(
+    to right,
+    rgba(233, 235, 242, 0.07) 0 5px,
+    transparent 5px 12px
+  );
+}
+
+.stage-meta {
+  position: absolute;
+  top: 12px;
+  left: 16px;
+  font-family: var(--font-mono);
+  font-size: 0.66rem;
+  letter-spacing: 0.06em;
+  color: var(--dim);
+  z-index: 3;
+}
+
+.stage-rm {
+  position: absolute;
+  top: 10px;
+  right: 14px;
+  margin: 0;
+  max-width: 320px;
+  text-align: right;
+  font-family: var(--font-mono);
+  font-size: 0.7rem;
+  line-height: 1.5;
+  color: var(--key);
+  z-index: 3;
+}
+
+.layers {
+  position: relative;
+  z-index: 2;
+  width: 100%;
+  max-width: 980px;
+  margin-inline: auto;
+  padding: clamp(56px, 10vh, 110px) clamp(26px, 6vw, 90px);
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 26px;
+}
+
+/* ---------- layers: selectable objects on the canvas ---------- */
+
+.layer {
+  position: relative;
+  width: fit-content;
+  max-width: 100%;
+}
+
+.layer-anim {
+  will-change: transform, opacity;
+}
+
+.layer-tag {
+  position: absolute;
+  top: -22px;
+  left: -2px;
+  font-family: var(--font-mono);
+  font-size: 0.66rem;
+  letter-spacing: 0.04em;
+  padding: 2px 7px;
+  border-radius: 5px;
+  background: var(--key);
+  color: #16130a;
+  opacity: 0;
+  pointer-events: none;
+  z-index: 4;
+  white-space: nowrap;
+}
+
+.layer-handles {
+  position: absolute;
+  inset: -7px -10px;
+  pointer-events: none;
+  opacity: 0;
+  z-index: 3;
+}
+
+.layer-handles i {
+  position: absolute;
+  width: 7px;
+  height: 7px;
+  background: var(--panel);
+  border: 1.5px solid var(--key);
+  border-radius: 1.5px;
+}
+
+.layer-handles i:nth-child(1) { top: -3px; left: -3px; }
+.layer-handles i:nth-child(2) { top: -3px; right: -3px; }
+.layer-handles i:nth-child(3) { bottom: -3px; left: -3px; }
+.layer-handles i:nth-child(4) { bottom: -3px; right: -3px; }
+
+.layer:hover .layer-tag,
+.layer.is-hl .layer-tag,
+.layer.is-selected .layer-tag {
+  opacity: 1;
+}
+
+.layer:hover .layer-handles,
+.layer.is-hl .layer-handles,
+.layer.is-selected .layer-handles {
+  opacity: 1;
+  box-shadow: 0 0 0 1px color-mix(in oklab, var(--key) 65%, transparent);
+  border-radius: 4px;
+}
+
+/* ---------- hero content (the animated document) ---------- */
+
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  margin: 0;
+  font-family: var(--font-mono);
+  font-size: 0.72rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--c-teal);
+  background: color-mix(in oklab, var(--c-teal) 10%, transparent);
+  border: 1px solid color-mix(in oklab, var(--c-teal) 35%, transparent);
+  border-radius: 999px;
+  padding: 7px 14px;
+}
+
+.badge-dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 999px;
+  background: var(--c-teal);
+}
+
+.headline {
+  margin: 0;
+  font-family: var(--font-display);
+  font-optical-sizing: auto;
+  font-weight: 740;
+  font-size: clamp(2.9rem, 6.4vw + 1rem, 5.6rem);
+  line-height: 0.97;
+  letter-spacing: -0.026em;
+  text-wrap: balance;
+  max-width: 14ch;
+}
+
+.headline em {
+  font-style: normal;
+  color: var(--key);
+}
+
+.subline {
+  margin: 0;
+  max-width: 44rem;
+  font-size: clamp(1.05rem, 0.45vw + 0.95rem, 1.28rem);
+  line-height: 1.6;
+  color: var(--muted);
+  text-wrap: pretty;
+}
+
+.cta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 12px;
+}
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  padding: 13px 22px;
+  border-radius: 10px;
+  font-weight: 600;
+  font-size: 0.98rem;
+  text-decoration: none;
+  border: 1px solid transparent;
+  cursor: pointer;
+  transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
+}
+
+.btn:hover {
+  transform: translateY(-1px);
+}
+
+.btn:active {
+  transform: translateY(0);
+}
+
+.btn-primary {
+  background: var(--play);
+  color: var(--play-ink);
+}
+
+.btn-primary:hover {
+  background: color-mix(in oklab, var(--play) 90%, white);
+}
+
+.btn-ghost {
+  background: transparent;
+  color: var(--text);
+  border-color: var(--line);
+}
+
+.btn-ghost:hover {
+  border-color: var(--muted);
+}
+
+.btn-ghost svg {
+  color: var(--muted);
+}
+
+/* ============================================================
+   The timeline (signature)
+   ============================================================ */
+
+.timeline {
+  border-top: 1px solid var(--line);
+  background: var(--panel-2);
+  flex-shrink: 0;
+  user-select: none;
+}
+
+.transport {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 48px;
+  padding: 0 12px;
+  border-bottom: 1px solid var(--line);
+}
+
+.tp-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  border-radius: 8px;
+  border: 1px solid var(--line);
+  background: var(--panel);
+  color: var(--text);
+  cursor: pointer;
+}
+
+.tp-btn:hover {
+  border-color: var(--muted);
+}
+
+.timecode {
+  font-family: var(--font-mono);
+  font-size: 0.76rem;
+  font-variant-numeric: tabular-nums;
+  color: var(--key);
+  min-width: 12.5ch;
+}
+
+.tp-file {
+  margin-left: auto;
+  font-family: var(--font-mono);
+  font-size: 0.7rem;
+  color: var(--dim);
+  letter-spacing: 0.02em;
+}
+
+.tp-export {
+  font-family: var(--font-mono);
+  font-size: 0.76rem;
+  color: var(--key);
+  background: color-mix(in oklab, var(--key) 10%, transparent);
+  border: 1px solid color-mix(in oklab, var(--key) 40%, transparent);
+  border-radius: 8px;
+  padding: 7px 13px;
+  cursor: pointer;
+}
+
+.tp-export:hover {
+  background: color-mix(in oklab, var(--key) 18%, transparent);
+}
+
+.tl-body {
+  display: grid;
+  grid-template-columns: 176px minmax(0, 1fr);
+}
+
+.tl-labels {
+  display: flex;
+  flex-direction: column;
+  padding-top: 28px; /* ruler height */
+  border-right: 1px solid var(--line);
+}
+
+.tl-label {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  height: 40px;
+  padding: 0 12px;
+  background: transparent;
+  border: none;
+  border-bottom: 1px solid var(--line-soft);
+  text-align: left;
+  cursor: pointer;
+  color: var(--text);
+}
+
+.tl-label:hover {
+  background: rgba(255, 255, 255, 0.035);
+}
+
+.tl-label.is-selected {
+  background: color-mix(in oklab, var(--key) 9%, transparent);
+  box-shadow: inset 2px 0 0 var(--key);
+}
+
+.tl-chip {
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  background: var(--tc);
+  flex-shrink: 0;
+}
+
+.tl-name {
+  font-family: var(--font-mono);
+  font-size: 0.78rem;
+}
+
+.tl-props {
+  margin-left: auto;
+  font-family: var(--font-mono);
+  font-size: 0.62rem;
+  color: var(--dim);
+  white-space: nowrap;
+}
+
+.tl-lanes {
+  position: relative;
+  touch-action: none;
+  cursor: ew-resize;
+  /* gutters keep the playhead handle visible at t=0 and t=end */
+  margin-left: 8px;
+  margin-right: 14px;
+}
+
+.ruler {
+  position: relative;
+  height: 28px;
+  border-bottom: 1px solid var(--line);
+}
+
+.ruler .tick {
+  position: absolute;
+  bottom: 0;
+  width: 1px;
+  height: 8px;
+  background: var(--line);
+}
+
+.ruler .tick.is-major {
+  height: 13px;
+  background: color-mix(in oklab, var(--muted) 55%, transparent);
+}
+
+.ruler .tick em {
+  position: absolute;
+  bottom: 13px;
+  left: 4px;
+  font-family: var(--font-mono);
+  font-style: normal;
+  font-size: 0.62rem;
+  color: var(--dim);
+}
+
+.ruler .tick.is-end em {
+  left: auto;
+  right: 12px;
+}
+
+.lane {
+  position: relative;
+  height: 40px;
+  border-bottom: 1px solid var(--line-soft);
+}
+
+.lane.is-selected {
+  background: color-mix(in oklab, var(--key) 5%, transparent);
+}
+
+.lane-name {
+  display: none;
+  position: absolute;
+  top: 3px;
+  left: 6px;
+  font-family: var(--font-mono);
+  font-size: 0.6rem;
+  color: var(--muted);
+  background: color-mix(in oklab, var(--ink) 72%, transparent);
+  padding: 1px 5px;
+  border-radius: 4px;
+  z-index: 3;
+}
+
+.clip {
+  position: absolute;
+  top: 8px;
+  bottom: 8px;
+  border-radius: 6px;
+  background: color-mix(in oklab, var(--tc) 16%, transparent);
+  border: 1px solid color-mix(in oklab, var(--tc) 45%, transparent);
+}
+
+.key {
+  position: absolute;
+  top: 50%;
+  width: 9px;
+  height: 9px;
+  margin: -4.5px 0 0 -4.5px;
+  transform: rotate(45deg);
+  background: var(--panel);
+  border: 1.5px solid var(--key);
+  border-radius: 1.5px;
+  z-index: 2;
+  transition: background-color 0.12s ease, box-shadow 0.12s ease;
+}
+
+.key.is-hit {
+  background: var(--key);
+  box-shadow: 0 0 9px color-mix(in oklab, var(--key) 55%, transparent);
+}
+
+.playhead {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 0;
+  width: 0;
+  z-index: 5;
+  pointer-events: none;
+}
+
+.ph-line {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: -0.75px;
+  width: 1.5px;
+  background: var(--play);
+  box-shadow: 0 0 9px color-mix(in oklab, var(--play) 55%, transparent);
+}
+
+.ph-handle {
+  position: absolute;
+  top: 3px;
+  left: -7.5px;
+  width: 15px;
+  height: 19px;
+  background: var(--play);
+  clip-path: polygon(0 0, 100% 0, 100% 58%, 50% 100%, 0 58%);
+  pointer-events: auto;
+  cursor: ew-resize;
+}
+
+.ph-handle:focus-visible {
+  outline: 2px solid var(--key);
+  outline-offset: 3px;
+}
+
+.hint {
+  position: absolute;
+  top: 78px;
+  left: 56%;
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  letter-spacing: 0.05em;
+  color: var(--key);
+  background: color-mix(in oklab, var(--ink) 82%, transparent);
+  border: 1px solid color-mix(in oklab, var(--key) 45%, transparent);
+  border-radius: 999px;
+  padding: 5px 12px;
+  pointer-events: none;
+  opacity: 0;
+  z-index: 6;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .hint {
+    animation:
+      hint-in 0.45s ease 2.5s forwards,
+      hint-nudge 1.9s ease-in-out 2.95s infinite;
+  }
+}
+
+.editor[data-parked] .hint {
+  animation-play-state: paused, paused;
+}
+
+@keyframes hint-in {
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes hint-nudge {
+  0%, 100% { transform: translateX(0); }
+  50% { transform: translateX(9px); }
+}
+
+/* ---------- export drawer: the shipped artifact ---------- */
+
+.drawer {
+  display: grid;
+  grid-template-rows: 0fr;
+  opacity: 0;
+  transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
+}
+
+.drawer.is-open {
+  grid-template-rows: 1fr;
+  opacity: 1;
+}
+
+.drawer-inner {
+  overflow: hidden;
+  min-height: 0;
+  background: var(--paper);
+  color: var(--paper-ink);
+}
+
+.drawer-head {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 16px 20px 10px;
+}
+
+.drawer-title {
+  font-family: var(--font-mono);
+  font-size: 0.78rem;
+  font-weight: 700;
+}
+
+.drawer-title em {
+  font-style: normal;
+  font-weight: 400;
+  color: #857c60;
+}
+
+.drawer-copy {
+  margin-left: auto;
+  font-family: var(--font-mono);
+  font-size: 0.76rem;
+  background: #eae5d5;
+  border: 1px solid var(--paper-line);
+  color: var(--paper-ink);
+  border-radius: 8px;
+  padding: 6px 13px;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.drawer-copy:hover {
+  background: #e2dcc8;
+}
+
+.drawer-copy:focus-visible {
+  outline-color: #b23b12;
+}
+
+.drawer pre {
+  margin: 0;
+  padding: 6px 20px 22px;
+  max-height: 320px;
+  overflow: auto;
+  font-family: var(--font-mono);
+  font-size: 0.78rem;
+  line-height: 1.65;
+  color: #3a362c;
+  tab-size: 2;
+}
+
+/* ============================================================
+   Below the editor
+   ============================================================ */
+
+.bridge {
+  margin: 0;
+  padding: 20px 24px 0;
+  text-align: center;
+  font-family: var(--font-mono);
+  font-size: 0.74rem;
+  color: var(--dim);
+}
+
+.bridge strong {
+  color: var(--key);
+  font-weight: 500;
+}
+
+.section {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 118px 28px 30px;
+}
+
+.eyebrow {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 0 0 20px;
+  font-family: var(--font-mono);
+  font-size: 0.72rem;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--key);
+}
+
+.eyebrow-key {
+  width: 8px;
+  height: 8px;
+  background: var(--key);
+  transform: rotate(45deg);
+  border-radius: 1.5px;
+}
+
+.section h2 {
+  margin: 0 0 20px;
+  font-family: var(--font-display);
+  font-optical-sizing: auto;
+  font-weight: 720;
+  font-size: clamp(2rem, 3.2vw + 0.6rem, 3.4rem);
+  line-height: 1.02;
