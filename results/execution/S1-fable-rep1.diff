+  font-family: var(--f-mono); font-size: 0.7rem; letter-spacing: 0.05em;
+  background: transparent; border: 1px solid var(--line); border-radius: 7px;
+  color: var(--muted); padding: 8px 12px; cursor: pointer;
+  transition: color 160ms var(--page-ease), border-color 160ms var(--page-ease);
+}
+.hud-motion:hover { color: var(--text); border-color: var(--muted); }
+.hud-motion strong { color: var(--text); font-weight: 600; }
+
+/* ── responsive recipe ── */
+@media (max-width: 900px) {
+  .act-grid, .act-grid-rev { grid-template-columns: 1fr; }
+  .act-grid-rev .act-copy { order: 1; }
+  .act-grid-rev .instrument { order: 2; }
+  .spring-grid { grid-template-columns: 1fr; }
+  .puck-arena { min-height: 210px; }
+  /* mobile recipe: same field, HUD and instruments, but no pinning —
+     acts flow naturally so touch scrolling never nests */
+  html[data-motion="full"] .act { height: auto; }
+  html[data-motion="full"] .act-stage {
+    position: static; height: auto; display: block; overflow: visible;
+  }
+  html[data-motion="full"] .act-inner { padding: 96px 0 64px; }
+  html[data-motion="full"] .act-hero .act-inner { min-height: 88svh; display: flex; flex-direction: column; justify-content: center; }
+}
+
+@media (max-width: 760px) {
+  .hud { gap: 10px; padding: 8px 10px; }
+  .hud-meta, .hud-key, .hud-clip-name { display: none; }
+  .hud-clip { padding: 4px 6px; align-items: center; min-width: 0; }
+  .hud-clip-no { font-size: 0.62rem; }
+  .hud-timecode { font-size: 0.8rem; }
+  .hud-motion { padding: 7px 9px; font-size: 0.62rem; }
+  .site-head { padding: 14px 16px; }
+  .slate { flex-direction: column; gap: 4px; }
+}
+
+/* very short viewports: give pinned stages breathing room */
+@media (max-height: 620px) {
+  html[data-motion="full"] .act-stage { align-items: flex-start; overflow-y: auto; }
+}
+
+/* ── no-JS / reduced-motion safety net via media query ── */
+@media (prefers-reduced-motion: reduce) {
+  html:not([data-motion="full"]) * {
+    animation-duration: 0.001s !important;
+    transition-duration: 0.001s !important;
+  }
+}
