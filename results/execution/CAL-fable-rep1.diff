+:is(html[data-motion="reduced"], html.no-js, html[data-gfx="off"]) [data-reveal] { opacity: 1; transform: none; transition: none; }
+
+html[data-motion="reduced"] *, html.no-js * {
+  transition-duration: 0.01ms !important;
+  animation-duration: 0.01ms !important;
+  scroll-behavior: auto !important;
+}
+
+html.no-js .stage-canvas, html.no-js .dock-play, html.no-js .dock-scrub { display: none; }
+
+/* ----------------------------------------------------------------- mobile */
+
+@media (max-width: 900px) {
+  :root { --dock-h: 78px; }
+  .act { padding-left: 18px; padding-right: 18px; align-items: flex-end; }
+  .act-overture, .act-begin { align-items: center; }
+  .act-grid, .act-grid-flip { display: flex; flex-direction: column; align-items: stretch; gap: 18px; }
+  .act-grid-flip > .copy { order: 1; }
+  .act-grid-flip > .aside { order: 2; }
+  .act-grid > .aside { justify-self: stretch; }
+  .panel { padding: 20px 22px; }
+  .copy:not(.panel) {
+    background: rgba(7, 11, 22, 0.78);
+    border: 1px solid var(--line-soft);
+    border-radius: 12px;
+    padding: 18px 20px;
+  }
+  .hdr { padding: 0 16px; }
+  .hdr .btn-cta { display: none; }
+  .dock { grid-template-columns: 128px minmax(0, 1fr); }
+  .dock-scene, .dock-tc .dur { display: none; }
+  .dock-transport { gap: 10px; padding: 0 10px 0 14px; }
+  .dock-lane-mini, .dock-fps { display: none; }
+  .dock-lanes { inset: 18px 0 6px 0; }
+  .dock-lane-scenes { height: 100%; }
+  .dock-clip { padding: 0 6px; }
+  .dock-clip .full { display: none; }
+  .dock-body { margin: 8px 12px 8px 10px; }
+  .dock-tick-label { display: none; }
+  .dock-tick-label.q { display: block; }
+  .code { font-size: 11px; }
+}
+
+@media (min-width: 1150px) {
+  .dock-lane-name { display: block; }
+  .dock-body { margin-left: 64px; }
+}
+
+/* late additions */
+:is(html[data-motion="reduced"], html.no-js, html[data-gfx="off"]) .live-only,
+html[data-motion="reduced"] .dock-play,
+html[data-gfx="off"] .dock-play,
+html[data-motion="reduced"] .dock-scrub,
+html[data-gfx="off"] .dock-scrub { display: none; }
