+          const avg = winSum / winN;
+          winSum = 0; winN = 0;
+          strikes = avg > 24 ? strikes + 1 : 0;
+          if (strikes >= 2 && tier < TIERS.length - 1) {
+            strikes = 0;
+            setTier(tier + 1);
+          }
+        }
+      }
+    }
+    draws = 0;
+
+    const W = canvas.width, H = canvas.height;
+    gl.viewport(0, 0, W, H);
+    const aspect = W / H;
+    perspective(proj, st.fov, aspect, 0.1, 100);
+
+    // pointer sway
+    const eye = st.camEye.slice(), tgt = st.camTgt.slice();
+    const fwd = norm3([tgt[0] - eye[0], tgt[1] - eye[1], tgt[2] - eye[2]]);
+    const right = norm3(cross3([0, 0, 0], fwd, [0, 1, 0]));
+    const sx = st.pointer[0], sy = st.pointer[1];
+    eye[0] += right[0] * sx * 0.35; eye[1] += sy * 0.22; eye[2] += right[2] * sx * 0.35;
+    tgt[0] -= right[0] * sx * 0.12; tgt[1] -= sy * 0.08; tgt[2] -= right[2] * sx * 0.12;
+    lookAt(view, eye, tgt, [0, 1, 0]);
+
+    const wOf = (i) => (st.actA === i ? 1 - st.mix : 0) + (st.actB === i ? st.mix : 0);
+    const w0 = wOf(0), w1 = wOf(1), w2 = wOf(2), w3 = wOf(3), w4 = wOf(4), w5 = wOf(5);
+    const playX = timeToX(st.scrub);
+    const ptScale = (H * 0.5) / Math.tan((st.fov * Math.PI) / 360) * 0.021;
+
+    gl.clear(gl.COLOR_BUFFER_BIT);
+
+    // sky
+    gl.disable(gl.BLEND);
+    gl.useProgram(pBg.p);
+    gl.bindVertexArray(vaoEmpty);
+    gl.uniform1f(pBg.uni.uAspect, aspect);
+    gl.uniform1f(pBg.uni.uBoot, st.boot);
+    gl.drawArrays(gl.TRIANGLES, 0, 3); draws++;
+
+    // floor
+    gl.enable(gl.BLEND);
+    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+    gl.useProgram(pGrid.p);
+    gl.uniformMatrix4fv(pGrid.uni.uProj, false, proj);
+    gl.uniformMatrix4fv(pGrid.uni.uView, false, view);
+    gl.uniform1f(pGrid.uni.uBoot, st.boot);
+    gl.uniform1f(pGrid.uni.uPlayX, playX);
+    gl.uniform1f(pGrid.uni.uSeam, w2 * 0.9 + w4 * 0.25);
+    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); draws++;
+
+    // additive pass
+    gl.blendFunc(gl.ONE, gl.ONE);
+
+    const rib = (mode, opts) => {
+      gl.useProgram(pRib.p);
+      gl.bindVertexArray(vaoRib);
+      gl.uniformMatrix4fv(pRib.uni.uProj, false, proj);
+      gl.uniformMatrix4fv(pRib.uni.uView, false, view);
+      gl.uniform1i(pRib.uni.uMode, mode);
+      gl.uniform2f(pRib.uni.uViewport, W, H);
+      gl.uniform1f(pRib.uni.uTime, st.time);
+      gl.uniform1f(pRib.uni.uWidth, (opts.width || 4) * dpr);
+      gl.uniform3fv(pRib.uni.uColor, opts.color);
+      gl.uniform1f(pRib.uni.uAlpha, opts.alpha);
+      gl.uniform1f(pRib.uni.uSoft, opts.soft ?? 1.6);
+      gl.uniform1f(pRib.uni.uShimmer, opts.shimmer ?? 0);
+      if (mode === 0) {
+        gl.uniform4fv(pRib.uni.uCurve, st.curve);
+        gl.uniform4fv(pRib.uni.uGraph, opts.graph);
+      } else if (mode === 1) {
+        gl.uniform3fv(pRib.uni.uP0, opts.p[0]);
+        gl.uniform3fv(pRib.uni.uP1, opts.p[1]);
+        gl.uniform3fv(pRib.uni.uP2, opts.p[2]);
+        gl.uniform3fv(pRib.uni.uP3, opts.p[3]);
+      } else if (mode === 2) {
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, waveTex);
+        gl.uniform1i(pRib.uni.uWave, 0);
+        gl.uniform1f(pRib.uni.uWaveHead, waveHead / WAVE_N);
+      }
+      gl.drawArrays(gl.TRIANGLE_STRIP, 0, ribCount); draws++;
+    };
+
+    const BRASS = [0.886, 0.655, 0.243], BEAM = [0.561, 0.847, 0.973], DIMC = [0.415, 0.47, 0.61];
+    const G = WORLD.GRAPH;
+    const graphMain = [G.cx, G.cy, G.sx, G.sy];
+
+    if (w0 > 0.01) {
+      const sweep = { p: [[-10, 0.4, -6], [-3, 1.8, -2], [3, -0.5, 2], [10, 0.9, -4]] };
+      rib(1, { ...sweep, width: 22, color: BEAM, alpha: 0.05 * w0 * st.boot, soft: 1.1 });
+      rib(1, { ...sweep, width: 2.6, color: BEAM, alpha: 0.5 * w0 * st.boot, soft: 2.2, shimmer: 0.5 });
+    }
+    if (w1 > 0.01) {
+      rib(0, { graph: graphMain, width: 26, color: BEAM, alpha: 0.07 * w1, soft: 1.1 });
+      rib(0, { graph: graphMain, width: 4.2, color: BEAM, alpha: 0.85 * w1, soft: 2.4, shimmer: 0.35 });
+    }
+    if (w3 > 0.01) {
+      rib(0, { graph: [-3.05, 0.62, 0.42, 0.42], width: 2.0, color: BEAM, alpha: 0.32 * w3, soft: 2.0 });
+    }
+    if (w2 > 0.01) {
+      for (let l = 0; l < 4; l++) {
+        const z = WORLD.LANE_Z0 + l * WORLD.LANE_DZ;
+        const y = WORLD.LANE_Y;
+        rib(1, {
+          p: [[-6, y, z], [-2, y, z], [2, y, z], [6, y, z]],
+          width: 1.6, color: DIMC, alpha: 0.85 * w2, soft: 1.4,
+        });
+      }
+      const bz = WORLD.LANE_Z0 + 1.5 * WORLD.LANE_DZ;
+      rib(1, {
+        p: [[playX, -0.62, bz], [playX, 0.2, bz], [playX, 1.0, bz], [playX, 1.9, bz]],
+        width: 20, color: BRASS, alpha: 0.15 * w2, soft: 1.1,
+      });
+      rib(1, {
+        p: [[playX, -0.62, bz], [playX, 0.2, bz], [playX, 1.0, bz], [playX, 1.9, bz]],
+        width: 2.4, color: BRASS, alpha: 0.9 * w2, soft: 2.2,
+      });
+    }
+    if (w4 > 0.01) {
+      rib(1, {
+        p: [[-5.2, 0.8, -1.2], [-1.7, 0.8, -1.2], [1.7, 0.8, -1.2], [5.2, 0.8, -1.2]],
+        width: 1.2, color: DIMC, alpha: 0.5 * w4, soft: 1.3,
+      }); // 16.7ms reference line
+      rib(2, { width: 18, color: BEAM, alpha: 0.06 * w4, soft: 1.1 });
+      rib(2, { width: 2.6, color: BEAM, alpha: 0.8 * w4, soft: 2.2 });
+    }
+
+    // keyframe diamonds
+    if (w2 > 0.01) {
+      gl.useProgram(pMarks.p);
+      gl.bindVertexArray(vaoMarks);
+      gl.uniformMatrix4fv(pMarks.uni.uProj, false, proj);
+      gl.uniformMatrix4fv(pMarks.uni.uView, false, view);
+      gl.uniform1f(pMarks.uni.uScrub, st.scrub);
+      gl.uniform1f(pMarks.uni.uPtScale, ptScale);
+      gl.uniform1f(pMarks.uni.uAlpha, w2);
+      gl.drawArrays(gl.POINTS, 0, dmd.length); draws++;
+    }
+
+    // particles
+    gl.useProgram(pPts.p);
+    gl.bindVertexArray(vaoPts);
+    gl.uniformMatrix4fv(pPts.uni.uProj, false, proj);
+    gl.uniformMatrix4fv(pPts.uni.uView, false, view);
+    gl.uniform1f(pPts.uni.uTime, st.time);
+    gl.uniform1f(pPts.uni.uScrub, st.scrub);
+    gl.uniform1f(pPts.uni.uBoot, st.boot);
+    gl.uniform1f(pPts.uni.uMix, st.mix);
+    gl.uniform1f(pPts.uni.uHasMix, st.actA !== st.actB ? 1 : 0);
+    gl.uniform1i(pPts.uni.uActA, st.actA);
+    gl.uniform1i(pPts.uni.uActB, st.actB);
+    gl.uniform1f(pPts.uni.uPlayX, playX);
+    gl.uniform1f(pPts.uni.uPuckU, st.puckU);
+    gl.uniform1f(pPts.uni.uPtScale, ptScale);
+    gl.uniform4fv(pPts.uni.uCurve, st.curve);
+    gl.uniform4fv(pPts.uni.uGraph, graphMain);
+    gl.uniform3fv(pPts.uni.uClips, clipArr);
+    gl.drawArrays(gl.POINTS, 0, ptsCount); draws++;
+
+    // evaluation comet
+    const puckA = w1 + (st.onion ? 0 : 0);
+    if (puckA > 0.01) {
+      gl.useProgram(pPuck.p);
+      gl.bindVertexArray(vaoEmpty);
+      gl.uniformMatrix4fv(pPuck.uni.uProj, false, proj);
+      gl.uniformMatrix4fv(pPuck.uni.uView, false, view);
+      gl.uniform4fv(pPuck.uni.uCurve, st.curve);
+      gl.uniform4fv(pPuck.uni.uGraph, graphMain);
+      gl.uniform1f(pPuck.uni.uPuckU, st.puckU);
+      gl.uniform1f(pPuck.uni.uOnion, st.onion ? 1 : 0);
+      gl.uniform1f(pPuck.uni.uPtScale, ptScale);
+      gl.uniform1fv(pPuck.uni.uOnionU, st.onionU);
+      gl.drawArrays(gl.POINTS, 0, 9); draws++;
+    }
+
+    stats.fps = Math.round(1000 / ms);
+    stats.ms = ms;
+    stats.draws = draws;
+    stats.count = ptsCount;
+    stats.tier = tier;
+  }
+
+  return {
+    setSize, setTier, frame, stats,
+    get tier() { return tier; },
+    resetClock() { prevNow = 0; },
+    dispose() {
+      try {
+        gl.getExtension("WEBGL_lose_context")?.loseContext();
+      } catch (e) {}
+    },
+  };
+}
