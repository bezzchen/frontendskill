+      gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, WAVE_N, 1, gl.RED, gl.FLOAT, wave);
+      if (warmup > 0) warmup--;
+      else if (dt < 45) {
+        // frames above 45ms are scheduler gaps (throttled tab), not render cost
