index 0000000..e020411
--- /dev/null
+++ b/lib/engine.js
@@ -0,0 +1,733 @@
+// ---------------------------------------------------------------------------
+// engine.js — a purpose-built WebGL2 renderer for the Meridian composition.
+// No library: one particle system, one ribbon system, a procedural stage,
+// and a quality governor. Everything moves on the GPU from uniforms only.
+// ---------------------------------------------------------------------------
+
+import { WORLD, DUR, timeToX, worldDiamonds, worldClips } from "./composition";
+
+// ---- tiny mat4 / vec3 -------------------------------------------------------
+
+function perspective(out, fovDeg, aspect, near, far) {
+  const f = 1 / Math.tan((fovDeg * Math.PI) / 360);
+  out.fill(0);
+  out[0] = f / aspect; out[5] = f;
+  out[10] = (far + near) / (near - far); out[11] = -1;
+  out[14] = (2 * far * near) / (near - far);
+  return out;
+}
+function norm3(v) { const l = Math.hypot(v[0], v[1], v[2]) || 1; v[0] /= l; v[1] /= l; v[2] /= l; return v; }
+function cross3(o, a, b) { o[0] = a[1] * b[2] - a[2] * b[1]; o[1] = a[2] * b[0] - a[0] * b[2]; o[2] = a[0] * b[1] - a[1] * b[0]; return o; }
+function dot3(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+function lookAt(out, eye, tgt, up) {
+  const z = norm3([eye[0] - tgt[0], eye[1] - tgt[1], eye[2] - tgt[2]]);
+  const x = norm3(cross3([0, 0, 0], up, z));
+  const y = cross3([0, 0, 0], z, x);
+  out[0] = x[0]; out[1] = y[0]; out[2] = z[0]; out[3] = 0;
+  out[4] = x[1]; out[5] = y[1]; out[6] = z[1]; out[7] = 0;
+  out[8] = x[2]; out[9] = y[2]; out[10] = z[2]; out[11] = 0;
+  out[12] = -dot3(x, eye); out[13] = -dot3(y, eye); out[14] = -dot3(z, eye); out[15] = 1;
+  return out;
+}
+
+// ---- GLSL -------------------------------------------------------------------
+
+const PALETTE = `
+const vec3 BRASS = vec3(0.886, 0.655, 0.243);
+const vec3 BEAM  = vec3(0.561, 0.847, 0.973);
+const vec3 PAPER = vec3(0.925, 0.906, 0.855);
+const vec3 DIM   = vec3(0.415, 0.470, 0.610);
+const vec3 RED   = vec3(1.0, 0.318, 0.278);
+`;
+
+const BEZ_GRAPH = `
+uniform vec4 uCurve;   // x1 y1 x2 y2 in graph space
+uniform vec4 uGraph;   // cx cy sx sy
+vec3 bezGraph(float u){
+  vec2 p0 = vec2(-1.0, -1.0);
+  vec2 p3 = vec2( 1.0,  1.0);
+  vec2 p1 = vec2(-1.0 + uCurve.x * 2.0, -1.0 + uCurve.y * 2.0);
+  vec2 p2 = vec2(-1.0 + uCurve.z * 2.0, -1.0 + uCurve.w * 2.0);
+  float v = 1.0 - u;
+  vec2 q = v*v*v*p0 + 3.0*v*v*u*p1 + 3.0*v*u*u*p2 + u*u*u*p3;
+  return vec3(uGraph.x + q.x * uGraph.z, uGraph.y + q.y * uGraph.w, 0.0);
+}
+`;
+
+const VS_BG = `#version 300 es
+out vec2 vUV;
+void main(){
+  vec2 p = vec2((gl_VertexID<<1 & 2), (gl_VertexID & 2));
+  vUV = p; gl_Position = vec4(p*2.0-1.0, 0.999, 1.0);
+}`;
+
+const FS_BG = `#version 300 es
+precision mediump float;
+in vec2 vUV; out vec4 o;
+uniform float uAspect; uniform float uBoot;
+float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898,78.233)))*43758.5453); }
+void main(){
+  vec3 deep = vec3(0.016, 0.024, 0.055);
