+  background: rgba(8, 12, 26, 0.93);
+}
+:is(html[data-motion="reduced"], html.no-js, html[data-gfx="off"]) .copy:not(.panel) {
+  background: rgba(8, 12, 26, 0.9);
+  border: 1px solid var(--line-soft);
+  border-radius: 12px;
+  padding: 22px 26px;
+}
+:is(html[data-motion="reduced"], html.no-js, html[data-gfx="off"]) .hint,
+:is(html[data-motion="reduced"], html.no-js, html[data-gfx="off"]) .dock-fps { display: none; }
