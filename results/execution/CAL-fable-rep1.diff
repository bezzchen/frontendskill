index 0000000..c368f01
--- /dev/null
+++ b/lib/composition.js
@@ -0,0 +1,215 @@
+// ---------------------------------------------------------------------------
+// composition.js — the master composition file for the Meridian launch page.
+// This page *is* a Meridian composition: every camera move, world formation
+// and copy reveal below is a keyframe on a track, and the timeline dock at
+// the bottom of the page renders this exact data.
+// ---------------------------------------------------------------------------
+
+export const DUR = 60;          // seconds
+export const FPS = 24;          // ruler frame rate (film-style timecode)
+export const PX_PER_SEC = 132;  // scroll distance that equals one second
+
+// --- easing ----------------------------------------------------------------
+
+export function cubicBezier(x1, y1, x2, y2) {
+  // CSS-compatible cubic-bezier easing: solve x(u) = t for u, return y(u).
+  const ax = 3 * x1 - 3 * x2 + 1, bx = 3 * x2 - 6 * x1, cx = 3 * x1;
+  const ay = 3 * y1 - 3 * y2 + 1, by = 3 * y2 - 6 * y1, cy = 3 * y1;
+  const sampleX = (u) => ((ax * u + bx) * u + cx) * u;
+  const sampleY = (u) => ((ay * u + by) * u + cy) * u;
+  const slopeX = (u) => (3 * ax * u + 2 * bx) * u + cx;
+  const solve = (t) => {
+    let u = t;
+    for (let i = 0; i < 5; i++) {
+      const s = slopeX(u);
+      if (Math.abs(s) < 1e-6) break;
+      u -= (sampleX(u) - t) / s;
+    }
+    if (u < 0 || u > 1 || Math.abs(sampleX(u) - t) > 1e-4) {
+      let lo = 0, hi = 1;
+      u = t;
+      for (let i = 0; i < 24; i++) {
+        if (sampleX(u) < t) lo = u; else hi = u;
+        u = (lo + hi) / 2;
+      }
+    }
+    return Math.min(1, Math.max(0, u));
+  };
+  return (t) => (t <= 0 ? 0 : t >= 1 ? 1 : sampleY(solve(t)));
+}
+
+export function solveBezierU(x1, x2, t) {
+  // parameter u at which x(u) === t  (used to place the evaluation comet)
+  const ax = 3 * x1 - 3 * x2 + 1, bx = 3 * x2 - 6 * x1, cx = 3 * x1;
+  const sampleX = (u) => ((ax * u + bx) * u + cx) * u;
+  let lo = 0, hi = 1, u = t;
+  for (let i = 0; i < 20; i++) {
+    if (sampleX(u) < t) lo = u; else hi = u;
+    u = (lo + hi) / 2;
+  }
+  return u;
+}
+
+export const DEFAULT_CURVE = [0.65, 0.0, 0.15, 1.0]; // the Meridian signature ease
+export const easeSig = cubicBezier(...DEFAULT_CURVE);
+export const easeIO = cubicBezier(0.45, 0, 0.25, 1);
+export const clamp01 = (v) => Math.min(1, Math.max(0, v));
+
+export const CURVE_PRESETS = [
+  { id: "linear",    name: "Linear",    v: [0.0, 0.0, 1.0, 1.0] },
+  { id: "glide",     name: "Glide",     v: [0.65, 0.0, 0.15, 1.0] },
+  { id: "snap",      name: "Snap",      v: [0.9, 0.02, 0.16, 0.98] },
+  { id: "overshoot", name: "Overshoot", v: [0.34, 0.0, 0.18, 1.32] },
+];
+
+// --- chapters (the SCENES track) --------------------------------------------
+
+export const CHAPTERS = [
+  { id: "overture", num: "00", name: "Overture",     start: 0,  end: 7 },
+  { id: "curve",    num: "01", name: "The Curve",    start: 7,  end: 19 },
+  { id: "timeline", num: "02", name: "The Timeline", start: 19, end: 31 },
+  { id: "export",   num: "03", name: "The Export",   start: 31, end: 43 },
+  { id: "budget",   num: "04", name: "The Budget",   start: 43, end: 52 },
+  { id: "begin",    num: "05", name: "Begin",        start: 52, end: 60 },
+];
+
+const TRANS = 2.4; // world crossfade width, centered on chapter boundaries
+
+export function chapterAt(t) {
+  for (let i = CHAPTERS.length - 1; i >= 0; i--) {
+    if (t >= CHAPTERS[i].start) return i;
+  }
+  return 0;
+}
+
+export function actState(t) {
+  const i = chapterAt(t);
+  const ch = CHAPTERS[i];
+  const half = TRANS / 2;
+  if (i > 0 && t < ch.start + half) {
+    const m = (t - (ch.start - half)) / TRANS;
+    return { a: i - 1, b: i, mix: easeIO(clamp01(m)) };
+  }
+  if (i < CHAPTERS.length - 1 && t > ch.end - half) {
+    const m = (t - (ch.end - half)) / TRANS;
+    return { a: i, b: i + 1, mix: easeIO(clamp01(m)) };
+  }
+  return { a: i, b: i, mix: 0 };
+}
+
+// copy reveal window for a chapter (the TYPE track)
+export function typeReveal(t, i) {
+  const ch = CHAPTERS[i];
+  const inA = ch.start === 0 ? 0 : ch.start + 0.55;
+  const inB = ch.start === 0 ? 0.01 : ch.start + 1.9;
+  const last = i === CHAPTERS.length - 1;
+  const outA = ch.end - 1.7, outB = ch.end - 0.45;
+  const up = easeIO(clamp01((t - inA) / Math.max(0.01, inB - inA)));
+  const down = last ? 1 : 1 - easeIO(clamp01((t - outA) / (outB - outA)));
+  return Math.min(up, down);
+}
+
+// --- the CAMERA track --------------------------------------------------------
+
+export const CAM_KEYS = [
+  { t: 0,    eye: [0.0, 0.45, 9.2],  tgt: [0.0, 0.12, 0.0],  fov: 44 },
+  { t: 7,    eye: [0.5, 0.62, 7.8],  tgt: [0.0, 0.10, 0.0],  fov: 44 },
+  { t: 11,   eye: [2.7, 1.15, 6.2],  tgt: [-0.5, 0.15, 0.0], fov: 43 },
+  { t: 17,   eye: [-2.9, 0.78, 5.9], tgt: [0.4, 0.10, 0.0],  fov: 43 },
+  { t: 20.5, eye: [0.0, 3.6, 9.0],   tgt: [0.0, -0.3, -1.5], fov: 50 },
+  { t: 26,   eye: [0.4, 1.5, 2.5],   tgt: [0.0, 0.1, -8.0],  fov: 56 },
+  { t: 30,   eye: [-1.8, 2.5, -1.6], tgt: [2.4, 0.3, -6.0],  fov: 52 },
+  { t: 33.5, eye: [-4.8, 1.35, 4.0], tgt: [-0.2, 0.35, -0.4], fov: 45 },
+  { t: 42,   eye: [-3.0, 1.0, 5.6],  tgt: [-0.4, 0.3, 0.0],  fov: 44 },
+  { t: 44.5, eye: [0.0, 4.6, 11.5],  tgt: [0.0, 0.35, -0.5], fov: 40 },
+  { t: 52,   eye: [0.0, 0.85, 8.8],  tgt: [0.0, 0.25, 0.0],  fov: 43 },
+  { t: 60,   eye: [0.0, 0.32, 7.0],  tgt: [0.0, 0.20, 0.0],  fov: 43 },
+];
+
+const lerp = (a, b, m) => a + (b - a) * m;
+
+export function evalCamera(t, outEye, outTgt) {
+  const K = CAM_KEYS;
+  let i = 0;
+  while (i < K.length - 2 && t >= K[i + 1].t) i++;
+  const a = K[i], b = K[i + 1];
+  const m = easeSig(clamp01((t - a.t) / Math.max(0.001, b.t - a.t)));
+  for (let c = 0; c < 3; c++) {
+    outEye[c] = lerp(a.eye[c], b.eye[c], m);
+    outTgt[c] = lerp(a.tgt[c], b.tgt[c], m);
+  }
+  return lerp(a.fov, b.fov, m);
+}
+
+// the still frame each chapter is rendered at in storyboard (reduced-motion) mode
+export const STILL_T = [3.5, 13, 25.5, 37, 47.5, 57];
+
+// --- world geometry shared by the GPU scene and the dock ---------------------
+
+export const WORLD = {
+  X_MIN: -6, X_MAX: 6,           // the composition mapped across world x
+  LANE_Y: -0.55,
+  LANE_Z0: 1.1, LANE_DZ: -1.35,  // four lanes receding in z
+  GRAPH: { cx: 0, cy: 0, sx: 3.6, sy: 1.4 }, // act-01 easing graph plane
+};
+
+export const timeToX = (t) => WORLD.X_MIN + (t / DUR) * (WORLD.X_MAX - WORLD.X_MIN);
+
+// --- tracks rendered in the dock (and spatialised in act 02) -----------------
+
+const typeWindows = CHAPTERS.map((ch, i) => ({
+  t0: ch.start === 0 ? 0 : ch.start + 0.55,
+  t1: i === CHAPTERS.length - 1 ? DUR : ch.end - 0.45,
+}));
+
+export const TRACKS = [
+  { id: "scenes", name: "scenes", clips: CHAPTERS.map((c) => ({ t0: c.start, t1: c.end })), keys: [] },
+  { id: "camera", name: "camera", clips: [], keys: CAM_KEYS.map((k) => k.t) },
+  { id: "world",  name: "world",  clips: CHAPTERS.map((c) => ({ t0: c.start, t1: c.end })),
+    keys: CHAPTERS.slice(1).map((c) => c.start) },
+  { id: "type",   name: "type",   clips: typeWindows, keys: typeWindows.flatMap((w) => [w.t0, w.t1]) },
+];
+
+export const KEY_COUNT =
+  CAM_KEYS.length + TRACKS[2].keys.length + TRACKS[3].keys.length + 4; // +4: the ease itself
+
+// world-space keyframe diamonds for act 02 (lane index -> z)
+export function worldDiamonds() {
+  const out = [];
+  const lanes = [1, 2, 3]; // camera, world, type lanes carry diamonds
+  lanes.forEach((laneIdx) => {
+    TRACKS[laneIdx].keys.forEach((t) => {
+      out.push({
+        x: timeToX(t),
+        y: WORLD.LANE_Y + 0.02,
+        z: WORLD.LANE_Z0 + laneIdx * WORLD.LANE_DZ + 0.001,
+        t,
+      });
+    });
+  });
+  return out;
+}
+
+// clip windows handed to the particle shader (lane, t0, t1) — max 12
+export function worldClips() {
+  const out = [];
+  CHAPTERS.forEach((c) => out.push([0, c.t0 ?? c.start, c.t1 ?? c.end]));
+  // lanes 1..3 get their densest spans
+  out.push([1, 0, 60], [2, 0, 60], [3, 7, 57]);
+  return out.slice(0, 12);
+}
+
+// --- timecode ----------------------------------------------------------------
+
+export function fmtTC(t) {
+  const tt = Math.max(0, Math.min(DUR, t));
+  const m = Math.floor(tt / 60);
+  const s = Math.floor(tt % 60);
+  const f = Math.floor((tt - Math.floor(tt)) * FPS);
+  const p = (n) => String(n).padStart(2, "0");
+  return `${p(m)}:${p(s)}:${p(f)}`;
+}
+
+export function fmtBezier(c, digits = 2) {
+  return `cubic-bezier(${c.map((v) => v.toFixed(digits)).join(", ")})`;
+}
diff --git a/lib/engine.js b/lib/engine.js
