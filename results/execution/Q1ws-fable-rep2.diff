 a { color: inherit; }
 button, input { font: inherit; }
+
+/* Feedback color for validation. Verified >= 4.5:1 against --background and --surface in both schemes. */
+:root {
+  --danger: #b3271e;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --danger: #f5837b;
+  }
+}
+
+/* One consistent, high-contrast focus ring across the site (16:1 against the page background). */
+:focus-visible {
+  outline: 2px solid var(--foreground);
+  outline-offset: 2px;
+}
