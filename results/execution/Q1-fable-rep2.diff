diff --git a/app/globals.css b/app/globals.css
index 6529d42..c26ac9e 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -7,6 +7,10 @@
   --muted: #6b6b66;
   --surface: #ffffff;
   --line: #deded8;
+  /* Form-control boundaries: same neutral family as --line, but >= 3:1
+     against --surface so inputs and switches meet non-text contrast. */
+  --line-strong: #8c8c85;
+  --danger: #b42318;
 }
 
 @media (prefers-color-scheme: dark) {
@@ -16,6 +20,8 @@
     --muted: #a0a099;
     --surface: #181817;
     --line: #31312f;
+    --line-strong: #6d6d66;
+    --danger: #f97066;
   }
 }
 
@@ -24,3 +30,32 @@ html { background: var(--background); color: var(--foreground); }
 body { margin: 0; font-family: Arial, Helvetica, sans-serif; }
 a { color: inherit; }
 button, input { font: inherit; }
+
+/* One consistent, high-contrast keyboard focus indicator for the whole site. */
+:focus-visible {
+  outline: 2px solid var(--foreground);
+  outline-offset: 2px;
+}
+
+@keyframes settings-fade-in {
+  from {
+    opacity: 0;
+    transform: translateY(2px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* Collapse animation and transitions for users who ask for less motion. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
